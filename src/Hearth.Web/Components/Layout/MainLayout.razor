@inherits LayoutComponentBase
@implements IDisposable
@inject AccountContext AccountContext
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a href="#main-content" class="hearth-skip-link">Pular para o conteúdo principal</a>

<MudLayout Class="hearth-app-layout">
    <MudAppBar Elevation="0" Class="hearth-appbar">
        @if (AccountContext.HasAccounts)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           aria-label="Alternar menu"
                           OnClick="ToggleDrawer" />
        }

        <a href="/" class="hearth-appbar-brand" aria-label="Hearth Finance — Ir para o painel">
            <svg class="hearth-appbar-emblem" viewBox="0 0 36 36" fill="none" aria-hidden="true" focusable="false" data-testid="hearth-logo-icon">
                <path d="M18.6 4.2C18.6 4.2 25.4 9.7 25.4 16.9C25.4 21.1 22.1 24.4 18 24.4C13.9 24.4 10.6 21.1 10.6 16.9C10.6 14.3 11.9 11.7 13.7 9.7C13.5 11.5 14.3 13 15.6 13.5C15.1 10.4 16.3 6.8 18.6 4.2Z" fill="currentColor" />
                <path d="M18 14.2C19.8 16.1 20.8 18 20.8 19.7C20.8 21.3 19.5 22.6 18 22.6C16.5 22.6 15.2 21.3 15.2 19.7C15.2 18.6 15.8 17.4 16.7 16.4C16.7 17.2 17.1 17.8 17.6 18C17.4 16.8 17.6 15.3 18 14.2Z" fill="#131315" fill-opacity="0.78" />
                <path d="M9.5 27.6L26.5 24.6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" opacity="0.82" />
                <path d="M9.5 24.6L26.5 27.6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" opacity="0.52" />
            </svg>
            <span class="hearth-appbar-brand-name" translate="no">Hearth&nbsp;Finance</span>
        </a>

        <MudSpacer />

        @if (AccountContext.Accounts.Count > 1 && AccountContext.Current is not null)
        {
            <MudSelect T="Guid"
                       Value="AccountContext.Current.Id"
                       ValueChanged="HandleAccountSelected"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Dense="true"
                       Style="max-width: 240px;"
                       aria-label="Conta ativa"
                       data-testid="account-selector">
                @foreach (var account in AccountContext.Accounts)
                {
                    <MudSelectItem T="Guid" Value="@account.Id">@account.Name</MudSelectItem>
                }
            </MudSelect>
        }
        else if (AccountContext.Current is not null)
        {
            <MudChip T="string"
                     Color="Color.Default"
                     Variant="Variant.Outlined"
                     Size="Size.Small"
                     Class="hearth-account-chip"
                     Icon="@Icons.Material.Filled.AccountBalanceWallet"
                     data-testid="active-account-chip">
                Conta: @AccountContext.Current.Name
            </MudChip>
        }

        @if (!string.IsNullOrWhiteSpace(_userName))
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="ml-3" data-testid="user-menu">
                <MudIcon Icon="@Icons.Material.Filled.Person"
                         Size="Size.Small"
                         Color="Color.Secondary"
                         Class="d-none d-sm-inline-flex" />
                <MudText Typo="Typo.body2" Class="d-none d-sm-inline hearth-appbar-user" data-testid="user-name">
                    @_userName
                </MudText>
                <form method="post" action="/auth/logout" data-testid="logout-form" style="display: inline;">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Text"
                               Color="Color.Inherit"
                               Size="Size.Small"
                               Class="hearth-logout-btn"
                               StartIcon="@Icons.Material.Filled.Logout"
                               aria-label="Sair da conta"
                               data-testid="logout-button">
                        Sair
                    </MudButton>
                </form>
            </MudStack>
        }
    </MudAppBar>

    @if (AccountContext.HasAccounts)
    {
        <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Always" Class="hearth-drawer">
            <NavMenu />
        </MudDrawer>
    }

    <MudMainContent id="main-content" Class="hearth-main-content">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="hearth-main-container">
            @if (!AccountContext.IsInitialized)
            {
                @if (AccountContext.LoadError is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" data-testid="account-load-error">
                        @AccountContext.LoadError
                    </MudAlert>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="RetryInitializationAsync"
                               data-testid="account-retry-button">
                        Tentar novamente
                    </MudButton>
                }
                else
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" data-testid="account-loading" />
                }
            }
            else if (!AccountContext.HasAccounts && !IsOnboardingRoute())
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" data-testid="onboarding-redirect" />
            }
            else
            {
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent>
                        <MudAlert Severity="Severity.Error"
                                  Variant="Variant.Outlined"
                                  Class="mb-4"
                                  data-testid="error-boundary-alert">
                            Algo deu errado ao exibir esta tela.
                        </MudAlert>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="RecoverError"
                                   data-testid="error-boundary-recover">
                            Tentar novamente
                        </MudButton>
                    </ErrorContent>
                </ErrorBoundary>
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code
{
    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#D32F2F",
            PrimaryLighten = "#FF7A70",
            PrimaryDarken = "#B92525",
            Secondary = "#AEACA8",
            Background = "#0F0F10",
            Surface = "#171719",
            DrawerBackground = "#131315",
            DrawerText = "#D8D6D2",
            DrawerIcon = "#9A9894",
            AppbarBackground = "#131315",
            AppbarText = "#F3F2EF",
            TextPrimary = "#F3F2EF",
            TextSecondary = "#AEACA8",
            LinesDefault = "rgba(243, 242, 239, 0.09)",
            Divider = "rgba(243, 242, 239, 0.09)",
            Success = "#5EC269",
            Error = "#FF7A70",
            Warning = "#F5B74B",
            Info = "#64B5F6",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["IBM Plex Sans", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"],
            },
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px",
        },
    };

    private bool _drawerOpen = true;
    private ErrorBoundary? _errorBoundary;
    private bool _disposed;
    private string? _userName;

    protected override async Task OnInitializedAsync()
    {
        AccountContext.Changed += HandleAccountContextChanged;
        Navigation.LocationChanged += HandleLocationChanged;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!HearthAuth.TryReadUser(authState.User, out _, out var name, out _))
        {
            return;
        }

        _userName = name;

        await AccountContext.InitializeAsync();
        RedirectToOnboardingIfNeeded();
    }

    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }

    private void ToggleDrawer() =>
        _drawerOpen = !_drawerOpen;

    private void HandleAccountSelected(Guid accountId) =>
        AccountContext.SelectAccount(accountId);

    private async Task RetryInitializationAsync()
    {
        await AccountContext.ReloadAsync();
        RedirectToOnboardingIfNeeded();
    }

    private void RecoverError() =>
        _errorBoundary?.Recover();

    private void HandleAccountContextChanged()
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            RedirectToOnboardingIfNeeded();
            StateHasChanged();
        });
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            _errorBoundary?.Recover();
            RedirectToOnboardingIfNeeded();
            StateHasChanged();
        });
    }

    private void RedirectToOnboardingIfNeeded()
    {
        if (AccountContext.IsInitialized && !AccountContext.HasAccounts && !IsOnboardingRoute())
        {
            Navigation.NavigateTo("/onboarding", replace: true);
        }
    }

    private bool IsOnboardingRoute()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');
        var pathOnly = relative.Split('?', '#')[0];

        return string.Equals(pathOnly, "onboarding", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        AccountContext.Changed -= HandleAccountContextChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
