@using System.Globalization
@using Hearth.Application.Reports.GetMonthlySurplus
@using Hearth.Domain.ValueObjects
@using Hearth.Web.Services

<section class="hearth-card hearth-evolution-card" aria-labelledby="heading-evolution" data-testid="surplus-evolution-chart">
    <div class="hearth-evolution-head">
        <div class="hearth-evolution-title-group">
            <h2 id="heading-evolution" class="hearth-card-title">Evolução do caixa e projeção</h2>
            <p class="hearth-card-meta">
                Histórico consolidado e projeção encadeada mês a mês
                @if (!string.IsNullOrWhiteSpace(ActiveConditionName))
                {
                    <span class="hearth-inline-filter-tag">Filtro: @ActiveConditionName</span>
                }
            </p>
        </div>

        <div class="hearth-evolution-kpi">
            <span class="hearth-evolution-kpi-label">Variação líquida média mensal</span>
            <strong class="hearth-evolution-kpi-value hearth-money @GetVariationToneClass(AverageMonthlyVariation)"
                    data-testid="monthly-surplus-average-variation">
                @FormatSignedMoney(AverageMonthlyVariation)
            </strong>
        </div>
    </div>

    <div class="hearth-evolution-legend" aria-label="Legenda do gráfico">
        <span class="hearth-legend-item">
            <span class="hearth-legend-swatch is-above-mid" aria-hidden="true"></span>
            Acima do ponto médio
        </span>
        <span class="hearth-legend-item">
            <span class="hearth-legend-swatch is-below-mid" aria-hidden="true"></span>
            Igual ou abaixo do ponto médio
        </span>
        <span class="hearth-legend-item">
            <span class="hearth-legend-swatch is-stroke-solid" aria-hidden="true"></span>
            Histórico consolidado
        </span>
        <span class="hearth-legend-item">
            <span class="hearth-legend-swatch is-stroke-dashed" aria-hidden="true"></span>
            Projeção
        </span>
        <span class="hearth-legend-count" data-testid="monthly-surplus-series-count">@Points.Count meses</span>
    </div>

    @if (Points.Count > 0)
    {
        var chart = BuildLayout(Points);

        <div class="hearth-evolution-stage">
            <svg class="hearth-evolution-svg"
                 viewBox="0 0 720 228"
                 role="img"
                 aria-label="@BuildAccessibleSummary()"
                 data-midpoint="@chart.Midpoint.ToString("0.00", CultureInfo.InvariantCulture)">
                <defs>
                    <linearGradient id="hearth-above-grad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#5EC269" stop-opacity="0.22" />
                        <stop offset="100%" stop-color="#5EC269" stop-opacity="0.01" />
                    </linearGradient>
                    <linearGradient id="hearth-below-grad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#FF7A70" stop-opacity="0.20" />
                        <stop offset="100%" stop-color="#FF7A70" stop-opacity="0.01" />
                    </linearGradient>
                </defs>

                @* Horizontal gridlines *@
                @foreach (var gridY in chart.GridLines)
                {
                    <line x1="@F(PlotLeft)" y1="@F(gridY)" x2="@F(PlotRight)" y2="@F(gridY)"
                          class="hearth-chart-gridline" />
                }

                @* Zero baseline when chart crosses or touches zero *@
                @if (chart.ZeroY.HasValue)
                {
                    <line x1="@F(PlotLeft)" y1="@F(chart.ZeroY.Value)" x2="@F(PlotRight)" y2="@F(chart.ZeroY.Value)"
                          class="hearth-chart-zeroline" />
                }

                @* Midpoint reference guideline when inside visible vertical range *@
                @if (chart.MidpointY.HasValue)
                {
                    <line x1="@F(PlotLeft)" y1="@F(chart.MidpointY.Value)" x2="@F(PlotRight)" y2="@F(chart.MidpointY.Value)"
                          class="hearth-chart-midline" />
                }

                @* Current month boundary divider *@
                @if (chart.CurrentMarkerX.HasValue)
                {
                    <line x1="@F(chart.CurrentMarkerX.Value)" y1="@F(PlotTop - 6)"
                          x2="@F(chart.CurrentMarkerX.Value)" y2="@F(PlotBottom)"
                          class="hearth-chart-nowline" />
                }

                @* Single historical baseline stem when only 1 historical point precedes projection *@
                @if (chart.SingleHistoricalStem is { } stem)
                {
                    var stemTone = stem.IsAboveMidpoint ? "is-above-mid" : "is-below-mid";
                    <path d="@stem.LinePath"
                          class="hearth-chart-line is-historical @stemTone"
                          data-testid="chart-historical-path"
                          data-segment="@($"{stem.Point.Year:D4}-{stem.Point.Month:D2}")" />
                }

                @* Per-segment area fills + colored solid/dashed lines *@
                @foreach (var seg in chart.Segments)
                {
                    var strokeClass = seg.IsHistorical ? "is-historical" : "is-projection";
                    var toneClass = seg.IsAboveMidpoint ? "is-above-mid" : "is-below-mid";
                    var areaFill = seg.IsAboveMidpoint ? "url(#hearth-above-grad)" : "url(#hearth-below-grad)";

                    <path d="@seg.AreaPath" fill="@areaFill" />
                    <path d="@seg.LinePath"
                          class="hearth-chart-line @strokeClass @toneClass"
                          data-testid="@(seg.IsHistorical ? "chart-historical-path" : "chart-projection-path")"
                          data-segment="@($"{seg.To.Point.Year:D4}-{seg.To.Point.Month:D2}")" />
                }

                @* Data nodes + month axis labels *@
                @foreach (var node in chart.Nodes)
                {
                    var isSelected = node.Point.Year == SelectedMonth.Year && node.Point.Month == SelectedMonth.Month;
                    var toneClass = node.IsAboveMidpoint ? "is-above-mid" : "is-below-mid";
                    var yOffset = node.Y < PlotTop + 20 ? 18 : -12;

                    <g>
                        @if (isSelected)
                        {
                            <circle cx="@F(node.X)" cy="@F(node.Y)" r="9" class="hearth-chart-node-halo @toneClass" />
                        }
                        <circle cx="@F(node.X)"
                                cy="@F(node.Y)"
                                r="@(isSelected ? "5" : "4")"
                                class="hearth-chart-node @toneClass @(isSelected ? "is-selected" : null)"
                                data-node="@($"{node.Point.Year:D4}-{node.Point.Month:D2}")" />

                        @if (isSelected || node.Point.IsCurrentMonth)
                        {
                            @RenderSvgText(
                                node.X,
                                node.Y + yOffset,
                                isSelected ? "hearth-chart-value-label is-selected" : "hearth-chart-value-label",
                                FormatCompactMoney(node.Point.ProjectedSurplus))
                        }

                        @RenderSvgText(
                            node.X,
                            PlotBottom + 22,
                            isSelected ? "hearth-chart-axis-label is-selected" : "hearth-chart-axis-label",
                            ShortMonthLabel(node.Point.Year, node.Point.Month))
                    </g>
                }
            </svg>

            @* Keyboard & pointer accessible month selector strip *@
            <div class="hearth-evolution-strip" role="group" aria-label="Selecionar mês na linha do tempo">
                @foreach (var node in chart.Nodes)
                {
                    var point = node.Point;
                    var isSelected = point.Year == SelectedMonth.Year && point.Month == SelectedMonth.Month;
                    var targetMonth = YearMonth.Of(point.Year, point.Month);
                    var toneClass = node.IsAboveMidpoint ? "is-above-mid" : "is-below-mid";

                    <button type="button"
                            class="hearth-evolution-pill @(point.IsHistorical ? "is-historical" : "is-projection") @toneClass @(isSelected ? "is-selected" : null)"
                            aria-pressed="@(isSelected ? "true" : "false")"
                            @onclick="() => OnSelectMonthAsync(targetMonth)"
                            data-testid="@($"chart-point-{point.Year:D4}-{point.Month:D2}")">
                        <span class="hearth-evolution-pill-month">
                            @ShortMonthLabel(point.Year, point.Month)
                            @if (point.IsCurrentMonth)
                            {
                                <span class="hearth-evolution-now-dot @toneClass" aria-hidden="true"></span>
                            }
                        </span>
                        <span class="hearth-evolution-pill-val hearth-money">@FormatCompactMoney(point.ProjectedSurplus)</span>
                        <span class="hearth-evolution-pill-var hearth-money @GetVariationToneClass(point.NetMonthlyVariation)">
                            @FormatSignedCompactMoney(point.NetMonthlyVariation)
                        </span>
                    </button>
                }
            </div>
        </div>
    }
</section>

@code
{
    private const double PlotLeft = 24;
    private const double PlotRight = 696;
    private const double PlotTop = 28;
    private const double PlotBottom = 186;

    [Parameter, EditorRequired]
    public IReadOnlyList<MonthlySurplusPointDto> Points { get; set; } = [];

    [Parameter, EditorRequired]
    public YearMonth SelectedMonth { get; set; } = YearMonth.Of(2026, 1);

    [Parameter]
    public decimal AverageMonthlyVariation { get; set; }

    [Parameter]
    public string? ActiveConditionName { get; set; }

    [Parameter]
    public EventCallback<YearMonth> MonthSelected { get; set; }

    private async Task OnSelectMonthAsync(YearMonth month)
    {
        if (MonthSelected.HasDelegate)
        {
            await MonthSelected.InvokeAsync(month);
        }
    }

    private string BuildAccessibleSummary()
    {
        if (Points.Count == 0)
        {
            return "Série mensal de sobra projetada sem dados.";
        }

        var first = Points[0];
        var last = Points[^1];
        return $"Evolução de {ShortMonthLabel(first.Year, first.Month)} a {ShortMonthLabel(last.Year, last.Month)}, com variação média mensal de {HearthFormat.Money(AverageMonthlyVariation)}.";
    }

    private static ChartLayout BuildLayout(IReadOnlyList<MonthlySurplusPointDto> points)
    {
        var rawMin = points.Min(p => p.ProjectedSurplus);
        var rawMax = points.Max(p => p.ProjectedSurplus);
        var midpoint = rawMax == rawMin
            ? 0m
            : (rawMax - rawMin) / 2m;

        var minVal = rawMin;
        var maxVal = rawMax;

        if (minVal < 0m && maxVal > 0m)
        {
            // Range already spans zero
        }
        else if (minVal > 0m)
        {
            minVal = Math.Min(minVal * 0.75m, minVal - 100m);
        }
        else if (maxVal < 0m)
        {
            maxVal = Math.Max(maxVal * 0.75m, maxVal + 100m);
        }

        if (maxVal == minVal)
        {
            var pad = Math.Max(100m, Math.Abs(maxVal) * 0.2m);
            minVal -= pad;
            maxVal += pad;
        }
        else
        {
            var pad = (maxVal - minVal) * 0.14m;
            minVal -= pad;
            maxVal += pad;
        }

        var plotHeight = PlotBottom - PlotTop;
        double MapY(decimal value)
        {
            var ratio = (double)((value - minVal) / (maxVal - minVal));
            return PlotBottom - (ratio * plotHeight);
        }

        var innerLeft = PlotLeft + 26;
        var innerRight = PlotRight - 26;
        var stepX = points.Count > 1 ? (innerRight - innerLeft) / (points.Count - 1) : 0;

        var nodes = new List<ChartNode>(points.Count);
        for (var i = 0; i < points.Count; i++)
        {
            var x = points.Count == 1 ? (PlotLeft + PlotRight) / 2.0 : innerLeft + (i * stepX);
            var isAboveMidpoint = points[i].ProjectedSurplus > midpoint;
            nodes.Add(new ChartNode(points[i], x, MapY(points[i].ProjectedSurplus), isAboveMidpoint));
        }

        var segments = new List<ChartSegment>(Math.Max(0, nodes.Count - 1));
        for (var i = 1; i < nodes.Count; i++)
        {
            var from = nodes[i - 1];
            var to = nodes[i];
            var linePath = $"M {F(from.X)} {F(from.Y)} L {F(to.X)} {F(to.Y)}";
            var areaPath = $"M {F(from.X)} {F(from.Y)} L {F(to.X)} {F(to.Y)} L {F(to.X)} {F(PlotBottom)} L {F(from.X)} {F(PlotBottom)} Z";
            segments.Add(new ChartSegment(from, to, linePath, areaPath, to.Point.IsHistorical, to.IsAboveMidpoint));
        }

        SingleStem? singleHistoricalStem = null;
        if (nodes.Count > 0 && nodes[0].Point.IsHistorical && !segments.Any(s => s.IsHistorical))
        {
            var first = nodes[0];
            var stemPath = $"M {F(first.X)} {F(PlotBottom)} L {F(first.X)} {F(first.Y)}";
            singleHistoricalStem = new SingleStem(first.Point, stemPath, first.IsAboveMidpoint);
        }

        double? zeroY = minVal <= 0m && maxVal >= 0m ? MapY(0m) : null;
        double? midpointY = rawMax != rawMin && midpoint >= minVal && midpoint <= maxVal ? MapY(midpoint) : null;
        double? currentX = nodes.FirstOrDefault(n => n.Point.IsCurrentMonth)?.X;
        double[] gridLines = [PlotTop, PlotTop + (plotHeight * 0.5), PlotBottom];

        return new ChartLayout(
            midpoint,
            nodes,
            segments,
            singleHistoricalStem,
            zeroY,
            midpointY,
            currentX,
            gridLines);
    }

    private static RenderFragment RenderSvgText(double x, double y, string cssClass, string content) =>
        builder =>
        {
            builder.OpenElement(0, "text");
            builder.AddAttribute(1, "x", F(x));
            builder.AddAttribute(2, "y", F(y));
            builder.AddAttribute(3, "text-anchor", "middle");
            builder.AddAttribute(4, "class", cssClass);
            builder.AddContent(5, content);
            builder.CloseElement();
        };

    private static string F(double value) =>
        value.ToString("0.0", CultureInfo.InvariantCulture);

    private static string ShortMonthLabel(int year, int month)
    {
        var raw = new DateOnly(year, month, 1).ToString("MMM/yy", HearthFormat.PtBr).TrimEnd('.');
        return char.ToUpper(raw[0], HearthFormat.PtBr) + raw[1..];
    }

    private static string FormatSignedMoney(decimal value) =>
        value > 0m ? $"+{HearthFormat.Money(value)}" : HearthFormat.Money(value);

    private static string FormatCompactMoney(decimal value)
    {
        var abs = Math.Abs(value);
        var sign = value < 0m ? "-" : string.Empty;
        if (abs >= 1_000_000m)
        {
            return $"{sign}R$ {(abs / 1_000_000m).ToString("0.#", HearthFormat.PtBr)}M";
        }

        if (abs >= 10_000m)
        {
            return $"{sign}R$ {(abs / 1_000m).ToString("0.#", HearthFormat.PtBr)}k";
        }

        return HearthFormat.Money(value);
    }

    private static string FormatSignedCompactMoney(decimal value) =>
        value > 0m ? $"+{FormatCompactMoney(value)}" : FormatCompactMoney(value);

    private static string GetVariationToneClass(decimal value) =>
        value > 0m ? "is-positive" : value < 0m ? "is-danger" : "is-neutral";

    private sealed record ChartNode(
        MonthlySurplusPointDto Point,
        double X,
        double Y,
        bool IsAboveMidpoint);

    private sealed record ChartSegment(
        ChartNode From,
        ChartNode To,
        string LinePath,
        string AreaPath,
        bool IsHistorical,
        bool IsAboveMidpoint);

    private sealed record SingleStem(
        MonthlySurplusPointDto Point,
        string LinePath,
        bool IsAboveMidpoint);

    private sealed record ChartLayout(
        decimal Midpoint,
        IReadOnlyList<ChartNode> Nodes,
        IReadOnlyList<ChartSegment> Segments,
        SingleStem? SingleHistoricalStem,
        double? ZeroY,
        double? MidpointY,
        double? CurrentMarkerX,
        IReadOnlyList<double> GridLines);
}
