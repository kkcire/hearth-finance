@inject NavigationManager Navigation

@code
{
    protected override void OnInitialized()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var candidate = string.IsNullOrWhiteSpace(relative) ? "/" : "/" + relative.TrimStart('/');

        var target = HearthAuth.IsSafeLocalReturnUrl(candidate) && candidate != "/"
            ? $"/login?returnUrl={Uri.EscapeDataString(candidate)}"
            : "/login";

        Navigation.NavigateTo(target, forceLoad: true);
    }
}
