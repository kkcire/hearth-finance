<div class="hearth-month-nav" role="group" aria-label="Navegação de mês">
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                   Size="Size.Medium"
                   Variant="Variant.Text"
                   Class="hearth-month-nav-btn"
                   title="Mês anterior"
                   aria-label="Mês anterior"
                   OnClick="PreviousMonthAsync"
                   Disabled="Disabled"
                   data-testid="month-prev" />

    <span class="hearth-month-nav-label" aria-live="polite" data-testid="month-label">
        @HearthFormat.MonthYear(Month)
    </span>

    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                   Size="Size.Medium"
                   Variant="Variant.Text"
                   Class="hearth-month-nav-btn"
                   title="Próximo mês"
                   aria-label="Próximo mês"
                   OnClick="NextMonthAsync"
                   Disabled="Disabled"
                   data-testid="month-next" />
</div>

@code
{
    [Parameter, EditorRequired]
    public YearMonth Month { get; set; } = default!;

    [Parameter]
    public EventCallback<YearMonth> MonthChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private Task PreviousMonthAsync() =>
        MonthChanged.InvokeAsync(Month.AddMonths(-1));

    private Task NextMonthAsync() =>
        MonthChanged.InvokeAsync(Month.AddMonths(1));
}
