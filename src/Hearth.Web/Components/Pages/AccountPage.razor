@page "/conta"
@attribute [Authorize]
@inherits AccountPageBase
@using Hearth.Application.Accounts
@using Hearth.Application.Accounts.DeleteBalanceAdjustment
@using Hearth.Application.Accounts.GetAccount
@using Hearth.Application.Accounts.RenameAccount
@using Hearth.Application.Accounts.SetAccountBalance

<PageTitle>Conta — Hearth Finance</PageTitle>

<div class="hearth-page">
    <PageHeader Title="Conta"
                Subtitle="Identificação da conta ativa, início do acompanhamento e ajuste do saldo inicial (dia 1º).">
        <Actions>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       Class="hearth-btn-clean"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/onboarding"
                       data-testid="new-account-button">
                Nova conta
            </MudButton>
        </Actions>
    </PageHeader>

    @if (_loading)
    {
        <div class="hearth-settings-grid">
            <div class="hearth-card hearth-skeleton-panel"></div>
            <div class="hearth-card hearth-skeleton-panel"></div>
        </div>
    }
    else if (_account is not null)
    {
        <div class="hearth-settings-grid">
            <section class="hearth-form-panel" aria-labelledby="heading-account-identity">
                <div>
                    <h2 id="heading-account-identity" class="hearth-card-title">Identificação</h2>
                    <p class="hearth-card-meta">Nome exibido na barra superior e nos cartões vinculados.</p>
                </div>

                <MudTextField @bind-Value="_name"
                              Label="Nome da conta"
                              Variant="Variant.Outlined"
                              Required="true"
                              MaxLength="@DomainValidation.MaxNameLength"
                              Counter="@DomainValidation.MaxNameLength"
                              Immediate="true"
                              Disabled="_savingName"
                              data-testid="rename-account-input" />

                <MudTextField Value="@($"{HearthFormat.Date(_account.TrackingStartDate)} — {HearthFormat.MonthYear(_account.TrackingStartPeriod)}")"
                              Label="Início do acompanhamento"
                              Variant="Variant.Outlined"
                              ReadOnly="true"
                              HelperText="Imutável. Definido automaticamente no dia 1º do mês de criação da conta."
                              Class="hearth-money"
                              data-testid="initial-balance-date-readonly" />

                <MudTextField Value="@HearthFormat.Money(_account.InitialBalance)"
                              Label="@($"Saldo inicial ({HearthFormat.Date(_account.TrackingStartDate)})")"
                              Variant="Variant.Outlined"
                              ReadOnly="true"
                              HelperText="Único saldo manual da conta, referente ao dia 1º do mês de entrada. Edite no painel ao lado."
                              Class="hearth-money"
                              data-testid="initial-balance-readonly" />

                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-auto">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Class="hearth-btn-clean"
                               OnClick="SaveNameAsync"
                               Disabled="_savingName"
                               data-testid="rename-account-submit">
                        @(_savingName ? "Salvando…" : "Salvar nome")
                    </MudButton>
                </MudStack>
            </section>

            <section class="hearth-form-panel" aria-labelledby="heading-account-balance" data-testid="account-set-balance-section">
                <div>
                    <h2 id="heading-account-balance" class="hearth-card-title">Saldo inicial</h2>
                    <p class="hearth-card-meta">
                        Único saldo manual da conta, sempre referente ao dia 1º do mês de entrada (@HearthFormat.Date(_account.TrackingStartDate)). Pode ser negativo, zero ou positivo. O SALDO atual é calculado automaticamente a partir dele, sem alterar receitas, despesas ou resultado mensal.
                    </p>
                </div>

                <MudNumericField T="decimal"
                                 @bind-Value="_definedBalance"
                                 Label="@($"Saldo inicial ({HearthFormat.Date(_account.TrackingStartDate)})")"
                                 Variant="Variant.Outlined"
                                 Culture="@HearthFormat.PtBr"
                                 Format="N2"
                                 Adornment="Adornment.Start"
                                 AdornmentText="R$"
                                 HideSpinButtons="true"
                                 Immediate="true"
                                 HelperText="Informe o saldo real que você tinha no dia 1º do mês de entrada (negativo, zero ou positivo)."
                                 Disabled="_savingBalance"
                                 data-testid="account-set-balance-input" />

                <MudTextField @bind-Value="_balanceReason"
                              Label="Motivo (opcional)"
                              Variant="Variant.Outlined"
                              MaxLength="@DomainValidation.MaxDescriptionLength"
                              Immediate="true"
                              Disabled="_savingBalance"
                              data-testid="account-set-balance-reason-input" />

                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-auto">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Class="hearth-btn-clean"
                               OnClick="SetBalanceAsync"
                               Disabled="_savingBalance"
                               data-testid="account-set-balance-submit">
                        @(_savingBalance ? "Salvando…" : "Salvar saldo inicial")
                    </MudButton>
                </MudStack>
            </section>
        </div>

        @if (_account.BalanceAdjustments is { Count: > 0 } balanceHistory)
        {
            <section class="hearth-card mt-4" aria-labelledby="heading-account-balance-history" data-testid="account-balance-history-log">
                <div class="hearth-card-head">
                    <div>
                        <h2 id="heading-account-balance-history" class="hearth-card-title">Histórico de alterações do saldo inicial</h2>
                        <p class="hearth-card-meta">Registros exclusivos de controle de caixa (dia 1º) — não entram como receita, despesa ou resultado mensal.</p>
                    </div>
                </div>
                <div class="hearth-adjustments-list">
                    @foreach (var entry in balanceHistory.OrderByDescending(e => e.CreatedAt))
                    {
                        var entryId = entry.Id;
                        <div class="hearth-adjustment-row" data-testid="account-balance-history-item">
                            <div>
                                <span class="hearth-adjustment-reason">@(string.IsNullOrWhiteSpace(entry.Reason) ? "Saldo inicial atualizado" : entry.Reason)</span>
                                <span class="hearth-adjustment-date">Saldo inicial · @HearthFormat.Date(entry.Date)</span>
                            </div>
                            <div class="hearth-adjustment-row-right">
                                <span class="hearth-money @(entry.Amount > 0m ? "hearth-money--positive" : entry.Amount < 0m ? "hearth-money--negative" : null)">
                                    @HearthFormat.Money(entry.Amount)
                                </span>
                                @if (_confirmDeleteBalanceEntryId == entryId)
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudButton Size="Size.Small"
                                                   Variant="Variant.Filled"
                                                   Color="Color.Error"
                                                   Disabled="_deletingBalanceEntry"
                                                   OnClick="() => DeleteBalanceEntryAsync(entryId)"
                                                   data-testid="@($"confirm-delete-balance-entry-{entryId}")">
                                            Confirmar
                                        </MudButton>
                                        <MudButton Size="Size.Small"
                                                   Variant="Variant.Text"
                                                   Disabled="_deletingBalanceEntry"
                                                   OnClick="() => _confirmDeleteBalanceEntryId = null">
                                            Cancelar
                                        </MudButton>
                                    </MudStack>
                                }
                                else
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Class="hearth-action-btn is-danger"
                                                   title="Excluir registro de saldo"
                                                   aria-label="Excluir registro de saldo"
                                                   Disabled="_deletingBalanceEntry"
                                                   OnClick="() => _confirmDeleteBalanceEntryId = entryId"
                                                   data-testid="@($"delete-balance-entry-{entryId}")" />
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    }
</div>

@code
{
    private AccountDto? _account;
    private string _name = string.Empty;
    private decimal _definedBalance;
    private string _balanceReason = string.Empty;

    private bool _loading = true;
    private bool _savingName;
    private bool _savingBalance;
    private Guid? _confirmDeleteBalanceEntryId;
    private bool _deletingBalanceEntry;

    protected override void OnAccountChanged()
    {
        _definedBalance = 0m;
        _balanceReason = string.Empty;
        _confirmDeleteBalanceEntryId = null;
    }

    protected override async Task LoadDataAsync(CancellationToken cancellationToken)
    {
        _loading = true;

        var result = await Executor.ExecuteAsync<GetAccountHandler, AccountDto>(
            (handler, ct) => handler.ExecuteAsync(new GetAccountQuery(AccountId), ct),
            cancellationToken: cancellationToken);

        if (result.IsSuccess && result.Value is not null)
        {
            ApplyAccount(result.Value);
        }

        _loading = false;
    }

    private void ApplyAccount(AccountDto account)
    {
        _account = account;
        _name = account.Name;
        _definedBalance = account.InitialBalance;
    }

    private async Task SaveNameAsync()
    {
        if (_savingName || string.IsNullOrWhiteSpace(_name))
        {
            return;
        }

        _savingName = true;

        try
        {
            var result = await Executor.ExecuteAsync<RenameAccountHandler>(
                (handler, ct) => handler.ExecuteAsync(new RenameAccountCommand(AccountId, _name.Trim()), ct),
                successMessage: "Nome da conta atualizado.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                await ReloadAccountContextAsync(AccountId, ComponentCancellationToken);
                await LoadDataAsync(ComponentCancellationToken);
            }
        }
        finally
        {
            _savingName = false;
        }
    }

    private async Task SetBalanceAsync()
    {
        if (_savingBalance)
        {
            return;
        }

        _savingBalance = true;

        try
        {
            var result = await Executor.ExecuteAsync<SetAccountBalanceHandler, Guid>(
                (handler, ct) => handler.ExecuteAsync(
                    new SetAccountBalanceCommand(
                        AccountId,
                        _definedBalance,
                        string.IsNullOrWhiteSpace(_balanceReason) ? null : _balanceReason.Trim()),
                    ct),
                successMessage: "Saldo inicial atualizado com sucesso.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _balanceReason = string.Empty;
                await ReloadAccountContextAsync(AccountId, ComponentCancellationToken);
                await LoadDataAsync(ComponentCancellationToken);
            }
        }
        finally
        {
            _savingBalance = false;
        }
    }

    private async Task DeleteBalanceEntryAsync(Guid adjustmentId)
    {
        if (_deletingBalanceEntry)
        {
            return;
        }

        _deletingBalanceEntry = true;

        try
        {
            var result = await Executor.ExecuteAsync<DeleteBalanceAdjustmentHandler>(
                (handler, ct) => handler.ExecuteAsync(new DeleteBalanceAdjustmentCommand(AccountId, adjustmentId), ct),
                successMessage: "Registro de saldo excluído.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _confirmDeleteBalanceEntryId = null;
                await ReloadAccountContextAsync(AccountId, ComponentCancellationToken);
                await LoadDataAsync(ComponentCancellationToken);
            }
        }
        finally
        {
            _deletingBalanceEntry = false;
        }
    }
}
