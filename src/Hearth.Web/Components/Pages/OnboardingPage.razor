@page "/onboarding"
@attribute [Authorize]
@inject UseCaseExecutor Executor
@inject AccountContext AccountContext
@inject IClock Clock
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@using Hearth.Application.Accounts.CreateAccount
@using Hearth.Domain

<div class="hearth-onboarding-shell">
    <section class="hearth-form-panel" aria-labelledby="heading-onboarding">
        <div>
            <h1 id="heading-onboarding" class="hearth-dash-title" data-testid="onboarding-greeting">
                @(string.IsNullOrWhiteSpace(_userName) ? "Bem-vindo ao Hearth" : $"Olá, {_userName}!")
            </h1>
            <p class="hearth-dash-subtitle">
                Crie sua conta financeira para começar. As categorias padrão são criadas automaticamente.
            </p>
        </div>

        <MudForm @ref="_form" @onsubmit="SubmitAsync">
            <MudStack Spacing="4" Class="mt-2">
                <MudTextField @bind-Value="_name"
                              Label="Nome da conta"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Informe o nome da conta."
                              MaxLength="@DomainValidation.MaxNameLength"
                              Counter="@DomainValidation.MaxNameLength"
                              Immediate="true"
                              Disabled="_saving"
                              data-testid="account-name-input" />

                <MudTextField Value="@($"{HearthFormat.Date(_trackingStartDate)} — {HearthFormat.MonthYear(_trackingStartPeriod)}")"
                              Label="Início do acompanhamento"
                              Variant="Variant.Outlined"
                              ReadOnly="true"
                              HelperText="Definido automaticamente para o dia 1º do mês atual (horário de Brasília). Você já pode registrar lançamentos a partir desta data."
                              Class="hearth-money"
                              data-testid="tracking-start-period-readonly" />

                <MudNumericField T="decimal"
                                 @bind-Value="_initialBalance"
                                 Label="Saldo inicial (posição de caixa)"
                                 Variant="Variant.Outlined"
                                 Culture="@HearthFormat.PtBr"
                                 Format="N2"
                                 Adornment="Adornment.Start"
                                 AdornmentText="R$"
                                 HideSpinButtons="true"
                                 HelperText="@($"Saldo disponível em {HearthFormat.Date(_trackingStartDate)}. Pode ser negativo, zero ou positivo. É o único saldo manual da conta, não conta como receita e pode ser ajustado depois em Conta ou no Painel.")"
                                 Disabled="_saving"
                                 data-testid="initial-balance-input" />

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="hearth-inline-alert" role="alert" data-testid="onboarding-error">
                        @_errorMessage
                    </div>
                }

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    @if (AccountContext.HasAccounts)
                    {
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Default"
                                   Href="/"
                                   Disabled="_saving">
                            Cancelar
                        </MudButton>
                    }

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Class="hearth-btn-clean"
                               OnClick="SubmitAsync"
                               Disabled="_saving"
                               data-testid="create-account-submit">
                        @if (_saving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Criando…</span>
                        }
                        else
                        {
                            <span>Criar conta</span>
                        }
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudForm>
    </section>
</div>

@code
{
    private MudForm? _form;
    private string _name = string.Empty;
    private decimal _initialBalance;
    private DateOnly _trackingStartDate;
    private YearMonth _trackingStartPeriod = YearMonth.Of(2026, 1);
    private bool _saving;
    private string? _errorMessage;
    private string? _userName;

    protected override async Task OnInitializedAsync()
    {
        _trackingStartDate = BrasiliaTime.DeriveTrackingStartDate(Clock.UtcNow);
        _trackingStartPeriod = YearMonth.From(_trackingStartDate);

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (HearthAuth.TryReadUser(authState.User, out _, out var name, out _))
        {
            _userName = name;
        }
    }

    private async Task SubmitAsync()
    {
        if (_saving)
        {
            return;
        }

        _errorMessage = null;

        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid)
            {
                return;
            }
        }

        if (string.IsNullOrWhiteSpace(_name))
        {
            _errorMessage = "Informe o nome da conta.";
            return;
        }

        _saving = true;

        try
        {
            var command = new CreateAccountCommand(
                _name.Trim(),
                _initialBalance);

            var result = await Executor.ExecuteAsync<CreateAccountHandler, Guid>(
                (handler, ct) => handler.ExecuteAsync(command, ct),
                successMessage: "Conta criada com sucesso.");

            if (!result.IsSuccess)
            {
                _errorMessage = result.ErrorMessage;
                return;
            }

            await AccountContext.ReloadAsync(result.Value);
            Navigation.NavigateTo("/");
        }
        finally
        {
            _saving = false;
        }
    }
}
