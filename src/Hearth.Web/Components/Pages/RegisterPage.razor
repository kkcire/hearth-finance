@page "/cadastro"
@layout AuthLayout
@attribute [AllowAnonymous]
@attribute [EnableRateLimiting(HearthAuth.RateLimitPolicyName)]
@using Hearth.Application.Auth
@using Hearth.Application.Auth.RegisterUser
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.Extensions.Options
@inject RegisterUserHandler RegisterUser
@inject IOptions<HearthAuthOptions> AuthOptions
@inject NavigationManager Navigation

<div class="hearth-auth-heading">
    <h1 class="hearth-auth-title">Criar conta</h1>
    @if (AuthOptions.Value.AllowRegistration)
    {
        <p class="hearth-auth-subtitle">Crie seu acesso para começar a controlar suas finanças.</p>
    }
</div>

@if (!AuthOptions.Value.AllowRegistration)
{
    <div class="hearth-auth-alert" role="alert" data-testid="registration-disabled">
        <svg class="hearth-auth-alert-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.6" />
            <path d="M10 6.2V10.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            <circle cx="10" cy="13.6" r="0.9" fill="currentColor" />
        </svg>
        <div class="hearth-auth-alert-body">
            @HearthAuth.ToPortugueseError(AuthErrorCode.RegistrationDisabled)
        </div>
    </div>

    <p class="hearth-auth-footer">
        <span>Já tem conta?</span>
        <a href="/login" class="hearth-auth-link" data-testid="go-to-login">Entrar</a>
    </p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_serverError))
    {
        <div class="hearth-auth-alert" role="alert" tabindex="-1" data-testid="register-error">
            <svg class="hearth-auth-alert-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.6" />
                <path d="M10 6.2V10.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                <circle cx="10" cy="13.6" r="0.9" fill="currentColor" />
            </svg>
            <div class="hearth-auth-alert-body">@_serverError</div>
        </div>
    }

    <form method="post"
          action="/cadastro"
          @formname="register"
          @onsubmit="SubmitAsync"
          data-auth-form="true"
          novalidate>
        <AntiforgeryToken />

        <div class="hearth-auth-field">
            <label class="hearth-auth-label" for="register-name">Nome</label>
            <input id="register-name"
                   name="Input.Name"
                   type="text"
                   autocomplete="name"
                   maxlength="@DomainValidation.MaxNameLength"
                   value="@(Input?.Name ?? string.Empty)"
                   class="hearth-auth-input @(HasError("Name") ? "is-invalid" : null)"
                   aria-invalid="@(HasError("Name") ? "true" : "false")"
                   aria-describedby="@(HasError("Name") ? "register-name-error" : null)"
                   data-focus-on-load="@(_firstErrorField == "Name" ? "true" : null)"
                   required
                   data-testid="register-name-input" />
            @if (GetError("Name") is { } nameError)
            {
                <p id="register-name-error" class="hearth-auth-error" role="alert">
                    <svg class="hearth-auth-error-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                        <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.4" />
                        <path d="M8 4.8V8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                        <circle cx="8" cy="11.1" r="0.75" fill="currentColor" />
                    </svg>
                    <span>@nameError</span>
                </p>
            }
        </div>

        <div class="hearth-auth-field">
            <label class="hearth-auth-label" for="register-email">E-mail</label>
            <input id="register-email"
                   name="Input.Email"
                   type="email"
                   inputmode="email"
                   autocomplete="email"
                   autocapitalize="none"
                   autocorrect="off"
                   spellcheck="false"
                   placeholder="nome@exemplo.com…"
                   maxlength="@DomainValidation.MaxEmailLength"
                   value="@(Input?.Email ?? string.Empty)"
                   class="hearth-auth-input @(HasError("Email") ? "is-invalid" : null)"
                   aria-invalid="@(HasError("Email") ? "true" : "false")"
                   aria-describedby="@(HasError("Email") ? "register-email-error" : null)"
                   data-focus-on-load="@(_firstErrorField == "Email" ? "true" : null)"
                   required
                   data-testid="register-email-input" />
            @if (GetError("Email") is { } emailError)
            {
                <p id="register-email-error" class="hearth-auth-error" role="alert">
                    <svg class="hearth-auth-error-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                        <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.4" />
                        <path d="M8 4.8V8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                        <circle cx="8" cy="11.1" r="0.75" fill="currentColor" />
                    </svg>
                    <span>@emailError</span>
                </p>
            }
        </div>

        <div class="hearth-auth-field">
            <label class="hearth-auth-label" for="register-password">Senha</label>
            <div class="hearth-auth-password-wrap">
                <input id="register-password"
                       name="Input.Password"
                       type="password"
                       autocomplete="new-password"
                       autocapitalize="none"
                       autocorrect="off"
                       spellcheck="false"
                       minlength="@DomainValidation.MinPasswordLength"
                       maxlength="@DomainValidation.MaxPasswordLength"
                       value="@(Input?.Password ?? string.Empty)"
                       class="hearth-auth-input @(HasError("Password") ? "is-invalid" : null)"
                       aria-invalid="@(HasError("Password") ? "true" : "false")"
                       aria-describedby="register-password-help @(HasError("Password") ? "register-password-error" : string.Empty)"
                       data-focus-on-load="@(_firstErrorField == "Password" ? "true" : null)"
                       required
                       data-testid="register-password-input" />
                <button type="button"
                        class="hearth-auth-toggle-password"
                        data-toggle-password="register-password"
                        data-label-show="Mostrar senha"
                        data-label-hide="Ocultar senha"
                        aria-controls="register-password"
                        aria-label="Mostrar senha"
                        aria-pressed="false">
                    <svg class="hearth-auth-eye hearth-auth-eye--show" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M2.2 10C3.8 6.8 6.6 5 10 5C13.4 5 16.2 6.8 17.8 10C16.2 13.2 13.4 15 10 15C6.6 15 3.8 13.2 2.2 10Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                        <circle cx="10" cy="10" r="2.5" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                    <svg class="hearth-auth-eye hearth-auth-eye--hide" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M3 3L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                        <path d="M8.2 5.3C8.8 5.1 9.4 5 10 5C13.4 5 16.2 6.8 17.8 10C17.1 11.4 16.1 12.6 14.9 13.4M12.3 14.6C11.6 14.9 10.8 15 10 15C6.6 15 3.8 13.2 2.2 10C3.1 8.3 4.3 7 5.8 6.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="hearth-auth-toggle-text">Mostrar</span>
                </button>
            </div>
            <p id="register-password-help" class="hearth-auth-help">
                Mínimo de @DomainValidation.MinPasswordLength caracteres.
            </p>
            @if (GetError("Password") is { } passwordError)
            {
                <p id="register-password-error" class="hearth-auth-error" role="alert">
                    <svg class="hearth-auth-error-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                        <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.4" />
                        <path d="M8 4.8V8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                        <circle cx="8" cy="11.1" r="0.75" fill="currentColor" />
                    </svg>
                    <span>@passwordError</span>
                </p>
            }
        </div>

        <div class="hearth-auth-field">
            <label class="hearth-auth-label" for="register-confirm-password">Confirmar senha</label>
            <div class="hearth-auth-password-wrap">
                <input id="register-confirm-password"
                       name="Input.ConfirmPassword"
                       type="password"
                       autocomplete="new-password"
                       autocapitalize="none"
                       autocorrect="off"
                       spellcheck="false"
                       minlength="@DomainValidation.MinPasswordLength"
                       maxlength="@DomainValidation.MaxPasswordLength"
                       value="@(Input?.ConfirmPassword ?? string.Empty)"
                       class="hearth-auth-input @(HasError("ConfirmPassword") ? "is-invalid" : null)"
                       aria-invalid="@(HasError("ConfirmPassword") ? "true" : "false")"
                       aria-describedby="@(HasError("ConfirmPassword") ? "register-confirm-password-error" : null)"
                       data-focus-on-load="@(_firstErrorField == "ConfirmPassword" ? "true" : null)"
                       required
                       data-testid="register-confirm-password-input" />
                <button type="button"
                        class="hearth-auth-toggle-password"
                        data-toggle-password="register-confirm-password"
                        data-label-show="Mostrar confirmação de senha"
                        data-label-hide="Ocultar confirmação de senha"
                        aria-controls="register-confirm-password"
                        aria-label="Mostrar confirmação de senha"
                        aria-pressed="false">
                    <svg class="hearth-auth-eye hearth-auth-eye--show" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M2.2 10C3.8 6.8 6.6 5 10 5C13.4 5 16.2 6.8 17.8 10C16.2 13.2 13.4 15 10 15C6.6 15 3.8 13.2 2.2 10Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                        <circle cx="10" cy="10" r="2.5" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                    <svg class="hearth-auth-eye hearth-auth-eye--hide" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M3 3L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                        <path d="M8.2 5.3C8.8 5.1 9.4 5 10 5C13.4 5 16.2 6.8 17.8 10C17.1 11.4 16.1 12.6 14.9 13.4M12.3 14.6C11.6 14.9 10.8 15 10 15C6.6 15 3.8 13.2 2.2 10C3.1 8.3 4.3 7 5.8 6.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="hearth-auth-toggle-text">Mostrar</span>
                </button>
            </div>
            @if (GetError("ConfirmPassword") is { } confirmError)
            {
                <p id="register-confirm-password-error" class="hearth-auth-error" role="alert">
                    <svg class="hearth-auth-error-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                        <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.4" />
                        <path d="M8 4.8V8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                        <circle cx="8" cy="11.1" r="0.75" fill="currentColor" />
                    </svg>
                    <span>@confirmError</span>
                </p>
            }
        </div>

        <button type="submit"
                class="hearth-auth-submit"
                data-loading-text="Criando conta…"
                data-testid="register-submit">
            <span class="hearth-auth-spinner" aria-hidden="true"></span>
            <span class="hearth-auth-submit-label">Criar conta</span>
        </button>
    </form>

    <p class="hearth-auth-footer">
        <span>Já tem conta?</span>
        <a href="/login" class="hearth-auth-link" data-testid="go-to-login">Entrar</a>
    </p>
}

@code
{
    private readonly Dictionary<string, string> _fieldErrors = new(StringComparer.Ordinal);
    private string? _serverError;
    private string? _firstErrorField;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromForm(FormName = "register")]
    public RegisterInput? Input { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new RegisterInput();

        if (HttpContext?.User.Identity?.IsAuthenticated == true)
        {
            var destination = HearthAuth.IsSafeLocalReturnUrl(ReturnUrl) ? ReturnUrl! : "/";
            Navigation.NavigateTo(destination, replace: true);
        }
    }

    private async Task SubmitAsync()
    {
        Input ??= new RegisterInput();
        _fieldErrors.Clear();
        _serverError = null;
        _firstErrorField = null;

        if (!AuthOptions.Value.AllowRegistration)
        {
            if (HttpContext is not null)
            {
                HttpContext.Response.StatusCode = StatusCodes.Status403Forbidden;
            }

            ClearPasswords();
            _serverError = HearthAuth.ToPortugueseError(AuthErrorCode.RegistrationDisabled);
            return;
        }

        var name = Input.Name?.Trim() ?? string.Empty;
        var email = Input.Email?.Trim() ?? string.Empty;
        var password = Input.Password ?? string.Empty;
        var confirmPassword = Input.ConfirmPassword ?? string.Empty;

        Input.Name = name;
        Input.Email = email;

        if (string.IsNullOrWhiteSpace(name))
        {
            AddFieldError("Name", "Informe seu nome.");
        }
        else if (name.Length > DomainValidation.MaxNameLength)
        {
            AddFieldError("Name", $"O nome deve ter no máximo {DomainValidation.MaxNameLength} caracteres.");
        }

        if (!DomainValidation.IsValidEmail(email))
        {
            AddFieldError("Email", "Informe um e-mail válido.");
        }

        if (password.Length < DomainValidation.MinPasswordLength)
        {
            AddFieldError("Password", $"A senha deve ter pelo menos {DomainValidation.MinPasswordLength} caracteres.");
        }
        else if (password.Length > DomainValidation.MaxPasswordLength)
        {
            AddFieldError("Password", $"A senha deve ter no máximo {DomainValidation.MaxPasswordLength} caracteres.");
        }

        if (string.IsNullOrEmpty(confirmPassword))
        {
            AddFieldError("ConfirmPassword", "Confirme sua senha.");
        }
        else if (!string.Equals(password, confirmPassword, StringComparison.Ordinal))
        {
            AddFieldError("ConfirmPassword", "As senhas não conferem.");
        }

        if (_fieldErrors.Count > 0)
        {
            ClearPasswords();
            return;
        }

        var result = await RegisterUser.ExecuteAsync(new RegisterUserCommand(name, email, password));
        if (!result.IsSuccess || result.User is null)
        {
            ClearPasswords();

            if (result.ErrorCode == AuthErrorCode.EmailAlreadyInUse)
            {
                AddFieldError("Email", HearthAuth.ToPortugueseError(result.ErrorCode));
            }
            else
            {
                _serverError = HearthAuth.ToPortugueseError(result.ErrorCode);
            }

            return;
        }

        if (HttpContext is not null)
        {
            await HttpContext.SignInAsync(
                CookieAuthenticationDefaults.AuthenticationScheme,
                HearthAuth.CreatePrincipal(result.User),
                HearthAuth.CreateCookieProperties());
        }

        Navigation.NavigateTo("/onboarding", replace: true);
    }

    private void ClearPasswords()
    {
        if (Input is null)
        {
            return;
        }

        Input.Password = string.Empty;
        Input.ConfirmPassword = string.Empty;
    }

    private void AddFieldError(string field, string message)
    {
        if (!_fieldErrors.ContainsKey(field))
        {
            _fieldErrors[field] = message;
            _firstErrorField ??= field;
        }
    }

    private bool HasError(string field) => _fieldErrors.ContainsKey(field);

    private string? GetError(string field) =>
        _fieldErrors.TryGetValue(field, out var message) ? message : null;

    public sealed class RegisterInput
    {
        public string Name { get; set; } = string.Empty;

        public string Email { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;

        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
