@page "/orcamentos"
@attribute [Authorize]
@inherits AccountPageBase
@inject ISnackbar Snackbar
@using Hearth.Application.Categories
@using Hearth.Application.Categories.ListCategories
@using Hearth.Application.CategoryBudgets
@using Hearth.Application.CategoryBudgets.ChangeCategoryBudgetAmount
@using Hearth.Application.CategoryBudgets.CreateCategoryBudget
@using Hearth.Application.CategoryBudgets.DeleteCategoryBudget
@using Hearth.Application.CategoryBudgets.EndCategoryBudget
@using Hearth.Application.CategoryBudgets.ListCategoryBudgets

<PageTitle>Orçamentos — Hearth Finance</PageTitle>

<div class="hearth-page">
    <PageHeader Title="Orçamentos"
                Subtitle="Metas mensais por categoria pelo regime de competência — informativas, sem bloquear lançamentos.">
        <Actions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="hearth-btn-clean"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="ToggleCreateForm"
                       Disabled="_saving || _activeCategories.Count == 0"
                       data-testid="toggle-create-budget">
                @(_showCreateForm ? "Fechar formulário" : "Novo orçamento")
            </MudButton>
        </Actions>
    </PageHeader>

    @if (_showCreateForm)
    {
        <section class="hearth-form-panel" data-testid="create-budget-panel">
            <h2 class="hearth-card-title">Novo orçamento por categoria</h2>

            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?"
                               @bind-Value="_newCategoryId"
                               Label="Categoria"
                               Variant="Variant.Outlined"
                               Required="true"
                               Disabled="_saving"
                               data-testid="budget-category-select">
                        @foreach (var category in _activeCategories)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)category.Id)">@category.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_newAmount"
                                     Label="Valor mensal"
                                     Variant="Variant.Outlined"
                                     Culture="@HearthFormat.PtBr"
                                     Format="N2"
                                     Adornment="Adornment.Start"
                                     AdornmentText="R$"
                                     HideSpinButtons="true"
                                     Disabled="_saving"
                                     data-testid="budget-amount-input" />
                </MudItem>

                <MudItem xs="6" sm="3">
                    <MudNumericField T="int"
                                     @bind-Value="_newStartMonth"
                                     Label="Mês inicial"
                                     Variant="Variant.Outlined"
                                     Min="1"
                                     Max="12"
                                     Disabled="_saving"
                                     data-testid="budget-start-month-input" />
                </MudItem>

                <MudItem xs="6" sm="3">
                    <MudNumericField T="int"
                                     @bind-Value="_newStartYear"
                                     Label="Ano inicial"
                                     Variant="Variant.Outlined"
                                     Min="2000"
                                     Max="2100"
                                     Disabled="_saving"
                                     data-testid="budget-start-year-input" />
                </MudItem>

                <MudItem xs="12" sm="6" Class="d-flex align-center">
                    <MudSwitch T="bool"
                               @bind-Value="_hasEndMonth"
                               Color="Color.Primary"
                               Label="Definir mês final?"
                               Disabled="_saving" />
                </MudItem>

                @if (_hasEndMonth)
                {
                    <MudItem xs="6" sm="3">
                        <MudNumericField T="int"
                                         @bind-Value="_newEndMonth"
                                         Label="Mês final"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Max="12"
                                         Disabled="_saving"
                                         data-testid="budget-end-month-input" />
                    </MudItem>

                    <MudItem xs="6" sm="3">
                        <MudNumericField T="int"
                                         @bind-Value="_newEndYear"
                                         Label="Ano final"
                                         Variant="Variant.Outlined"
                                         Min="2000"
                                         Max="2100"
                                         Disabled="_saving"
                                         data-testid="budget-end-year-input" />
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                        <MudButton Variant="Variant.Text" OnClick="ToggleCreateForm" Disabled="_saving">
                            Cancelar
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Class="hearth-btn-clean"
                                   OnClick="CreateBudgetAsync"
                                   Disabled="_saving || !_newCategoryId.HasValue || _newAmount <= 0"
                                   data-testid="create-budget-submit">
                            @(_saving ? "Salvando…" : "Criar orçamento")
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </section>
    }

    @* Painel unificado de edição do orçamento (reajuste de valor e encerramento) *@
    @if (_editingBudget is not null)
    {
        <section class="hearth-form-panel" data-testid="edit-budget-panel">
            <div class="hearth-module-head">
                <div>
                    <h2 class="hearth-card-title">Editar orçamento — @_editingBudget.CategoryName</h2>
                    <p class="hearth-card-meta">
                        Reajuste o teto a partir de @HearthFormat.MonthYear(CurrentMonth) ou defina o último mês de vigência.
                    </p>
                </div>
                <MudButton Variant="Variant.Text" OnClick="CancelInlineEditors" Disabled="_saving">Fechar</MudButton>
            </div>

            <MudGrid Spacing="3" Class="align-center">
                <MudItem xs="12" sm="8">
                    <MudNumericField T="decimal"
                                     @bind-Value="_editAmount"
                                     Label="Novo valor mensal"
                                     Variant="Variant.Outlined"
                                     Culture="@HearthFormat.PtBr"
                                     Format="N2"
                                     Adornment="Adornment.Start"
                                     AdornmentText="R$"
                                     HideSpinButtons="true"
                                     HelperText="Meses anteriores preservam o teto original."
                                     Disabled="_saving"
                                     data-testid="edit-budget-amount-input" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Class="hearth-btn-clean"
                               FullWidth="true"
                               OnClick="SaveBudgetAmountAsync"
                               Disabled="_saving || _editAmount <= 0"
                               data-testid="save-budget-amount">
                        @(_saving ? "Salvando…" : "Salvar valor")
                    </MudButton>
                </MudItem>
            </MudGrid>

            <div class="hearth-form-divider"></div>

            <MudGrid Spacing="3" Class="align-center">
                <MudItem xs="6" sm="4">
                    <MudNumericField T="int"
                                     @bind-Value="_endLastMonth"
                                     Label="Último mês"
                                     Variant="Variant.Outlined"
                                     Min="1"
                                     Max="12"
                                     Disabled="_saving"
                                     data-testid="end-budget-month-input" />
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudNumericField T="int"
                                     @bind-Value="_endLastYear"
                                     Label="Último ano"
                                     Variant="Variant.Outlined"
                                     Min="2000"
                                     Max="2100"
                                     Disabled="_saving"
                                     data-testid="end-budget-year-input" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               Class="hearth-btn-clean"
                               FullWidth="true"
                               OnClick="SaveEndBudgetAsync"
                               Disabled="_saving"
                               data-testid="save-budget-end">
                        @(_saving ? "Salvando…" : "Confirmar encerramento")
                    </MudButton>
                </MudItem>
            </MudGrid>
        </section>
    }

    @if (_loading)
    {
        <div class="hearth-card hearth-skeleton-panel"></div>
    }
    else
    {
        <section class="hearth-table-shell" aria-label="Lista de orçamentos">
            <MudTable Items="_budgets" Hover="true" Dense="true" Elevation="0" Class="hearth-data-table">
                <HeaderContent>
                    <MudTh>Categoria</MudTh>
                    <MudTh>Vigência</MudTh>
                    <MudTh Style="text-align: right;">Valor vigente</MudTh>
                    <MudTh>Histórico</MudTh>
                    <MudTh Style="width: 140px; text-align: right;">Ações</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Categoria" Class="hearth-cell-title">@context.CategoryName</MudTd>
                    <MudTd DataLabel="Vigência" Class="hearth-money hearth-cell-muted">@FormatPeriod(context)</MudTd>
                    <MudTd DataLabel="Valor vigente" Class="hearth-cell-amount">
                        @HearthFormat.Money(GetCurrentOrLatestAmount(context))
                    </MudTd>
                    <MudTd DataLabel="Histórico">
                        <div class="hearth-history-chips">
                            @foreach (var change in context.AmountHistory)
                            {
                                <span class="hearth-history-chip">
                                    @HearthFormat.ShortMonthYear(change.EffectiveFromYear, change.EffectiveFromMonth): @HearthFormat.Money(change.Amount)
                                </span>
                            }
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Ações" Style="text-align: right;">
                        @if (_confirmDeleteBudgetId == context.Id)
                        {
                            <MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Spacing="1">
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Filled"
                                           Color="Color.Error"
                                           OnClick="() => DeleteBudgetAsync(context.Id)"
                                           Disabled="_saving"
                                           data-testid="@($"confirm-delete-budget-{context.Id}")">
                                    Confirmar
                                </MudButton>
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Text"
                                           OnClick="() => _confirmDeleteBudgetId = null"
                                           Disabled="_saving">
                                    Cancelar
                                </MudButton>
                            </MudStack>
                        }
                        else
                        {
                            <div class="hearth-row-actions">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Class="hearth-action-btn"
                                               title="Editar orçamento"
                                               aria-label="Editar orçamento"
                                               OnClick="() => StartEditBudget(context)"
                                               Disabled="_saving"
                                               data-testid="@($"edit-budget-{context.Id}")" />

                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Class="hearth-action-btn is-danger"
                                               title="Excluir orçamento"
                                               aria-label="Excluir orçamento"
                                               OnClick="() => StartDelete(context.Id)"
                                               Disabled="_saving"
                                               data-testid="@($"delete-budget-{context.Id}")" />
                            </div>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Compact="true"
                                CssClass="ma-4"
                                Title="Nenhum orçamento cadastrado"
                                Description="Clique em &quot;Novo orçamento&quot; para definir metas mensais por categoria." />
                </NoRecordsContent>
            </MudTable>
        </section>
    }
</div>

@code
{
    private IReadOnlyList<CategoryBudgetDto> _budgets = [];
    private IReadOnlyList<CategoryDto> _activeCategories = [];

    private bool _loading = true;
    private bool _saving;
    private bool _showCreateForm;

    private Guid? _newCategoryId;
    private decimal _newAmount;
    private int _newStartMonth;
    private int _newStartYear;
    private bool _hasEndMonth;
    private int _newEndMonth;
    private int _newEndYear;

    private CategoryBudgetDto? _editingBudget;
    private decimal _editAmount;
    private int _endLastMonth;
    private int _endLastYear;

    private Guid? _confirmDeleteBudgetId;

    private YearMonth CurrentMonth => YearMonth.From(Clock.Today);

    protected override async Task LoadDataAsync(CancellationToken cancellationToken)
    {
        _loading = true;

        var budgetsResult = await Executor.ExecuteAsync<ListCategoryBudgetsHandler, IReadOnlyList<CategoryBudgetDto>>(
            (handler, ct) => handler.ExecuteAsync(new ListCategoryBudgetsQuery(AccountId), ct),
            cancellationToken: cancellationToken);

        var categoriesResult = await Executor.ExecuteAsync<ListCategoriesHandler, IReadOnlyList<CategoryDto>>(
            (handler, ct) => handler.ExecuteAsync(new ListCategoriesQuery(IncludeArchived: false), ct),
            cancellationToken: cancellationToken);

        if (budgetsResult.IsSuccess && budgetsResult.Value is not null)
        {
            _budgets = budgetsResult.Value;
        }

        if (categoriesResult.IsSuccess && categoriesResult.Value is not null)
        {
            _activeCategories = categoriesResult.Value;
        }

        ResetCreateDefaults();
        _loading = false;
    }

    private void ResetCreateDefaults()
    {
        var today = Clock.Today;
        _newStartMonth = today.Month;
        _newStartYear = today.Year;
        _newEndMonth = today.Month;
        _newEndYear = today.Year;
        _hasEndMonth = false;
        _newAmount = 0m;
        _newCategoryId = _activeCategories.FirstOrDefault()?.Id;
    }

    private void ToggleCreateForm()
    {
        CancelInlineEditors();
        _showCreateForm = !_showCreateForm;
        if (_showCreateForm)
        {
            ResetCreateDefaults();
        }
    }

    private void CancelInlineEditors()
    {
        _editingBudget = null;
        _confirmDeleteBudgetId = null;
    }

    private async Task CreateBudgetAsync()
    {
        if (_saving || !_newCategoryId.HasValue || _newAmount <= 0)
        {
            return;
        }

        _saving = true;

        try
        {
            var command = new CreateCategoryBudgetCommand(
                AccountId,
                _newCategoryId.Value,
                _newStartYear,
                _newStartMonth,
                _hasEndMonth ? _newEndYear : null,
                _hasEndMonth ? _newEndMonth : null,
                _newAmount);

            var result = await Executor.ExecuteAsync<CreateCategoryBudgetHandler, Guid>(
                (handler, ct) => handler.ExecuteAsync(command, ct),
                successMessage: "Orçamento criado.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _showCreateForm = false;
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartEditBudget(CategoryBudgetDto budget)
    {
        _showCreateForm = false;
        CancelInlineEditors();
        _editingBudget = budget;
        _editAmount = GetCurrentOrLatestAmount(budget);
        _endLastMonth = budget.EndMonth ?? Clock.Today.Month;
        _endLastYear = budget.EndYear ?? Clock.Today.Year;
    }

    private async Task SaveBudgetAmountAsync()
    {
        if (_saving || _editingBudget is null || _editAmount <= 0)
        {
            return;
        }

        _saving = true;

        try
        {
            var budgetId = _editingBudget.Id;
            var result = await Executor.ExecuteAsync<ChangeCategoryBudgetAmountHandler, ChangeCategoryBudgetAmountResult>(
                (handler, ct) => handler.ExecuteAsync(
                    new ChangeCategoryBudgetAmountCommand(budgetId, _editAmount), ct),
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess && result.Value is not null)
            {
                _editingBudget = null;
                var effective = HearthFormat.MonthYear(result.Value.EffectiveFromYear, result.Value.EffectiveFromMonth);
                Snackbar.Add($"Valor atualizado a partir de {effective}.", Severity.Success);
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveEndBudgetAsync()
    {
        if (_saving || _editingBudget is null)
        {
            return;
        }

        _saving = true;

        try
        {
            var budgetId = _editingBudget.Id;
            var result = await Executor.ExecuteAsync<EndCategoryBudgetHandler>(
                (handler, ct) => handler.ExecuteAsync(
                    new EndCategoryBudgetCommand(budgetId, _endLastYear, _endLastMonth), ct),
                successMessage: "Vigência do orçamento atualizada.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _editingBudget = null;
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartDelete(Guid budgetId)
    {
        _showCreateForm = false;
        CancelInlineEditors();
        _confirmDeleteBudgetId = budgetId;
    }

    private async Task DeleteBudgetAsync(Guid budgetId)
    {
        if (_saving)
        {
            return;
        }

        _saving = true;

        try
        {
            var result = await Executor.ExecuteAsync<DeleteCategoryBudgetHandler>(
                (handler, ct) => handler.ExecuteAsync(new DeleteCategoryBudgetCommand(budgetId), ct),
                successMessage: "Orçamento excluído.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _confirmDeleteBudgetId = null;
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string FormatPeriod(CategoryBudgetDto budget)
    {
        var start = HearthFormat.ShortMonthYear(budget.StartYear, budget.StartMonth);
        var end = budget.EndYear.HasValue && budget.EndMonth.HasValue
            ? HearthFormat.ShortMonthYear(budget.EndYear.Value, budget.EndMonth.Value)
            : "Em aberto";

        return $"{start} — {end}";
    }

    private decimal GetCurrentOrLatestAmount(CategoryBudgetDto budget)
    {
        var current = CurrentMonth;
        var entry = budget.AmountHistory
            .LastOrDefault(change => YearMonth.Of(change.EffectiveFromYear, change.EffectiveFromMonth) <= current);

        return entry?.Amount ?? budget.AmountHistory[^1].Amount;
    }
}
