@page "/despesas-fixas"
@attribute [Authorize]
@inherits AccountPageBase
@inject ISnackbar Snackbar
@using Hearth.Application.Categories
@using Hearth.Application.Categories.ListCategories
@using Hearth.Application.FixedExpenses
@using Hearth.Application.FixedExpenses.ChangeFixedExpenseAmount
@using Hearth.Application.FixedExpenses.DeleteFixedExpense
@using Hearth.Application.FixedExpenses.EndFixedExpense
@using Hearth.Application.FixedExpenses.ListFixedExpenses
@using Hearth.Application.FixedExpenses.MarkFixedExpenseAsPaid
@using Hearth.Application.FixedExpenses.RegisterFixedExpense
@using Hearth.Application.FixedExpenses.RevertFixedExpensePayment
@using Hearth.Application.FixedExpenses.UpdateFixedExpenseDetails
@using Hearth.Web.Components.Shared

<PageTitle>Despesas Fixas — Hearth Finance</PageTitle>

<div class="hearth-page">
    <PageHeader Title="Despesas fixas"
                Subtitle="Assinaturas e contas recorrentes com controle mensal de pagamento e vigência.">
        <Actions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="hearth-btn-clean"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="StartCreate"
                       Disabled="_saving || ActiveCategories.Count == 0"
                       data-testid="new-fixed-expense-button">
                Nova despesa fixa
            </MudButton>
        </Actions>
    </PageHeader>

    <div class="hearth-command-bar">
        <div class="hearth-command-controls">
            <MonthNavigator Month="_selectedMonth" MinMonth="TrackingStartPeriod" MonthChanged="OnMonthChanged" Disabled="_saving" />
            <MudSwitch T="bool" @bind-Value="_showInactiveInMonth" Color="Color.Primary" Label="Mostrar inativas no mês" />
        </div>

        @if (!_loading)
        {
            <div class="hearth-summary-metrics hearth-money">
                <span class="hearth-summary-metric">Ativas: <strong>@ActiveInSelectedMonthCount</strong></span>
                <span class="hearth-summary-metric">
                    Total do mês: <strong>@HearthFormat.Money(TotalActiveInSelectedMonth)</strong>
                </span>
            </div>
        }
    </div>

    @if (_showCreateForm)
    {
        <section class="hearth-form-panel" data-testid="create-fixed-form">
            <h2 class="hearth-card-title">Nova despesa fixa</h2>
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_description"
                                  Label="Descrição"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  MaxLength="@DomainValidation.MaxDescriptionLength"
                                  Counter="@DomainValidation.MaxDescriptionLength"
                                  Immediate="true"
                                  Disabled="_saving"
                                  data-testid="fixed-description-input" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?"
                               @bind-Value="_categoryId"
                               Label="Categoria"
                               Variant="Variant.Outlined"
                               Required="true"
                               Disabled="_saving"
                               data-testid="fixed-category-select">
                        @foreach (var category in ActiveCategories)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)category.Id)">@category.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_amount"
                                     Label="Valor mensal"
                                     Variant="Variant.Outlined"
                                     Culture="@HearthFormat.PtBr"
                                     Format="N2"
                                     Adornment="Adornment.Start"
                                     AdornmentText="R$"
                                     HideSpinButtons="true"
                                     Disabled="_saving"
                                     data-testid="fixed-amount-input" />
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudNumericField T="int" @bind-Value="_startMonth" Label="Mês início" Variant="Variant.Outlined" Min="1" Max="12" Disabled="_saving" />
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudNumericField T="int" @bind-Value="_startYear" Label="Ano início" Variant="Variant.Outlined" Min="2000" Max="2100" Disabled="_saving" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="d-flex align-center">
                    <MudSwitch T="bool" @bind-Value="_hasEndMonth" Color="Color.Primary" Label="Definir fim?" Disabled="_saving" />
                </MudItem>
                @if (_hasEndMonth)
                {
                    <MudItem xs="6" sm="3">
                        <MudNumericField T="int" @bind-Value="_endMonth" Label="Mês fim" Variant="Variant.Outlined" Min="1" Max="12" Disabled="_saving" />
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField T="int" @bind-Value="_endYear" Label="Ano fim" Variant="Variant.Outlined" Min="2000" Max="2100" Disabled="_saving" />
                    </MudItem>
                }
                <MudItem xs="12">
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                        <MudButton Variant="Variant.Text" OnClick="CancelPanels" Disabled="_saving">Cancelar</MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Class="hearth-btn-clean"
                                   OnClick="CreateAsync"
                                   Disabled="_saving || string.IsNullOrWhiteSpace(_description) || !_categoryId.HasValue || _amount <= 0"
                                   data-testid="create-fixed-submit">
                            @(_saving ? "Salvando…" : "Salvar")
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </section>
    }

    @* Painel unificado de edição da despesa fixa (detalhes, reajuste de valor e encerramento) *@
    @if (_editingExpense is not null)
    {
        <section class="hearth-form-panel" data-testid="edit-fixed-panel">
            <div class="hearth-module-head">
                <div>
                    <h2 class="hearth-card-title">Editar despesa fixa — @_editingExpense.Description</h2>
                    <p class="hearth-card-meta">Atualize descrição, categoria, reajuste de valor ou encerramento de vigência.</p>
                </div>
                <MudButton Variant="Variant.Text" OnClick="CancelPanels" Disabled="_saving">Fechar</MudButton>
            </div>

            <MudGrid Spacing="3" Class="align-center">
                <MudItem xs="12" sm="5">
                    <MudTextField @bind-Value="_editDescription"
                                  Label="Descrição"
                                  Variant="Variant.Outlined"
                                  MaxLength="@DomainValidation.MaxDescriptionLength"
                                  Immediate="true"
                                  Disabled="_saving"
                                  data-testid="edit-fixed-description-input" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="Guid?" @bind-Value="_editCategoryId" Label="Categoria" Variant="Variant.Outlined" Disabled="_saving">
                        @foreach (var category in _allCategories.Where(c => !c.IsArchived || c.Id == _editingExpense.CategoryId))
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)category.Id)">
                                @(category.IsArchived ? $"{category.Name} (Arquivada)" : category.Name)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Class="hearth-btn-clean"
                               FullWidth="true"
                               OnClick="SaveDetailsAsync"
                               Disabled="_saving || string.IsNullOrWhiteSpace(_editDescription) || !_editCategoryId.HasValue"
                               data-testid="save-fixed-details">
                        Salvar detalhes
                    </MudButton>
                </MudItem>
            </MudGrid>

            <div class="hearth-form-divider"></div>

            <MudGrid Spacing="3" Class="align-center">
                <MudItem xs="12" sm="9">
                    <MudNumericField T="decimal"
                                     @bind-Value="_newAmount"
                                     Label="Novo valor mensal"
                                     Variant="Variant.Outlined"
                                     Culture="@HearthFormat.PtBr"
                                     Format="N2"
                                     Adornment="Adornment.Start"
                                     AdornmentText="R$"
                                     HideSpinButtons="true"
                                     HelperText="Vale a partir do próximo mês em aberto; meses pagos ou congelados permanecem intactos."
                                     Disabled="_saving"
                                     data-testid="change-fixed-amount-input" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Class="hearth-btn-clean"
                               FullWidth="true"
                               OnClick="SaveAmountChangeAsync"
                               Disabled="_saving || _newAmount <= 0"
                               data-testid="save-fixed-amount">
                        Atualizar valor
                    </MudButton>
                </MudItem>
            </MudGrid>

            <div class="hearth-form-divider"></div>

            <MudGrid Spacing="3" Class="align-center">
                <MudItem xs="6" sm="4">
                    <MudNumericField T="int" @bind-Value="_endLastMonth" Label="Último mês de vigência" Variant="Variant.Outlined" Min="1" Max="12" Disabled="_saving" data-testid="end-fixed-month-input" />
                </MudItem>
                <MudItem xs="6" sm="5">
                    <MudNumericField T="int" @bind-Value="_endLastYear" Label="Último ano" Variant="Variant.Outlined" Min="2000" Max="2100" Disabled="_saving" data-testid="end-fixed-year-input" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               Class="hearth-btn-clean"
                               FullWidth="true"
                               OnClick="SaveEndAsync"
                               Disabled="_saving"
                               data-testid="save-fixed-end">
                        Encerrar vigência
                    </MudButton>
                </MudItem>
            </MudGrid>
        </section>
    }

    @if (_payingExpense is not null)
    {
        <section class="hearth-form-panel" data-testid="pay-fixed-panel">
            <h2 class="hearth-card-title">
                Pagar "@_payingExpense.Description" — @HearthFormat.MonthYear(_selectedMonth)
            </h2>
            <MudGrid Spacing="3" Class="align-center">
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_paidOn"
                                   Label="Data do pagamento"
                                   Variant="Variant.Outlined"
                                   DateFormat="dd/MM/yyyy"
                                   Culture="@HearthFormat.PtBr"
                                   Editable="true"
                                   Disabled="_saving"
                                   data-testid="fixed-paid-on-input" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Class="hearth-btn-clean"
                                   OnClick="ConfirmPaymentAsync"
                                   Disabled="_saving || !_paidOn.HasValue"
                                   data-testid="confirm-fixed-payment">
                            Confirmar pagamento
                        </MudButton>
                        <MudButton Variant="Variant.Text" OnClick="CancelPanels" Disabled="_saving">Cancelar</MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </section>
    }

    @if (_loading)
    {
        <div class="hearth-card hearth-skeleton-panel"></div>
    }
    else
    {
        <section class="hearth-table-shell" aria-label="Lista de despesas fixas">
            <MudTable Items="VisibleExpenses" Hover="true" Dense="true" Elevation="0" Class="hearth-data-table">
                <HeaderContent>
                    <MudTh>Descrição</MudTh>
                    <MudTh>Categoria</MudTh>
                    <MudTh>Vigência</MudTh>
                    <MudTh Style="text-align: right;">Valor no mês</MudTh>
                    <MudTh>Pagamento (@HearthFormat.ShortMonthYear(_selectedMonth))</MudTh>
                    <MudTh Style="width: 156px; text-align: right;">Ações</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{
                        var isActive = FixedExpenseViewHelper.IsActiveIn(context, _selectedMonth);
                        var monthAmount = FixedExpenseViewHelper.GetAmountFor(context, _selectedMonth);
                        var payment = FixedExpenseViewHelper.GetPaymentFor(context, _selectedMonth);
                    }
                    <MudTd DataLabel="Descrição" Class="hearth-cell-title">@context.Description</MudTd>
                    <MudTd DataLabel="Categoria" Class="hearth-cell-muted">@GetCategoryName(context.CategoryId)</MudTd>
                    <MudTd DataLabel="Vigência" Class="hearth-money hearth-cell-muted">@FormatPeriod(context)</MudTd>
                    <MudTd DataLabel="Valor no mês" Class="hearth-cell-amount">
                        @(monthAmount.HasValue ? HearthFormat.Money(monthAmount.Value) : "Inativa")
                    </MudTd>
                    <MudTd DataLabel="Pagamento">
                        @if (!isActive)
                        {
                            <span class="hearth-status-pill is-neutral">Fora da vigência</span>
                        }
                        else if (payment is not null)
                        {
                            <span class="hearth-status-pill is-positive hearth-money">Paga em @HearthFormat.Date(payment.PaidOn)</span>
                        }
                        else
                        {
                            <span class="hearth-status-pill is-warning">Em aberto</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Ações" Style="text-align: right;">
                        @if (_confirmDeleteId == context.Id)
                        {
                            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Filled"
                                           Color="Color.Error"
                                           OnClick="() => DeleteAsync(context.Id)"
                                           Disabled="_saving"
                                           data-testid="@($"confirm-delete-fixed-{context.Id}")">
                                    Confirmar
                                </MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _confirmDeleteId = null" Disabled="_saving">
                                    Cancelar
                                </MudButton>
                            </MudStack>
                        }
                        else
                        {
                            <div class="hearth-row-actions">
                                @if (isActive && payment is null)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                                   Size="Size.Small"
                                                   Class="hearth-action-btn is-positive"
                                                   title="Marcar como paga neste mês"
                                                   aria-label="Marcar como paga neste mês"
                                                   OnClick="() => StartPay(context)"
                                                   Disabled="_saving"
                                                   data-testid="@($"pay-fixed-{context.Id}")" />
                                }
                                else if (isActive && payment is not null)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Undo"
                                                   Size="Size.Small"
                                                   Class="hearth-action-btn is-warning"
                                                   title="Reverter pagamento deste mês"
                                                   aria-label="Reverter pagamento deste mês"
                                                   OnClick="() => RevertPaymentAsync(context.Id)"
                                                   Disabled="_saving"
                                                   data-testid="@($"revert-fixed-{context.Id}")" />
                                }

                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Class="hearth-action-btn"
                                               title="Editar despesa fixa"
                                               aria-label="Editar despesa fixa"
                                               OnClick="() => StartEdit(context)"
                                               Disabled="_saving"
                                               data-testid="@($"edit-fixed-{context.Id}")" />

                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Class="hearth-action-btn is-danger"
                                               title="Excluir despesa fixa"
                                               aria-label="Excluir despesa fixa"
                                               OnClick="() => _confirmDeleteId = context.Id"
                                               Disabled="_saving"
                                               data-testid="@($"delete-fixed-{context.Id}")" />
                            </div>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Compact="true"
                                CssClass="ma-4"
                                Title="@($"Nenhuma despesa fixa em {HearthFormat.MonthYear(_selectedMonth)}")"
                                Description="Ative &quot;Mostrar inativas no mês&quot; ou cadastre uma nova assinatura acima." />
                </NoRecordsContent>
            </MudTable>
        </section>
    }
</div>

@code
{
    private IReadOnlyList<FixedExpenseDto> _expenses = [];
    private IReadOnlyList<CategoryDto> _allCategories = [];
    private Dictionary<Guid, string> _categoryNames = [];

    private YearMonth _selectedMonth = YearMonth.Of(2026, 1);
    private bool _showInactiveInMonth;
    private bool _loading = true;
    private bool _saving;

    private bool _showCreateForm;
    private string _description = string.Empty;
    private Guid? _categoryId;
    private decimal _amount;
    private int _startMonth;
    private int _startYear;
    private bool _hasEndMonth;
    private int _endMonth;
    private int _endYear;

    private FixedExpenseDto? _editingExpense;
    private string _editDescription = string.Empty;
    private Guid? _editCategoryId;
    private decimal _newAmount;
    private int _endLastMonth;
    private int _endLastYear;

    private FixedExpenseDto? _payingExpense;
    private DateTime? _paidOn;

    private Guid? _confirmDeleteId;

    private IReadOnlyList<CategoryDto> ActiveCategories =>
        _allCategories.Where(c => !c.IsArchived).ToList();

    private IReadOnlyList<FixedExpenseDto> VisibleExpenses =>
        _showInactiveInMonth
            ? _expenses
            : _expenses.Where(e => FixedExpenseViewHelper.IsActiveIn(e, _selectedMonth)).ToList();

    private int ActiveInSelectedMonthCount =>
        _expenses.Count(e => FixedExpenseViewHelper.IsActiveIn(e, _selectedMonth));

    private decimal TotalActiveInSelectedMonth =>
        _expenses.Sum(e => FixedExpenseViewHelper.GetAmountFor(e, _selectedMonth) ?? 0m);

    protected override void OnInitialized()
    {
        _selectedMonth = YearMonth.From(Clock.Today);
    }

    protected override async Task LoadDataAsync(CancellationToken cancellationToken)
    {
        _loading = true;

        var expensesResult = await Executor.ExecuteAsync<ListFixedExpensesHandler, IReadOnlyList<FixedExpenseDto>>(
            (handler, ct) => handler.ExecuteAsync(new ListFixedExpensesQuery(AccountId), ct),
            cancellationToken: cancellationToken);

        var categoriesResult = await Executor.ExecuteAsync<ListCategoriesHandler, IReadOnlyList<CategoryDto>>(
            (handler, ct) => handler.ExecuteAsync(new ListCategoriesQuery(IncludeArchived: true), ct),
            cancellationToken: cancellationToken);

        if (expensesResult.IsSuccess && expensesResult.Value is not null)
        {
            _expenses = expensesResult.Value;
        }

        if (categoriesResult.IsSuccess && categoriesResult.Value is not null)
        {
            _allCategories = categoriesResult.Value;
            _categoryNames = _allCategories.ToDictionary(c => c.Id, c => c.Name);
        }

        _loading = false;
    }

    private void OnMonthChanged(YearMonth month)
    {
        _selectedMonth = month;
        _payingExpense = null;
    }

    private void CancelPanels()
    {
        _showCreateForm = false;
        _editingExpense = null;
        _payingExpense = null;
        _confirmDeleteId = null;
    }

    private void StartCreate()
    {
        CancelPanels();
        _description = string.Empty;
        _categoryId = ActiveCategories.FirstOrDefault()?.Id;
        _amount = 0m;
        _startMonth = _selectedMonth.Month;
        _startYear = _selectedMonth.Year;
        _hasEndMonth = false;
        _endMonth = _selectedMonth.Month;
        _endYear = _selectedMonth.Year;
        _showCreateForm = true;
    }

    private async Task CreateAsync()
    {
        if (_saving || string.IsNullOrWhiteSpace(_description) || !_categoryId.HasValue || _amount <= 0)
        {
            return;
        }

        _saving = true;

        try
        {
            var command = new RegisterFixedExpenseCommand(
                AccountId,
                _startYear,
                _startMonth,
                _hasEndMonth ? _endYear : null,
                _hasEndMonth ? _endMonth : null,
                _amount,
                _description.Trim(),
                _categoryId.Value);

            var result = await Executor.ExecuteAsync<RegisterFixedExpenseHandler, Guid>(
                (handler, ct) => handler.ExecuteAsync(command, ct),
                successMessage: "Despesa fixa registrada.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _showCreateForm = false;
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartEdit(FixedExpenseDto expense)
    {
        CancelPanels();
        _editingExpense = expense;
        _editDescription = expense.Description;
        _editCategoryId = expense.CategoryId;
        _newAmount = FixedExpenseViewHelper.GetCurrentOrLatestAmount(expense, _selectedMonth);
        _endLastMonth = expense.EndMonth ?? _selectedMonth.Month;
        _endLastYear = expense.EndYear ?? _selectedMonth.Year;
    }

    private async Task SaveDetailsAsync()
    {
        if (_saving || _editingExpense is null || string.IsNullOrWhiteSpace(_editDescription) || !_editCategoryId.HasValue)
        {
            return;
        }

        _saving = true;

        try
        {
            var id = _editingExpense.Id;
            var result = await Executor.ExecuteAsync<UpdateFixedExpenseDetailsHandler>(
                (handler, ct) => handler.ExecuteAsync(
                    new UpdateFixedExpenseDetailsCommand(id, _editDescription.Trim(), _editCategoryId.Value), ct),
                successMessage: "Despesa fixa atualizada.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _editingExpense = null;
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveAmountChangeAsync()
    {
        if (_saving || _editingExpense is null || _newAmount <= 0)
        {
            return;
        }

        _saving = true;

        try
        {
            var id = _editingExpense.Id;
            var result = await Executor.ExecuteAsync<ChangeFixedExpenseAmountHandler, ChangeFixedExpenseAmountResult>(
                (handler, ct) => handler.ExecuteAsync(new ChangeFixedExpenseAmountCommand(id, _newAmount), ct),
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess && result.Value is not null)
            {
                _editingExpense = null;
                var effective = HearthFormat.MonthYear(result.Value.EffectiveFromYear, result.Value.EffectiveFromMonth);
                Snackbar.Add($"Valor atualizado a partir de {effective}.", Severity.Success);
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveEndAsync()
    {
        if (_saving || _editingExpense is null)
        {
            return;
        }

        _saving = true;

        try
        {
            var id = _editingExpense.Id;
            var result = await Executor.ExecuteAsync<EndFixedExpenseHandler>(
                (handler, ct) => handler.ExecuteAsync(new EndFixedExpenseCommand(id, _endLastYear, _endLastMonth), ct),
                successMessage: "Vigência da despesa fixa atualizada.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _editingExpense = null;
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartPay(FixedExpenseDto expense)
    {
        CancelPanels();
        _payingExpense = expense;
        _paidOn = HearthFormat.ToDateTime(Clock.Today);
    }

    private async Task ConfirmPaymentAsync()
    {
        if (_saving || _payingExpense is null || !_paidOn.HasValue)
        {
            return;
        }

        _saving = true;

        try
        {
            var id = _payingExpense.Id;
            var paidOn = HearthFormat.ToDateOnly(_paidOn.Value);

            var result = await Executor.ExecuteAsync<MarkFixedExpenseAsPaidHandler, bool>(
                (handler, ct) => handler.ExecuteAsync(
                    new MarkFixedExpenseAsPaidCommand(id, _selectedMonth.Year, _selectedMonth.Month, paidOn), ct),
                successMessage: "Pagamento registrado.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _payingExpense = null;
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RevertPaymentAsync(Guid id)
    {
        if (_saving)
        {
            return;
        }

        _saving = true;

        try
        {
            await Executor.ExecuteAsync<RevertFixedExpensePaymentHandler, bool>(
                (handler, ct) => handler.ExecuteAsync(
                    new RevertFixedExpensePaymentCommand(id, _selectedMonth.Year, _selectedMonth.Month), ct),
                successMessage: "Pagamento revertido.",
                cancellationToken: ComponentCancellationToken);

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        if (_saving)
        {
            return;
        }

        _saving = true;

        try
        {
            var result = await Executor.ExecuteAsync<DeleteFixedExpenseHandler>(
                (handler, ct) => handler.ExecuteAsync(new DeleteFixedExpenseCommand(id), ct),
                successMessage: "Despesa fixa excluída.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _confirmDeleteId = null;
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string FormatPeriod(FixedExpenseDto expense)
    {
        var start = HearthFormat.ShortMonthYear(expense.StartYear, expense.StartMonth);
        var end = expense.EndYear.HasValue && expense.EndMonth.HasValue
            ? HearthFormat.ShortMonthYear(expense.EndYear.Value, expense.EndMonth.Value)
            : "Em aberto";

        return $"{start} — {end}";
    }

    private string GetCategoryName(Guid categoryId) =>
        _categoryNames.GetValueOrDefault(categoryId, "—");
}
