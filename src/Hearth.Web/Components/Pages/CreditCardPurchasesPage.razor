@page "/cartao/compras"
@attribute [Authorize]
@inherits AccountPageBase
@using Hearth.Application.Categories
@using Hearth.Application.Categories.ListCategories
@using Hearth.Application.CreditCards
@using Hearth.Application.CreditCards.GetActiveCreditCard
@using Hearth.Application.CreditCardPurchases
@using Hearth.Application.CreditCardPurchases.DeleteCreditCardPurchase
@using Hearth.Application.CreditCardPurchases.ListCreditCardPurchases
@using Hearth.Application.CreditCardPurchases.RegisterCreditCardPurchase
@using Hearth.Application.CreditCardPurchases.UpdateCreditCardPurchaseAmount
@using Hearth.Application.CreditCardPurchases.UpdateCreditCardPurchaseDate
@using Hearth.Application.CreditCardPurchases.UpdateCreditCardPurchaseDetails

<PageTitle>Compras no Cartão — Hearth</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap" Spacing="2">
    <MudText Typo="Typo.h4">Compras no Cartão</MudText>

    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.ReceiptLong"
                   Href="/cartao/faturas">
            Ver Faturas
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="StartCreate"
                   Disabled="_saving || ActiveCategories.Count == 0"
                   data-testid="new-purchase-button">
            Nova compra
        </MudButton>
    </MudStack>
</MudStack>

@if (_showCreateForm)
{
    <MudPaper Elevation="2" Class="pa-5 mb-4" data-testid="create-purchase-form">
        <MudText Typo="Typo.h6" GutterBottom="true">Nova compra no cartão</MudText>

        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_description"
                              Label="Descrição"
                              Variant="Variant.Outlined"
                              Required="true"
                              MaxLength="@DomainValidation.MaxDescriptionLength"
                              Counter="@DomainValidation.MaxDescriptionLength"
                              Immediate="true"
                              Disabled="_saving"
                              data-testid="purchase-description-input" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="Guid?"
                           @bind-Value="_categoryId"
                           Label="Categoria"
                           Variant="Variant.Outlined"
                           Required="true"
                           Disabled="_saving"
                           data-testid="purchase-category-select">
                    @foreach (var category in ActiveCategories)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)category.Id)">@category.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudNumericField T="decimal"
                                 @bind-Value="_amount"
                                 Label="Valor total"
                                 Variant="Variant.Outlined"
                                 Culture="@HearthFormat.PtBr"
                                 Format="N2"
                                 Adornment="Adornment.Start"
                                 AdornmentText="R$"
                                 HideSpinButtons="true"
                                 HelperText="Resto de centavos vai na última parcela."
                                 Disabled="_saving"
                                 data-testid="purchase-amount-input" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudDatePicker @bind-Date="_date"
                               Label="Data da compra"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy"
                               Culture="@HearthFormat.PtBr"
                               Editable="true"
                               Disabled="_saving"
                               data-testid="purchase-date-input" />
            </MudItem>

            <MudItem xs="6" sm="2">
                <MudNumericField T="int"
                                 @bind-Value="_installmentCount"
                                 Label="Parcelas"
                                 Variant="Variant.Outlined"
                                 Min="1"
                                 Max="120"
                                 Disabled="_saving"
                                 data-testid="purchase-installments-input" />
            </MudItem>

            <MudItem xs="6" sm="2">
                <MudNumericField T="int"
                                 @bind-Value="_initialInstallment"
                                 Label="Parcela inicial"
                                 Variant="Variant.Outlined"
                                 Min="1"
                                 Max="@Math.Max(1, _installmentCount)"
                                 HelperText="> 1: anteriores já pagas"
                                 Disabled="_saving"
                                 data-testid="purchase-initial-installment-input" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="PurchaseConditionKind"
                           @bind-Value="_conditionKind"
                           Label="Condição"
                           Variant="Variant.Outlined"
                           Disabled="_saving"
                           data-testid="purchase-condition-select">
                    <MudSelectItem T="PurchaseConditionKind" Value="PurchaseConditionKind.Own">Própria</MudSelectItem>
                    <MudSelectItem T="PurchaseConditionKind" Value="PurchaseConditionKind.Others">Outros</MudSelectItem>
                    <MudSelectItem T="PurchaseConditionKind" Value="PurchaseConditionKind.Custom">Personalizado</MudSelectItem>
                </MudSelect>
            </MudItem>

            @if (_conditionKind == PurchaseConditionKind.Custom)
            {
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_conditionName"
                                  Label="Nome da condição"
                                  Placeholder="Ex.: Mãe, Ana, Trabalho"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  MaxLength="@DomainValidation.MaxNameLength"
                                  Immediate="true"
                                  Disabled="_saving"
                                  data-testid="purchase-condition-name-input" />
                </MudItem>
            }

            <MudItem xs="12">
                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" OnClick="CancelPanels" Disabled="_saving">Cancelar</MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="CreateAsync"
                               Disabled="_saving || !CanSubmitCreate"
                               data-testid="create-purchase-submit">
                        @(_saving ? "Salvando..." : "Registrar compra")
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@if (_editingDetails is not null)
{
    <MudPaper Elevation="2" Class="pa-5 mb-4" data-testid="edit-purchase-details-panel">
        <MudText Typo="Typo.h6" GutterBottom="true">Editar detalhes — @_editingDetails.Description</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_editDescription"
                              Label="Descrição"
                              Variant="Variant.Outlined"
                              MaxLength="@DomainValidation.MaxDescriptionLength"
                              Immediate="true"
                              Disabled="_saving"
                              data-testid="edit-purchase-description-input" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid?" @bind-Value="_editCategoryId" Label="Categoria" Variant="Variant.Outlined" Disabled="_saving">
                    @foreach (var category in _allCategories.Where(c => !c.IsArchived || c.Id == _editingDetails.CategoryId))
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)category.Id)">
                            @(category.IsArchived ? $"{category.Name} (Arquivada)" : category.Name)
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="PurchaseConditionKind" @bind-Value="_editConditionKind" Label="Condição" Variant="Variant.Outlined" Disabled="_saving">
                    <MudSelectItem T="PurchaseConditionKind" Value="PurchaseConditionKind.Own">Própria</MudSelectItem>
                    <MudSelectItem T="PurchaseConditionKind" Value="PurchaseConditionKind.Others">Outros</MudSelectItem>
                    <MudSelectItem T="PurchaseConditionKind" Value="PurchaseConditionKind.Custom">Personalizado</MudSelectItem>
                </MudSelect>
            </MudItem>
            @if (_editConditionKind == PurchaseConditionKind.Custom)
            {
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_editConditionName"
                                  Label="Nome da condição"
                                  Variant="Variant.Outlined"
                                  MaxLength="@DomainValidation.MaxNameLength"
                                  Immediate="true"
                                  Disabled="_saving" />
                </MudItem>
            }
            <MudItem xs="12">
                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text" OnClick="CancelPanels" Disabled="_saving">Cancelar</MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="SaveDetailsAsync"
                               Disabled="_saving || string.IsNullOrWhiteSpace(_editDescription) || !_editCategoryId.HasValue || (_editConditionKind == PurchaseConditionKind.Custom && string.IsNullOrWhiteSpace(_editConditionName))"
                               data-testid="save-purchase-details">
                        Salvar detalhes
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@if (_editingAmount is not null)
{
    <MudPaper Elevation="2" Class="pa-5 mb-4" data-testid="edit-purchase-amount-panel">
        <MudText Typo="Typo.h6" GutterBottom="true">Alterar valor — @_editingAmount.Description</MudText>
        <MudGrid Spacing="3" Class="align-center">
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal"
                                 @bind-Value="_editNewAmount"
                                 Label="Novo valor total"
                                 Variant="Variant.Outlined"
                                 Culture="@HearthFormat.PtBr"
                                 Format="N2"
                                 Adornment="Adornment.Start"
                                 AdornmentText="R$"
                                 HideSpinButtons="true"
                                 Disabled="_saving"
                                 data-testid="edit-purchase-amount-input" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAmountAsync" Disabled="_saving || _editNewAmount <= 0" data-testid="save-purchase-amount">
                        Salvar valor
                    </MudButton>
                    <MudButton Variant="Variant.Text" OnClick="CancelPanels" Disabled="_saving">Cancelar</MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@if (_editingDate is not null)
{
    <MudPaper Elevation="2" Class="pa-5 mb-4" data-testid="edit-purchase-date-panel">
        <MudText Typo="Typo.h6" GutterBottom="true">Alterar data — @_editingDate.Description</MudText>
        <MudGrid Spacing="3" Class="align-center">
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_editNewDate"
                               Label="Nova data da compra"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy"
                               Culture="@HearthFormat.PtBr"
                               Editable="true"
                               Disabled="_saving"
                               data-testid="edit-purchase-date-input" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveDateAsync" Disabled="_saving || !_editNewDate.HasValue" data-testid="save-purchase-date">
                        Salvar data
                    </MudButton>
                    <MudButton Variant="Variant.Text" OnClick="CancelPanels" Disabled="_saving">Cancelar</MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Elevation="2" Class="pa-3 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mr-1">Condição:</MudText>

                <MudButton Size="Size.Small"
                           Variant="@(_conditionFilter is null ? Variant.Filled : Variant.Outlined)"
                           Color="@(_conditionFilter is null ? Color.Primary : Color.Default)"
                           OnClick="() => SetConditionFilter(null)"
                           data-testid="filter-condition-all">
                    Todas
                </MudButton>

                <MudButton Size="Size.Small"
                           Variant="@(IsSelectedFilter(PurchaseConditionKind.Own, null) ? Variant.Filled : Variant.Outlined)"
                           Color="@(IsSelectedFilter(PurchaseConditionKind.Own, null) ? Color.Primary : Color.Default)"
                           OnClick="() => SetConditionFilter((PurchaseConditionKind.Own, null))"
                           data-testid="filter-condition-own">
                    Própria
                </MudButton>

                <MudButton Size="Size.Small"
                           Variant="@(IsSelectedFilter(PurchaseConditionKind.Others, null) ? Variant.Filled : Variant.Outlined)"
                           Color="@(IsSelectedFilter(PurchaseConditionKind.Others, null) ? Color.Primary : Color.Default)"
                           OnClick="() => SetConditionFilter((PurchaseConditionKind.Others, null))"
                           data-testid="filter-condition-others">
                    Outros
                </MudButton>

                @foreach (var customName in DistinctCustomNames)
                {
                    var nameCopy = customName;
                    <MudButton Size="Size.Small"
                               Variant="@(IsSelectedFilter(PurchaseConditionKind.Custom, nameCopy) ? Variant.Filled : Variant.Outlined)"
                               Color="@(IsSelectedFilter(PurchaseConditionKind.Custom, nameCopy) ? Color.Primary : Color.Default)"
                               OnClick="() => SetConditionFilter((PurchaseConditionKind.Custom, nameCopy))"
                               data-testid="@($"filter-condition-custom-{nameCopy}")">
                        @nameCopy
                    </MudButton>
                }
            </MudStack>

            <MudText Typo="Typo.subtitle2">
                @FilteredPurchases.Count compra(s) — @HearthFormat.Money(FilteredPurchases.Sum(p => p.Amount))
            </MudText>
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="2">
        <MudTable Items="FilteredPurchases" Hover="true" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh Style="width: 110px;">Data</MudTh>
                <MudTh>Descrição</MudTh>
                <MudTh>Categoria</MudTh>
                <MudTh>Condição</MudTh>
                <MudTh>Parcelas</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align: right;">Valor total</MudTh>
                <MudTh Style="width: 260px; text-align: right;">Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Data">@HearthFormat.Date(context.Date)</MudTd>
                <MudTd DataLabel="Descrição">@context.Description</MudTd>
                <MudTd DataLabel="Categoria">@GetCategoryName(context.CategoryId)</MudTd>
                <MudTd DataLabel="Condição">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                        @HearthFormat.ConditionLabel(context.ConditionKind, context.ConditionName)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Parcelas">
                    @if (context.InitialInstallment > 1)
                    {
                        <span>@($"{context.InstallmentCount}x (início {context.InitialInstallment}/{context.InstallmentCount})")</span>
                    }
                    else
                    {
                        <span>@($"{context.InstallmentCount}x")</span>
                    }
                </MudTd>
                <MudTd DataLabel="Status">
                    @if (context.IsLocked)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                            Travada
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                            Aberta
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Valor total" Style="text-align: right; font-weight: 500;">
                    @HearthFormat.Money(context.Amount)
                </MudTd>
                <MudTd DataLabel="Ações" Style="text-align: right;">
                    @if (_confirmDeleteId == context.Id)
                    {
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Filled"
                                       Color="Color.Error"
                                       OnClick="() => DeleteAsync(context.Id)"
                                       Disabled="_saving"
                                       data-testid="@($"confirm-delete-purchase-{context.Id}")">
                                Confirmar
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _confirmDeleteId = null" Disabled="_saving">
                                Cancelar
                            </MudButton>
                        </MudStack>
                    }
                    else
                    {
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                            <MudIconButton Icon="@(_expandedPurchaseId == context.Id ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                           Size="Size.Small"
                                           title="Ver parcelas"
                                           OnClick="() => ToggleExpand(context.Id)"
                                           data-testid="@($"expand-purchase-{context.Id}")" />

                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           title="Editar detalhes"
                                           OnClick="() => StartEditDetails(context)"
                                           Disabled="_saving"
                                           data-testid="@($"edit-details-purchase-{context.Id}")" />

                            <MudIconButton Icon="@Icons.Material.Filled.AttachMoney"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           title="@(context.IsLocked ? "Valor travado após fechamento da 1ª parcela ativa" : "Alterar valor")"
                                           OnClick="() => StartEditAmount(context)"
                                           Disabled="_saving || context.IsLocked"
                                           data-testid="@($"edit-amount-purchase-{context.Id}")" />

                            <MudIconButton Icon="@Icons.Material.Filled.CalendarMonth"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           title="@(context.IsLocked ? "Data travada após fechamento da 1ª parcela ativa" : "Alterar data")"
                                           OnClick="() => StartEditDate(context)"
                                           Disabled="_saving || context.IsLocked"
                                           data-testid="@($"edit-date-purchase-{context.Id}")" />

                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           title="Excluir"
                                           OnClick="() => _confirmDeleteId = context.Id"
                                           Disabled="_saving"
                                           data-testid="@($"delete-purchase-{context.Id}")" />
                        </MudStack>
                    }
                </MudTd>
            </RowTemplate>
            <ChildRowContent>
                @if (_expandedPurchaseId == context.Id)
                {
                    <MudTr>
                        <td colspan="8" class="pa-3">
                            <MudText Typo="Typo.subtitle2" GutterBottom="true">Parcelas de "@context.Description"</MudText>
                            <MudSimpleTable Dense="true" Elevation="0">
                                <thead>
                                    <tr>
                                        <th>Parcela</th>
                                        <th>Ciclo (fechamento)</th>
                                        <th>Vencimento</th>
                                        <th>Situação</th>
                                        <th style="text-align: right;">Valor</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var installment in context.Installments)
                                    {
                                        <tr>
                                            <td>@($"{installment.Number}/{context.InstallmentCount}")</td>
                                            <td>@HearthFormat.ShortMonthYear(installment.ClosingYear, installment.ClosingMonth)</td>
                                            <td>@HearthFormat.Date(installment.DueDate)</td>
                                            <td>
                                                @if (installment.IsPreviouslyPaid)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                                        Já paga
                                                    </MudChip>
                                                }
                                                else
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                                        Na fatura
                                                    </MudChip>
                                                }
                                            </td>
                                            <td style="text-align: right;">@HearthFormat.Money(installment.Amount)</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </td>
                    </MudTr>
                }
            </ChildRowContent>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">
                    Nenhuma compra no cartão encontrada.
                </MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code
{
    [SupplyParameterFromQuery(Name = "nova")]
    public bool OpenNewOnLoad { get; set; }

    private IReadOnlyList<CreditCardPurchaseDto> _purchases = [];
    private IReadOnlyList<CategoryDto> _allCategories = [];
    private Dictionary<Guid, string> _categoryNames = [];
    private Guid? _activeCardId;

    private (PurchaseConditionKind Kind, string? Name)? _conditionFilter;
    private Guid? _expandedPurchaseId;
    private bool _loading = true;
    private bool _saving;

    private bool _showCreateForm;
    private string _description = string.Empty;
    private Guid? _categoryId;
    private decimal _amount;
    private DateTime? _date;
    private int _installmentCount = 1;
    private int _initialInstallment = 1;
    private PurchaseConditionKind _conditionKind = PurchaseConditionKind.Own;
    private string _conditionName = string.Empty;

    private CreditCardPurchaseDto? _editingDetails;
    private string _editDescription = string.Empty;
    private Guid? _editCategoryId;
    private PurchaseConditionKind _editConditionKind = PurchaseConditionKind.Own;
    private string _editConditionName = string.Empty;

    private CreditCardPurchaseDto? _editingAmount;
    private decimal _editNewAmount;

    private CreditCardPurchaseDto? _editingDate;
    private DateTime? _editNewDate;

    private Guid? _confirmDeleteId;

    private IReadOnlyList<CategoryDto> ActiveCategories =>
        _allCategories.Where(c => !c.IsArchived).ToList();

    private IReadOnlyList<string> DistinctCustomNames =>
        _purchases
            .Where(p => p.ConditionKind == PurchaseConditionKind.Custom && !string.IsNullOrWhiteSpace(p.ConditionName))
            .Select(p => p.ConditionName!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private IReadOnlyList<CreditCardPurchaseDto> FilteredPurchases =>
        _conditionFilter is null
            ? _purchases
            : _purchases.Where(MatchesFilter).ToList();

    private bool CanSubmitCreate =>
        _activeCardId.HasValue
        && !string.IsNullOrWhiteSpace(_description)
        && _categoryId.HasValue
        && _amount > 0
        && _date.HasValue
        && _installmentCount >= 1
        && _initialInstallment >= 1
        && _initialInstallment <= _installmentCount
        && (_conditionKind != PurchaseConditionKind.Custom || !string.IsNullOrWhiteSpace(_conditionName));

    protected override async Task LoadDataAsync(CancellationToken cancellationToken)
    {
        _loading = true;

        var cardResult = await Executor.ExecuteAsync<GetActiveCreditCardHandler, CreditCardDto?>(
            (handler, ct) => handler.ExecuteAsync(new GetActiveCreditCardQuery(AccountId), ct),
            cancellationToken: cancellationToken);

        var purchasesResult = await Executor.ExecuteAsync<ListCreditCardPurchasesHandler, IReadOnlyList<CreditCardPurchaseDto>>(
            (handler, ct) => handler.ExecuteAsync(new ListCreditCardPurchasesQuery(AccountId), ct),
            cancellationToken: cancellationToken);

        var categoriesResult = await Executor.ExecuteAsync<ListCategoriesHandler, IReadOnlyList<CategoryDto>>(
            (handler, ct) => handler.ExecuteAsync(new ListCategoriesQuery(IncludeArchived: true), ct),
            cancellationToken: cancellationToken);

        if (cardResult.IsSuccess)
        {
            _activeCardId = cardResult.Value?.Id;
        }

        if (purchasesResult.IsSuccess && purchasesResult.Value is not null)
        {
            _purchases = purchasesResult.Value;
        }

        if (categoriesResult.IsSuccess && categoriesResult.Value is not null)
        {
            _allCategories = categoriesResult.Value;
            _categoryNames = _allCategories.ToDictionary(c => c.Id, c => c.Name);
        }

        if (OpenNewOnLoad && !_showCreateForm && ActiveCategories.Count > 0)
        {
            OpenNewOnLoad = false;
            StartCreate();
        }

        _loading = false;
    }

    private void SetConditionFilter((PurchaseConditionKind Kind, string? Name)? filter) =>
        _conditionFilter = filter;

    private bool IsSelectedFilter(PurchaseConditionKind kind, string? name) =>
        _conditionFilter.HasValue
        && _conditionFilter.Value.Kind == kind
        && string.Equals(_conditionFilter.Value.Name, name, StringComparison.OrdinalIgnoreCase);

    private bool MatchesFilter(CreditCardPurchaseDto purchase)
    {
        if (!_conditionFilter.HasValue)
        {
            return true;
        }

        var (kind, name) = _conditionFilter.Value;
        return kind == PurchaseConditionKind.Custom
            ? purchase.ConditionKind == PurchaseConditionKind.Custom
              && string.Equals(purchase.ConditionName, name, StringComparison.OrdinalIgnoreCase)
            : purchase.ConditionKind == kind;
    }

    private void ToggleExpand(Guid purchaseId) =>
        _expandedPurchaseId = _expandedPurchaseId == purchaseId ? null : purchaseId;

    private void CancelPanels()
    {
        _showCreateForm = false;
        _editingDetails = null;
        _editingAmount = null;
        _editingDate = null;
        _confirmDeleteId = null;
    }

    private void StartCreate()
    {
        CancelPanels();
        _description = string.Empty;
        _categoryId = ActiveCategories.FirstOrDefault()?.Id;
        _amount = 0m;
        _date = HearthFormat.ToDateTime(Clock.Today);
        _installmentCount = 1;
        _initialInstallment = 1;
        _conditionKind = PurchaseConditionKind.Own;
        _conditionName = string.Empty;
        _showCreateForm = true;
    }

    private async Task CreateAsync()
    {
        if (_saving || !CanSubmitCreate)
        {
            return;
        }

        _saving = true;

        try
        {
            var command = new RegisterCreditCardPurchaseCommand(
                AccountId,
                _activeCardId!.Value,
                HearthFormat.ToDateOnly(_date!.Value),
                _amount,
                _installmentCount,
                _initialInstallment,
                _conditionKind,
                _conditionKind == PurchaseConditionKind.Custom ? _conditionName.Trim() : null,
                _description.Trim(),
                _categoryId!.Value);

            var result = await Executor.ExecuteAsync<RegisterCreditCardPurchaseHandler, Guid>(
                (handler, ct) => handler.ExecuteAsync(command, ct),
                successMessage: "Compra no cartão registrada.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _showCreateForm = false;
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartEditDetails(CreditCardPurchaseDto purchase)
    {
        CancelPanels();
        _editingDetails = purchase;
        _editDescription = purchase.Description;
        _editCategoryId = purchase.CategoryId;
        _editConditionKind = purchase.ConditionKind;
        _editConditionName = purchase.ConditionName ?? string.Empty;
    }

    private async Task SaveDetailsAsync()
    {
        if (_saving || _editingDetails is null || string.IsNullOrWhiteSpace(_editDescription) || !_editCategoryId.HasValue)
        {
            return;
        }

        _saving = true;

        try
        {
            var command = new UpdateCreditCardPurchaseDetailsCommand(
                _editingDetails.Id,
                _editDescription.Trim(),
                _editCategoryId.Value,
                _editConditionKind,
                _editConditionKind == PurchaseConditionKind.Custom ? _editConditionName.Trim() : null);

            var result = await Executor.ExecuteAsync<UpdateCreditCardPurchaseDetailsHandler>(
                (handler, ct) => handler.ExecuteAsync(command, ct),
                successMessage: "Detalhes da compra atualizados.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _editingDetails = null;
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartEditAmount(CreditCardPurchaseDto purchase)
    {
        CancelPanels();
        _editingAmount = purchase;
        _editNewAmount = purchase.Amount;
    }

    private async Task SaveAmountAsync()
    {
        if (_saving || _editingAmount is null || _editNewAmount <= 0)
        {
            return;
        }

        _saving = true;

        try
        {
            var id = _editingAmount.Id;
            var result = await Executor.ExecuteAsync<UpdateCreditCardPurchaseAmountHandler>(
                (handler, ct) => handler.ExecuteAsync(new UpdateCreditCardPurchaseAmountCommand(id, _editNewAmount), ct),
                successMessage: "Valor da compra atualizado.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _editingAmount = null;
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartEditDate(CreditCardPurchaseDto purchase)
    {
        CancelPanels();
        _editingDate = purchase;
        _editNewDate = HearthFormat.ToDateTime(purchase.Date);
    }

    private async Task SaveDateAsync()
    {
        if (_saving || _editingDate is null || !_editNewDate.HasValue)
        {
            return;
        }

        _saving = true;

        try
        {
            var id = _editingDate.Id;
            var newDate = HearthFormat.ToDateOnly(_editNewDate.Value);
            var result = await Executor.ExecuteAsync<UpdateCreditCardPurchaseDateHandler>(
                (handler, ct) => handler.ExecuteAsync(new UpdateCreditCardPurchaseDateCommand(id, newDate), ct),
                successMessage: "Data da compra atualizada.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _editingDate = null;
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(Guid purchaseId)
    {
        if (_saving)
        {
            return;
        }

        _saving = true;

        try
        {
            var result = await Executor.ExecuteAsync<DeleteCreditCardPurchaseHandler>(
                (handler, ct) => handler.ExecuteAsync(new DeleteCreditCardPurchaseCommand(purchaseId), ct),
                successMessage: "Compra excluída.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _confirmDeleteId = null;
                if (_expandedPurchaseId == purchaseId)
                {
                    _expandedPurchaseId = null;
                }
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private string GetCategoryName(Guid categoryId) =>
        _categoryNames.GetValueOrDefault(categoryId, "—");
}
