@page "/Error"
@layout AuthLayout
@attribute [AllowAnonymous]
@using System.Diagnostics

<div class="hearth-auth-heading">
    <h1 class="hearth-auth-title">Algo deu errado</h1>
    <p class="hearth-auth-subtitle">
        Não foi possível processar esta solicitação no momento.
    </p>
</div>

@if (ShowRequestId)
{
    <p class="hearth-auth-help mb-4">
        Código da solicitação: <code class="hearth-money">@RequestId</code>
    </p>
}

<a href="/" class="hearth-auth-submit" style="text-decoration: none;">
    Voltar para o Painel
</a>

@code
{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
