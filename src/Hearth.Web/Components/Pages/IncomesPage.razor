@page "/receitas"
@attribute [Authorize]
@inherits AccountPageBase
@using Hearth.Application.Incomes
@using Hearth.Application.Incomes.DeleteIncome
@using Hearth.Application.Incomes.ListIncomes
@using Hearth.Application.Incomes.MarkIncomeAsReceived
@using Hearth.Application.Incomes.RegisterIncome
@using Hearth.Application.Incomes.RevertIncomeToExpected
@using Hearth.Application.Incomes.UpdateIncome
@using Hearth.Application.PurchaseConditions
@using Hearth.Application.PurchaseConditions.ListPurchaseConditions
@using Hearth.Web.Components.Shared

<PageTitle>Receitas — Hearth Finance</PageTitle>

<div class="hearth-page">
    <PageHeader Title="Receitas"
                Subtitle="Entradas previstas e recebimentos confirmados no saldo de caixa.">
        <Actions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="hearth-btn-clean"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="StartCreate"
                       Disabled="_saving"
                       data-testid="new-income-button">
                Nova receita
            </MudButton>
        </Actions>
    </PageHeader>

    <div class="hearth-command-bar">
        <div class="hearth-command-controls">
            @if (!_showAllMonths)
            {
                <MonthNavigator Month="_selectedMonth" MinMonth="TrackingStartPeriod" MonthChanged="OnMonthChanged" Disabled="_saving" />
            }

            <MudSwitch T="bool" @bind-Value="_showAllMonths" Color="Color.Primary" Label="Todos os meses" />
        </div>

        @if (!_loading)
        {
            <div class="hearth-summary-metrics hearth-money">
                <span class="hearth-summary-metric">@FilteredIncomes.Count receita(s)</span>
                <span class="hearth-summary-metric">
                    Previsto: <strong>@HearthFormat.Money(FilteredIncomes.Sum(i => i.Amount))</strong>
                </span>
                <span class="hearth-summary-metric is-positive">
                    Recebido: <strong>@HearthFormat.Money(FilteredIncomes.Where(i => i.IsReceived).Sum(i => i.Amount))</strong>
                </span>
            </div>
        }
    </div>

    @if (_showForm)
    {
        <section class="hearth-form-panel" data-testid="income-form">
            <h2 class="hearth-card-title">
                @(_editingId.HasValue ? "Editar receita" : "Nova receita")
            </h2>

            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_description"
                                  Label="Descrição"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  MaxLength="@DomainValidation.MaxDescriptionLength"
                                  Counter="@DomainValidation.MaxDescriptionLength"
                                  Immediate="true"
                                  Disabled="_saving"
                                  data-testid="income-description-input" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_amount"
                                     Label="Valor"
                                     Variant="Variant.Outlined"
                                     Culture="@HearthFormat.PtBr"
                                     Format="N2"
                                     Adornment="Adornment.Start"
                                     AdornmentText="R$"
                                     HideSpinButtons="true"
                                     Disabled="_saving"
                                     data-testid="income-amount-input" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_expectedDate"
                                   Label="Data prevista"
                                   Variant="Variant.Outlined"
                                   DateFormat="dd/MM/yyyy"
                                   Culture="@HearthFormat.PtBr"
                                   Editable="true"
                                   Disabled="_saving"
                                   data-testid="income-expected-date-input" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid"
                               @bind-Value="_conditionId"
                               Label="Condição"
                               Variant="Variant.Outlined"
                               HelperText="Própria = sua renda pessoal; outras condições = reembolsos/repasses de terceiros."
                               Disabled="_saving"
                               data-testid="income-condition-select">
                        @foreach (var condition in AvailableConditionsForForm)
                        {
                            <MudSelectItem T="Guid" Value="@condition.Id">
                                @(condition.IsArchived ? $"{condition.Name} (Arquivada)" : condition.Name)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @if (!_editingId.HasValue)
                {
                    <MudItem xs="12" sm="6" Class="d-flex align-center">
                        <MudSwitch T="bool"
                                   @bind-Value="_alreadyReceived"
                                   Color="Color.Success"
                                   Label="Já foi recebida?"
                                   Disabled="_saving" />
                    </MudItem>

                    @if (_alreadyReceived)
                    {
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="_receivedOn"
                                           Label="Data de recebimento"
                                           Variant="Variant.Outlined"
                                           DateFormat="dd/MM/yyyy"
                                           Culture="@HearthFormat.PtBr"
                                           Editable="true"
                                           Disabled="_saving"
                                           data-testid="income-received-date-input" />
                        </MudItem>
                    }
                }

                <MudItem xs="12">
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                        <MudButton Variant="Variant.Text" OnClick="CloseForm" Disabled="_saving">Cancelar</MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Class="hearth-btn-clean"
                                   OnClick="SaveAsync"
                                   Disabled="_saving || string.IsNullOrWhiteSpace(_description) || _amount <= 0 || !_expectedDate.HasValue || (_alreadyReceived && !_receivedOn.HasValue)"
                                   data-testid="save-income">
                            @(_saving ? "Salvando…" : "Salvar")
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </section>
    }

    @if (_receivingIncome is not null)
    {
        <section class="hearth-form-panel" data-testid="receive-income-panel">
            <h2 class="hearth-card-title">
                Confirmar recebimento — @_receivingIncome.Description (@HearthFormat.Money(_receivingIncome.Amount))
            </h2>
            <MudGrid Spacing="3" Class="align-center">
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_receiveDate"
                                   Label="Data de recebimento"
                                   Variant="Variant.Outlined"
                                   DateFormat="dd/MM/yyyy"
                                   Culture="@HearthFormat.PtBr"
                                   Editable="true"
                                   Disabled="_saving"
                                   data-testid="confirm-receive-date-input" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Class="hearth-btn-clean"
                                   OnClick="ConfirmReceiveAsync"
                                   Disabled="_saving || !_receiveDate.HasValue"
                                   data-testid="confirm-receive-submit">
                            Confirmar recebimento
                        </MudButton>
                        <MudButton Variant="Variant.Text" OnClick="() => _receivingIncome = null" Disabled="_saving">
                            Cancelar
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </section>
    }

    @if (_loading)
    {
        <div class="hearth-card hearth-skeleton-panel"></div>
    }
    else
    {
        <section class="hearth-table-shell" aria-label="Lista de receitas">
            <MudTable Items="FilteredIncomes" Hover="true" Dense="true" Elevation="0" Class="hearth-data-table">
                <HeaderContent>
                    <MudTh Style="width: 120px;">Data prevista</MudTh>
                    <MudTh>Descrição</MudTh>
                    <MudTh Style="width: 130px;">Condição</MudTh>
                    <MudTh Style="width: 200px;">Status</MudTh>
                    <MudTh Style="width: 150px; text-align: right;">Valor</MudTh>
                    <MudTh Style="width: 156px; text-align: right;">Ações</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Data prevista" Class="hearth-money hearth-cell-muted">@HearthFormat.Date(context.ExpectedDate)</MudTd>
                    <MudTd DataLabel="Descrição" Class="hearth-cell-title">@context.Description</MudTd>
                    <MudTd DataLabel="Condição">
                        <span class="hearth-condition-chip">@GetConditionName(context.ConditionId)</span>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        @if (context.IsReceived)
                        {
                            <span class="hearth-status-pill is-positive hearth-money">
                                Recebida em @HearthFormat.Date(context.ReceivedOn)
                            </span>
                        }
                        else
                        {
                            <span class="hearth-status-pill is-warning">Prevista</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Valor" Class="hearth-cell-amount">
                        @HearthFormat.Money(context.Amount)
                    </MudTd>
                    <MudTd DataLabel="Ações" Style="text-align: right;">
                        @if (_confirmDeleteId == context.Id)
                        {
                            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Filled"
                                           Color="Color.Error"
                                           OnClick="() => DeleteAsync(context.Id)"
                                           Disabled="_saving"
                                           data-testid="@($"confirm-delete-income-{context.Id}")">
                                    Confirmar
                                </MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _confirmDeleteId = null" Disabled="_saving">
                                    Cancelar
                                </MudButton>
                            </MudStack>
                        }
                        else
                        {
                            <div class="hearth-row-actions">
                                @if (context.IsReceived)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Undo"
                                                   Size="Size.Small"
                                                   Class="hearth-action-btn is-warning"
                                                   title="Reverter para prevista"
                                                   aria-label="Reverter para prevista"
                                                   OnClick="() => RevertToExpectedAsync(context.Id)"
                                                   Disabled="_saving"
                                                   data-testid="@($"revert-income-{context.Id}")" />
                                }
                                else
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                                   Size="Size.Small"
                                                   Class="hearth-action-btn is-positive"
                                                   title="Marcar como recebida"
                                                   aria-label="Marcar como recebida"
                                                   OnClick="() => StartReceive(context)"
                                                   Disabled="_saving"
                                                   data-testid="@($"receive-income-{context.Id}")" />
                                }

                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Class="hearth-action-btn"
                                               title="Editar receita"
                                               aria-label="Editar receita"
                                               OnClick="() => StartEdit(context)"
                                               Disabled="_saving"
                                               data-testid="@($"edit-income-{context.Id}")" />

                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Class="hearth-action-btn is-danger"
                                               title="Excluir receita"
                                               aria-label="Excluir receita"
                                               OnClick="() => _confirmDeleteId = context.Id"
                                               Disabled="_saving"
                                               data-testid="@($"delete-income-{context.Id}")" />
                            </div>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Compact="true"
                                CssClass="ma-4"
                                Title="Nenhuma receita neste período"
                                Description="Navegue para outro mês ou registre uma nova entrada acima." />
                </NoRecordsContent>
            </MudTable>
        </section>
    }
</div>

@code
{
    private IReadOnlyList<IncomeDto> _incomes = [];
    private IReadOnlyList<PurchaseConditionDto> _allConditions = [];
    private Dictionary<Guid, string> _conditionNames = [];
    private YearMonth _selectedMonth = YearMonth.Of(2026, 1);
    private bool _showAllMonths;
    private bool _loading = true;
    private bool _saving;

    private bool _showForm;
    private Guid? _editingId;
    private Guid? _editingOriginalConditionId;
    private string _description = string.Empty;
    private decimal _amount;
    private DateTime? _expectedDate;
    private Guid _conditionId = SystemPurchaseConditions.OwnId;
    private bool _alreadyReceived;
    private DateTime? _receivedOn;

    private IncomeDto? _receivingIncome;
    private DateTime? _receiveDate;
    private Guid? _confirmDeleteId;

    private IReadOnlyList<PurchaseConditionDto> AvailableConditionsForForm =>
        _allConditions
            .Where(condition => !condition.IsArchived || condition.Id == _editingOriginalConditionId)
            .ToList();

    private IReadOnlyList<IncomeDto> FilteredIncomes =>
        _showAllMonths
            ? _incomes
            : _incomes
                .Where(item => item.ExpectedDate.Year == _selectedMonth.Year && item.ExpectedDate.Month == _selectedMonth.Month)
                .ToList();

    protected override void OnInitialized()
    {
        _selectedMonth = YearMonth.From(Clock.Today);
    }

    protected override async Task LoadDataAsync(CancellationToken cancellationToken)
    {
        _loading = true;

        var result = await Executor.ExecuteAsync<ListIncomesHandler, IReadOnlyList<IncomeDto>>(
            (handler, ct) => handler.ExecuteAsync(new ListIncomesQuery(AccountId), ct),
            cancellationToken: cancellationToken);

        var conditionsResult = await Executor.ExecuteAsync<ListPurchaseConditionsHandler, IReadOnlyList<PurchaseConditionDto>>(
            (handler, ct) => handler.ExecuteAsync(new ListPurchaseConditionsQuery(IncludeArchived: true), ct),
            cancellationToken: cancellationToken);

        if (result.IsSuccess && result.Value is not null)
        {
            _incomes = result.Value;
        }

        if (conditionsResult.IsSuccess && conditionsResult.Value is not null)
        {
            _allConditions = conditionsResult.Value;
            _conditionNames = _allConditions.ToDictionary(c => c.Id, c => c.Name);
        }

        _loading = false;
    }

    private void OnMonthChanged(YearMonth month) =>
        _selectedMonth = month;

    private void StartCreate()
    {
        _receivingIncome = null;
        _confirmDeleteId = null;
        _editingId = null;
        _editingOriginalConditionId = null;
        _description = string.Empty;
        _amount = 0m;
        _expectedDate = HearthFormat.ToDateTime(Clock.Today);
        _conditionId = SystemPurchaseConditions.OwnId;
        _alreadyReceived = false;
        _receivedOn = HearthFormat.ToDateTime(Clock.Today);
        _showForm = true;
    }

    private void StartEdit(IncomeDto income)
    {
        _receivingIncome = null;
        _confirmDeleteId = null;
        _editingId = income.Id;
        _editingOriginalConditionId = income.ConditionId;
        _description = income.Description;
        _amount = income.Amount;
        _expectedDate = HearthFormat.ToDateTime(income.ExpectedDate);
        _conditionId = income.ConditionId;
        _alreadyReceived = false;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _editingId = null;
        _editingOriginalConditionId = null;
    }

    private async Task SaveAsync()
    {
        if (_saving || string.IsNullOrWhiteSpace(_description) || _amount <= 0 || !_expectedDate.HasValue)
        {
            return;
        }

        _saving = true;

        try
        {
            var expectedDate = HearthFormat.ToDateOnly(_expectedDate.Value);

            if (_editingId.HasValue)
            {
                var id = _editingId.Value;
                var result = await Executor.ExecuteAsync<UpdateIncomeHandler>(
                    (handler, ct) => handler.ExecuteAsync(
                        new UpdateIncomeCommand(id, expectedDate, _amount, _description.Trim(), _conditionId), ct),
                    successMessage: "Receita atualizada.",
                    cancellationToken: ComponentCancellationToken);

                if (result.IsSuccess)
                {
                    CloseForm();
                }
            }
            else
            {
                DateOnly? received = _alreadyReceived && _receivedOn.HasValue
                    ? HearthFormat.ToDateOnly(_receivedOn.Value)
                    : null;

                var result = await Executor.ExecuteAsync<RegisterIncomeHandler, Guid>(
                    (handler, ct) => handler.ExecuteAsync(
                        new RegisterIncomeCommand(AccountId, expectedDate, _amount, _description.Trim(), received, _conditionId), ct),
                    successMessage: "Receita registrada.",
                    cancellationToken: ComponentCancellationToken);

                if (result.IsSuccess)
                {
                    CloseForm();
                }
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private string GetConditionName(Guid conditionId) =>
        _conditionNames.GetValueOrDefault(conditionId, "Própria");

    private void StartReceive(IncomeDto income)
    {
        _showForm = false;
        _confirmDeleteId = null;
        _receivingIncome = income;
        _receiveDate = HearthFormat.ToDateTime(Clock.Today);
    }

    private async Task ConfirmReceiveAsync()
    {
        if (_saving || _receivingIncome is null || !_receiveDate.HasValue)
        {
            return;
        }

        _saving = true;

        try
        {
            var incomeId = _receivingIncome.Id;
            var receivedOn = HearthFormat.ToDateOnly(_receiveDate.Value);

            var result = await Executor.ExecuteAsync<MarkIncomeAsReceivedHandler, bool>(
                (handler, ct) => handler.ExecuteAsync(new MarkIncomeAsReceivedCommand(incomeId, receivedOn), ct),
                successMessage: "Receita marcada como recebida.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _receivingIncome = null;
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RevertToExpectedAsync(Guid incomeId)
    {
        if (_saving)
        {
            return;
        }

        _saving = true;

        try
        {
            await Executor.ExecuteAsync<RevertIncomeToExpectedHandler, bool>(
                (handler, ct) => handler.ExecuteAsync(new RevertIncomeToExpectedCommand(incomeId), ct),
                successMessage: "Receita revertida para prevista.",
                cancellationToken: ComponentCancellationToken);

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(Guid incomeId)
    {
        if (_saving)
        {
            return;
        }

        _saving = true;

        try
        {
            var result = await Executor.ExecuteAsync<DeleteIncomeHandler>(
                (handler, ct) => handler.ExecuteAsync(new DeleteIncomeCommand(incomeId), ct),
                successMessage: "Receita excluída.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _confirmDeleteId = null;
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }
}
