@page "/"
@attribute [Authorize]
@inherits AccountPageBase
@using Hearth.Application.Accounts.DeleteBalanceAdjustment
@using Hearth.Application.Accounts.SetAccountBalance
@using Hearth.Application.PurchaseConditions
@using Hearth.Application.PurchaseConditions.ListPurchaseConditions
@using Hearth.Application.Reports.GetMonthlyDashboard
@using Hearth.Domain.ValueObjects
@using Hearth.Web.Models

<div class="hearth-dash">
    @* Content Header: Painel do Mês + simple chart icon badge + Month Selector *@
    <PageHeader Title="Painel do Mês"
                Subtitle="@($"Seu panorama financeiro para {HearthFormat.MonthYear(_selectedMonth)}.")">
        <Icon>
            <svg viewBox="0 0 20 20" fill="none">
                <path d="M4.5 14.5V10.5M9.5 14.5V6.5M14.5 14.5V4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
        </Icon>
        <Actions>
            <div class="hearth-dash-period-controls">
                <MonthNavigator Month="_selectedMonth" MinMonth="TrackingStartPeriod" MonthChanged="OnMonthChangedAsync" Disabled="_loading" />
                <MudDatePicker Date="HearthFormat.ToDateTime(_realBalanceUntil)"
                               DateChanged="OnRealBalanceDateChangedAsync"
                               MinDate="TrackingStartDate.HasValue ? HearthFormat.ToDateTime(TrackingStartDate.Value) : null"
                               MaxDate="HearthFormat.ToDateTime(Clock.Today)"
                               DateFormat="dd/MM/yyyy"
                               Culture="@HearthFormat.PtBr"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Editable="true"
                               Disabled="_loading"
                               Class="hearth-date-picker hearth-dash-date-picker"
                               aria-label="Data de referência do saldo"
                               data-testid="real-balance-date-input" />
                @if (_realBalanceUntil != Clock.Today)
                {
                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Class="hearth-today-btn"
                               Disabled="_loading"
                               OnClick="ResetRealBalanceDateAsync"
                               data-testid="real-balance-today-button">
                        Hoje
                    </MudButton>
                }
            </div>
        </Actions>
    </PageHeader>

    @* Command Bar: Condição filter chips + single "+ Novo lançamento ▾" CTA *@
    <div class="hearth-dash-command-bar">
        <div class="hearth-condition-bar" role="group" aria-label="Filtrar painel por condição">
            <span class="hearth-condition-label">Condição:</span>

            <div class="hearth-condition-pill-row">
                <button type="button"
                        class="hearth-cond-pill @(_selectedConditionId is null ? "is-active" : null)"
                        aria-pressed="@(_selectedConditionId is null ? "true" : "false")"
                        @onclick="() => OnConditionFilterChangedAsync(null)"
                        data-testid="dashboard-condition-all">
                    Todas
                </button>

                @foreach (var condition in GetVisibleConditions())
                {
                    var conditionId = condition.Id;
                    var isConditionActive = _selectedConditionId == conditionId;
                    <button type="button"
                            class="hearth-cond-pill @(isConditionActive ? "is-active" : null)"
                            aria-pressed="@(isConditionActive ? "true" : "false")"
                            @onclick="() => OnConditionFilterChangedAsync(conditionId)"
                            data-testid="@GetConditionTestId(condition)">
                        @condition.Name
                    </button>
                }

                @{
                    var overflowConditions = GetOverflowConditions();
                }
                @if (overflowConditions.Count > 0)
                {
                    <div class="hearth-condition-overflow">
                        <button type="button"
                                class="hearth-cond-pill hearth-cond-pill--overflow @(_overflowOpen ? "is-open" : null)"
                                aria-expanded="@(_overflowOpen ? "true" : "false")"
                                aria-haspopup="menu"
                                aria-label="@($"Mostrar mais {overflowConditions.Count} condições")"
                                @onclick="ToggleConditionOverflow"
                                data-testid="dashboard-condition-overflow-button">
                            +@overflowConditions.Count
                        </button>

                        @if (_overflowOpen)
                        {
                            <div class="hearth-condition-popover" role="menu" data-testid="dashboard-condition-overflow-menu">
                                @foreach (var hidden in overflowConditions)
                                {
                                    var hiddenId = hidden.Id;
                                    <button type="button"
                                            role="menuitem"
                                            class="hearth-condition-popover-item"
                                            @onclick="() => SelectOverflowConditionAsync(hiddenId)"
                                            data-testid="@GetConditionTestId(hidden)">
                                        @hidden.Name
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <nav class="hearth-quick-launch" aria-label="Atalhos de lançamento">
            <button type="button"
                    class="hearth-quick-launch-trigger @(_quickLaunchOpen ? "is-open" : null)"
                    aria-expanded="@(_quickLaunchOpen ? "true" : "false")"
                    aria-haspopup="menu"
                    @onclick="ToggleQuickLaunchMenu"
                    data-testid="quick-launch-trigger">
                <span>+ Novo lançamento</span>
                <svg class="hearth-quick-launch-caret" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                    <path d="M6 8L10 12L14 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>

            <div class="hearth-quick-launch-menu"
                 role="menu"
                 hidden="@(!_quickLaunchOpen)"
                 aria-hidden="@(!_quickLaunchOpen ? "true" : "false")"
                 data-testid="quick-launch-menu">
                <a href="/gastos-diretos" role="menuitem" class="hearth-quick-launch-item" @onclick="CloseQuickLaunchMenu" data-testid="quick-launch-direct">
                    <svg class="hearth-quick-action-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M10 4.5V15.5M4.5 10H15.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                    <span class="hearth-quick-launch-item-copy">
                        <span class="hearth-quick-launch-item-title">Gasto direto</span>
                        <span class="hearth-quick-launch-item-desc">Pix, débito ou saída à vista</span>
                    </span>
                </a>
                <a href="/cartao?aba=compras" role="menuitem" class="hearth-quick-launch-item" @onclick="CloseQuickLaunchMenu" data-testid="quick-action-card-purchase">
                    <svg class="hearth-quick-action-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <rect x="2.5" y="4.5" width="15" height="11" rx="2" stroke="currentColor" stroke-width="1.6" />
                        <path d="M2.5 8.2H17.5" stroke="currentColor" stroke-width="1.6" />
                    </svg>
                    <span class="hearth-quick-launch-item-copy">
                        <span class="hearth-quick-launch-item-title">Compra no cartão</span>
                        <span class="hearth-quick-launch-item-desc">À vista ou parcelada na fatura</span>
                    </span>
                </a>
                <a href="/receitas" role="menuitem" class="hearth-quick-launch-item" @onclick="CloseQuickLaunchMenu" data-testid="quick-launch-income">
                    <svg class="hearth-quick-action-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M3.5 14L8 9.5L11.2 12.5L16.5 6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M12.8 6.5H16.5V10.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="hearth-quick-launch-item-copy">
                        <span class="hearth-quick-launch-item-title">Receita</span>
                        <span class="hearth-quick-launch-item-desc">Entrada prevista ou já recebida</span>
                    </span>
                </a>
                <a href="/despesas-fixas" role="menuitem" class="hearth-quick-launch-item" @onclick="CloseQuickLaunchMenu" data-testid="quick-launch-fixed">
                    <svg class="hearth-quick-action-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <rect x="3" y="4.5" width="14" height="12.5" rx="2" stroke="currentColor" stroke-width="1.6" />
                        <path d="M6.5 3V6M13.5 3V6M3 8.5H17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                    <span class="hearth-quick-launch-item-copy">
                        <span class="hearth-quick-launch-item-title">Despesa fixa</span>
                        <span class="hearth-quick-launch-item-desc">Assinatura ou conta recorrente</span>
                    </span>
                </a>
            </div>
        </nav>
    </div>

    @if (_loading && _dashboard is null)
    {
        <div class="hearth-dash-skeleton" aria-busy="true" aria-label="Carregando painel financeiro">
            <div class="hearth-hub-row1">
                <div class="hearth-card hearth-skeleton-panel hearth-skeleton-panel--compact"></div>
                <div class="hearth-card hearth-skeleton-panel hearth-skeleton-panel--compact"></div>
                <div class="hearth-card hearth-skeleton-panel hearth-skeleton-panel--compact"></div>
                <div class="hearth-card hearth-skeleton-panel hearth-skeleton-panel--compact"></div>
            </div>
            <div class="hearth-hub-row2">
                <div class="hearth-card hearth-skeleton-panel"></div>
                <div class="hearth-card hearth-skeleton-panel"></div>
            </div>
            <div class="hearth-hub-row3">
                <div class="hearth-card hearth-skeleton-panel"></div>
                <div class="hearth-card hearth-skeleton-panel"></div>
                <div class="hearth-card hearth-skeleton-panel"></div>
            </div>
        </div>
    }
    else if (_dashboard is not null)
    {
        var balance = _dashboard.Balance;
        var invoice = _dashboard.CurrentInvoice;
        var flow = _dashboard.CurrentMonthFlow;
        var nextMonth = _dashboard.NextMonthEstimate;

        @* ROW 1 — 4 Equal-Height Columns (Decision & Hub) *@
        <div class="hearth-hub-row1" data-testid="dashboard-row-1">
            @* 1. SALDO (Real Cash Balance) *@
            <section class="hearth-card hearth-kpi-card" aria-labelledby="heading-balance" data-testid="dashboard-balance-card">
                <div class="hearth-kpi-card-head">
                    <h2 id="heading-balance" class="hearth-kpi-card-label">SALDO</h2>
                    <span class="hearth-neutral-icon" aria-hidden="true">
                        <svg viewBox="0 0 20 20" fill="none">
                            <rect x="2.5" y="4.5" width="15" height="11" rx="2.5" stroke="currentColor" stroke-width="1.5" />
                            <path d="M13 10H17.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            <circle cx="13.5" cy="10" r="1" fill="currentColor" />
                        </svg>
                    </span>
                </div>

                <p class="hearth-kpi-card-value hearth-money @(balance.Amount < 0m ? "is-danger" : "is-primary")"
                   data-testid="real-balance-value">
                    @HearthFormat.Money(balance.Amount)
                </p>

                <div class="hearth-kpi-card-meta">
                    <span class="hearth-kpi-caption-line">Posição em @HearthFormat.Date(balance.AsOfDate)</span>
                    @if (_selectedConditionId.HasValue)
                    {
                        <span class="hearth-kpi-unfiltered-note" data-testid="real-balance-unfiltered-note">
                            Não afetado pelo filtro de condição
                        </span>
                    }
                </div>

                <div class="hearth-kpi-card-actions">
                    <button type="button"
                            class="hearth-inline-text-btn @(_activeRow1Panel == Row1Panel.BalanceComposition ? "is-active" : null)"
                            aria-expanded="@(_activeRow1Panel == Row1Panel.BalanceComposition ? "true" : "false")"
                            @onclick="ToggleBalanceComposition"
                            data-testid="toggle-real-balance-details">
                        @(_activeRow1Panel == Row1Panel.BalanceComposition ? "Ocultar composição" : "Ver composição")
                    </button>
                    <button type="button"
                            class="hearth-inline-text-btn @(_activeRow1Panel == Row1Panel.SetBalance ? "is-active" : null)"
                            aria-expanded="@(_activeRow1Panel == Row1Panel.SetBalance ? "true" : "false")"
                            @onclick="StartSetBalance"
                            data-testid="set-balance-button">
                        Saldo inicial
                    </button>
                </div>
            </section>

            @* 2. Fatura Atual *@
            <section class="hearth-card hearth-kpi-card" aria-labelledby="heading-current-invoice" data-testid="dashboard-invoice-card">
                <div class="hearth-kpi-card-head">
                    <h2 id="heading-current-invoice" class="hearth-kpi-card-label">Fatura Atual</h2>
                    <a href="/cartao?aba=fatura" class="hearth-neutral-icon-link" title="Abrir fatura e cartão" aria-label="Abrir fatura e cartão">
                        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <rect x="2.5" y="4.5" width="15" height="11" rx="2.2" stroke="currentColor" stroke-width="1.5" />
                            <path d="M2.5 8.2H17.5" stroke="currentColor" stroke-width="1.5" />
                        </svg>
                    </a>
                </div>

                @if (!invoice.HasActiveCard && invoice.CycleAmount == 0m && invoice.FutureInstallmentsTotal == 0m)
                {
                    <div class="hearth-kpi-empty" data-testid="dashboard-no-card-state">
                        <p class="hearth-kpi-subtitle-line">Nenhum cartão ativo cadastrado.</p>
                        <a href="/cartao" class="hearth-inline-link" data-testid="dashboard-configure-card-link">
                            Cadastrar cartão &rarr;
                        </a>
                    </div>
                }
                else
                {
                    <p class="hearth-kpi-card-value hearth-money is-primary" data-testid="dashboard-invoice-amount">
                        @HearthFormat.Money(invoice.CycleAmount)
                    </p>

                    <div class="hearth-kpi-card-meta">
                        <div class="hearth-invoice-meta-line">
                            @if (invoice.DueDate.HasValue)
                            {
                                <span class="hearth-kpi-caption-line">
                                    Venc. @invoice.DueDate.Value.ToString("dd/MM", HearthFormat.PtBr)
                                </span>
                            }
                            else if (!string.IsNullOrWhiteSpace(invoice.CardName))
                            {
                                <span class="hearth-kpi-caption-line">@invoice.CardName</span>
                            }

                            @if (invoice.Status is { } status)
                            {
                                <span class="hearth-invoice-status-tag @GetInvoiceStatusClass(status)" data-testid="dashboard-invoice-status">
                                    @GetInvoiceStatusLabel(status)
                                </span>
                            }
                        </div>
                        @if (invoice.BillingMonth != _selectedMonth)
                        {
                            <span class="hearth-kpi-subtitle-line">
                                Ciclo @HearthFormat.ShortMonthYear(invoice.BillingMonth)
                            </span>
                        }
                    </div>

                    <div class="hearth-invoice-future-pill hearth-money" data-testid="dashboard-future-installments">
                        + @HearthFormat.Money(invoice.FutureInstallmentsTotal) parcelado futuro
                    </div>
                }
            </section>

            @* 3. Interactive 3-in-1 Card: Summary (Receita + Despesa) <-> Receita View <-> Despesa View *@
            <section class="hearth-card hearth-flow-stack-card @(_flowCardView == FlowCardView.Income ? "is-income-view" : _flowCardView == FlowCardView.Expenses ? "is-expenses-view" : null)"
                     aria-label="Receita e despesa do mês"
                     data-testid="dashboard-flow-stack-card">
                @if (_flowCardView == FlowCardView.Summary)
                {
                    <button type="button"
                            class="hearth-flow-half hearth-flow-half-btn"
                            @onclick="() => _flowCardView = FlowCardView.Income"
                            data-testid="flow-open-income">
                        <div class="hearth-flow-half-copy">
                            <span class="hearth-kpi-card-label">Receita do Mês</span>
                            <strong class="hearth-flow-half-value hearth-money is-positive" data-testid="dashboard-monthly-income">
                                @HearthFormat.Money(flow.MonthlyIncome)
                            </strong>
                        </div>
                        <span class="hearth-flow-arrow is-positive" aria-hidden="true">
                            <svg viewBox="0 0 20 20" fill="none">
                                <path d="M10 15V5M10 5L5.5 9.5M10 5L14.5 9.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </span>
                    </button>

                    <div class="hearth-flow-divider" role="separator"></div>

                    <button type="button"
                            class="hearth-flow-half hearth-flow-half-btn"
                            @onclick="() => _flowCardView = FlowCardView.Expenses"
                            data-testid="flow-open-expenses">
                        <div class="hearth-flow-half-copy">
                            <span class="hearth-kpi-card-label">Despesa Total</span>
                            <strong class="hearth-flow-half-value hearth-money is-danger" data-testid="dashboard-monthly-expenses">
                                @(flow.TotalExpenses > 0m ? $"-{HearthFormat.Money(flow.TotalExpenses)}" : HearthFormat.Money(0m))
                            </strong>
                        </div>
                        <span class="hearth-flow-arrow is-danger" aria-hidden="true">
                            <svg viewBox="0 0 20 20" fill="none">
                                <path d="M10 5V15M10 15L5.5 10.5M10 15L14.5 10.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </span>
                    </button>
                }
                else if (_flowCardView == FlowCardView.Income)
                {
                    var incomeEntries = flow.IncomeEntries ?? [];
                    <div class="hearth-flow-detail-view" data-testid="flow-income-view">
                        <div class="hearth-flow-detail-head">
                            <span class="hearth-kpi-card-label">Receita do Mês</span>
                            <button type="button"
                                    class="hearth-inline-text-btn"
                                    @onclick="() => _flowCardView = FlowCardView.Summary"
                                    data-testid="flow-back-summary">
                                &larr; Voltar
                            </button>
                        </div>

                        <strong class="hearth-flow-detail-total hearth-money is-positive" data-testid="flow-comp-income">
                            @HearthFormat.Money(flow.MonthlyIncome)
                        </strong>

                        @if (incomeEntries.Count == 0)
                        {
                            <p class="hearth-flow-detail-empty">Sem receitas registradas neste mês.</p>
                        }
                        else
                        {
                            <ul class="hearth-flow-detail-list">
                                @foreach (var item in incomeEntries.Take(3))
                                {
                                    <li class="hearth-flow-detail-row">
                                        <span class="hearth-flow-detail-label" title="@item.Description">@item.Description</span>
                                        <span class="hearth-flow-detail-val hearth-money is-positive">@HearthFormat.Money(item.Amount)</span>
                                    </li>
                                }
                            </ul>
                        }

                        <div class="hearth-flow-detail-foot">
                            <a href="/receitas" class="hearth-inline-text-btn">Abrir receitas &rarr;</a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="hearth-flow-detail-view" data-testid="flow-expenses-view">
                        <div class="hearth-flow-detail-head">
                            <span class="hearth-kpi-card-label">Despesa Total</span>
                            <button type="button"
                                    class="hearth-inline-text-btn"
                                    @onclick="() => _flowCardView = FlowCardView.Summary"
                                    data-testid="flow-back-summary">
                                &larr; Voltar
                            </button>
                        </div>

                        <strong class="hearth-flow-detail-total hearth-money is-danger" data-testid="flow-comp-expenses-total">
                            @(flow.TotalExpenses > 0m ? $"-{HearthFormat.Money(flow.TotalExpenses)}" : HearthFormat.Money(0m))
                        </strong>

                        <dl class="hearth-flow-detail-list">
                            <div class="hearth-flow-detail-row">
                                <dt><a href="/gastos-diretos" class="hearth-flow-detail-link">Gastos diretos</a></dt>
                                <dd class="hearth-flow-detail-val hearth-money" data-testid="flow-comp-direct">@HearthFormat.Money(flow.DirectExpenses)</dd>
                            </div>
                            <div class="hearth-flow-detail-row">
                                <dt><a href="/despesas-fixas" class="hearth-flow-detail-link">Despesas fixas</a></dt>
                                <dd class="hearth-flow-detail-val hearth-money" data-testid="flow-comp-fixed">@HearthFormat.Money(flow.FixedExpenses)</dd>
                            </div>
                            <div class="hearth-flow-detail-row">
                                <dt><a href="/cartao?aba=fatura" class="hearth-flow-detail-link">Fatura do cartão</a></dt>
                                <dd class="hearth-flow-detail-val hearth-money" data-testid="flow-comp-card">@HearthFormat.Money(flow.CardInvoice)</dd>
                            </div>
                        </dl>
                    </div>
                }
            </section>

            @* 4. Resultado do Mês (Isolated Net Monthly Balance) *@
            @{
                var resultCardClass = flow.MonthlyResult > 0m
                    ? "is-positive"
                    : flow.MonthlyResult < 0m
                        ? "is-danger"
                        : "is-neutral";
            }
            <section class="hearth-card hearth-kpi-card hearth-result-kpi-card @resultCardClass"
                     aria-labelledby="heading-monthly-result"
                     data-testid="dashboard-monthly-result-card">
                <div class="hearth-kpi-card-head">
                    <h2 id="heading-monthly-result" class="hearth-kpi-card-label">Resultado do Mês</h2>
                    <span class="hearth-result-trend-icon @resultCardClass" aria-hidden="true">
                        @if (flow.MonthlyResult < 0m)
                        {
                            <svg viewBox="0 0 20 20" fill="none">
                                <path d="M4.5 6.5L15.5 14.5M15.5 14.5H9.5M15.5 14.5V8.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 20 20" fill="none">
                                <path d="M4.5 14.5L15.5 5.5M15.5 5.5H9.5M15.5 5.5V11.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        }
                    </span>
                </div>

                <p class="hearth-kpi-card-value hearth-money @resultCardClass" data-testid="dashboard-monthly-result-value">
                    @HearthFormat.Money(flow.MonthlyResult)
                </p>

                <div class="hearth-kpi-card-meta">
                    <span class="hearth-kpi-subtitle-line">Balanço do mês corrente</span>
                    @if (ActiveConditionName is { } filterName)
                    {
                        <span class="hearth-inline-filter-tag hearth-inline-filter-tag--compact">Condição: @filterName</span>
                    }
                </div>
            </section>
        </div>

        @* Expandable Detail Tray beneath Row 1 (keeps all 4 Row 1 cards strictly equal height) *@
        @if (_activeRow1Panel == Row1Panel.BalanceComposition)
        {
            <section class="hearth-card hearth-row1-tray-card" aria-label="Composição do saldo real" data-testid="balance-composition-drawer">
                <div class="hearth-row1-tray-head">
                    <div>
                        <h3 class="hearth-row1-tray-title">Composição do saldo real</h3>
                        <p class="hearth-card-meta">
                            @($"Saldo inicial em {(TrackingStartDate.HasValue ? HearthFormat.Date(TrackingStartDate.Value) : "dia 1º")} com entradas e saídas efetivadas até {HearthFormat.Date(balance.AsOfDate)}.")
                        </p>
                    </div>
                    <div class="hearth-row1-tray-controls">
                        <button type="button" class="hearth-subtle-action" @onclick="CloseRow1Panel">Fechar</button>
                    </div>
                </div>

                <dl class="hearth-tray-grid hearth-money">
                    <div class="hearth-tray-cell" data-testid="balance-composition-initial">
                        <dt>Saldo inicial (@(TrackingStartDate.HasValue ? HearthFormat.Date(TrackingStartDate.Value) : "dia 1º"))</dt>
                        <dd class="@(balance.InitialBalance > 0m ? "hearth-money--positive" : balance.InitialBalance < 0m ? "hearth-money--negative" : null)">
                            @HearthFormat.Money(balance.InitialBalance)
                        </dd>
                    </div>
                    <div class="hearth-tray-cell">
                        <dt><span class="hearth-sign-positive">+</span> Receitas recebidas</dt>
                        <dd class="hearth-money--positive">@HearthFormat.Money(balance.ReceivedIncomes)</dd>
                    </div>
                    <div class="hearth-tray-cell">
                        <dt><span class="hearth-sign-negative">&minus;</span> Gastos diretos</dt>
                        <dd>@HearthFormat.Money(balance.DirectExpenses)</dd>
                    </div>
                    <div class="hearth-tray-cell">
                        <dt><span class="hearth-sign-negative">&minus;</span> Despesas fixas pagas</dt>
                        <dd>@HearthFormat.Money(balance.PaidFixedExpenses)</dd>
                    </div>
                    <div class="hearth-tray-cell">
                        <dt><span class="hearth-sign-negative">&minus;</span> Faturas pagas</dt>
                        <dd>@HearthFormat.Money(balance.PaidInvoices)</dd>
                    </div>
                </dl>

                @if (balance.BalanceHistory is { Count: > 0 } balanceHistory)
                {
                    <div class="hearth-adjustments-log-inline" data-testid="balance-composition-history-log">
                        <span class="hearth-card-meta">Histórico de alterações do saldo inicial (controle de caixa — não entra como receita ou despesa):</span>
                        <div class="hearth-adjustments-list">
                            @foreach (var entry in balanceHistory)
                            {
                                var entryId = entry.Id;
                                <div class="hearth-adjustment-row" data-testid="@($"balance-history-row-{entryId}")">
                                    <div>
                                        <span class="hearth-adjustment-reason">@(string.IsNullOrWhiteSpace(entry.Reason) ? "Saldo inicial atualizado" : entry.Reason)</span>
                                        <span class="hearth-adjustment-date">Saldo inicial · @HearthFormat.Date(entry.Date)</span>
                                    </div>
                                    <div class="hearth-adjustment-row-right">
                                        <span class="hearth-money @(entry.Amount > 0m ? "hearth-money--positive" : entry.Amount < 0m ? "hearth-money--negative" : null)">
                                            @HearthFormat.Money(entry.Amount)
                                        </span>
                                        @if (_confirmDeleteBalanceEntryId == entryId)
                                        {
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudButton Size="Size.Small"
                                                           Variant="Variant.Filled"
                                                           Color="Color.Error"
                                                           Disabled="_deletingBalanceEntry"
                                                           OnClick="() => DeleteBalanceEntryAsync(entryId)"
                                                           data-testid="@($"confirm-delete-balance-entry-{entryId}")">
                                                    Confirmar
                                                </MudButton>
                                                <MudButton Size="Size.Small"
                                                           Variant="Variant.Text"
                                                           Disabled="_deletingBalanceEntry"
                                                           OnClick="() => _confirmDeleteBalanceEntryId = null">
                                                    Cancelar
                                                </MudButton>
                                            </MudStack>
                                        }
                                        else
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Size="Size.Small"
                                                           Class="hearth-action-btn is-danger"
                                                           title="Excluir registro de saldo"
                                                           aria-label="Excluir registro de saldo"
                                                           Disabled="_deletingBalanceEntry"
                                                           OnClick="() => _confirmDeleteBalanceEntryId = entryId"
                                                           data-testid="@($"delete-balance-entry-{entryId}")" />
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </section>
        }
        else if (_activeRow1Panel == Row1Panel.SetBalance)
        {
            <section class="hearth-card hearth-row1-tray-card" aria-label="Alterar saldo inicial" data-testid="set-balance-form">
                <div class="hearth-row1-tray-head">
                    <div>
                        <h3 class="hearth-row1-tray-title">Alterar saldo inicial (@(TrackingStartDate.HasValue ? HearthFormat.Date(TrackingStartDate.Value) : "dia 1º"))</h3>
                        <p class="hearth-card-meta">Único saldo manual da conta, referente ao dia 1º do mês de entrada (negativo, zero ou positivo). O SALDO atual é sempre calculado automaticamente a partir dele, sem afetar receitas, despesas ou resultado mensal.</p>
                    </div>
                </div>
                <div class="hearth-inline-edit-row hearth-adjustment-form-row">
                    <MudNumericField T="decimal"
                                     @bind-Value="_definedBalanceAmount"
                                     Label="@($"Saldo inicial ({(TrackingStartDate.HasValue ? HearthFormat.Date(TrackingStartDate.Value) : "dia 1º")})")"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Culture="@HearthFormat.PtBr"
                                     Format="N2"
                                     Adornment="Adornment.Start"
                                     AdornmentText="R$"
                                     HideSpinButtons="true"
                                     Immediate="true"
                                     Disabled="_savingSetBalance"
                                     Class="hearth-inline-edit-field"
                                     data-testid="set-balance-amount-input" />
                    <MudTextField @bind-Value="_definedBalanceReason"
                                  Label="Motivo (opcional)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  MaxLength="@DomainValidation.MaxDescriptionLength"
                                  Immediate="true"
                                  Disabled="_savingSetBalance"
                                  Class="hearth-adjustment-reason-field"
                                  data-testid="set-balance-reason-input" />
                    <div class="hearth-inline-edit-actions">
                        <button type="button"
                                class="hearth-subtle-action is-primary"
                                disabled="@_savingSetBalance"
                                @onclick="SaveSetBalanceAsync"
                                data-testid="save-set-balance-button">
                            @(_savingSetBalance ? "Salvando…" : "Salvar saldo inicial")
                        </button>
                        <button type="button"
                                class="hearth-subtle-action"
                                disabled="@_savingSetBalance"
                                @onclick="CancelSetBalance">
                            Cancelar
                        </button>
                    </div>
                </div>
            </section>
        }

        @* ROW 2 — 2 Columns (Performance & Distribution) *@
        <div class="hearth-hub-row2" data-testid="dashboard-row-2">
            <MonthlyResultChart Points="_dashboard.MonthlyResultHistory"
                                SelectedMonth="_selectedMonth"
                                MonthSelected="OnMonthChangedAsync" />

            <CategorySpendingDonut Items="_dashboard.CategorySpending" />
        </div>

        @* ROW 3 — 3 Columns (Flow, Habit & Horizon) *@
        <div class="hearth-hub-row3" data-testid="dashboard-row-3">
            @* 1. Left — Atividades recentes *@
            <section class="hearth-card hearth-activities-card" aria-labelledby="heading-recent-activities" data-testid="dashboard-recent-activities-card">
                <div class="hearth-module-head">
                    <h2 id="heading-recent-activities" class="hearth-card-title">Atividades recentes</h2>
                    <a href="/atividades" class="hearth-inline-link" data-testid="recent-activities-view-all">Ver todas</a>
                </div>

                @if (_dashboard.RecentActivities.Count == 0)
                {
                    <EmptyState Compact="true"
                                Title="Nenhuma atividade neste mês"
                                Description="Use &quot;+ Novo lançamento&quot; para registrar receitas, despesas ou compras no cartão."
                                TestId="recent-activities-empty-state" />
                }
                else
                {
                    <ul class="hearth-activity-list" data-testid="recent-activities-list">
                        @foreach (var activity in _dashboard.RecentActivities)
                        {
                            var isIncome = activity.Amount >= 0m;
                            var isPending = string.Equals(activity.StatusLabel, "Previsto", StringComparison.OrdinalIgnoreCase);
                            <li class="hearth-activity-item">
                                <span class="hearth-activity-icon" aria-hidden="true">
                                    @RenderActivityIcon(activity.CategoryIcon)
                                </span>
                                <div class="hearth-activity-copy">
                                    <span class="hearth-activity-desc">@activity.Description</span>
                                    <span class="hearth-activity-meta">
                                        <span class="hearth-activity-date hearth-money">@activity.Date.ToString("dd/MM", HearthFormat.PtBr)</span>
                                        @if (isPending)
                                        {
                                            <span class="hearth-activity-status-tag">Previsto</span>
                                        }
                                    </span>
                                </div>
                                <strong class="hearth-activity-amount hearth-money @(isIncome ? "is-positive" : "is-danger")">
                                    @(isIncome ? $"+{HearthFormat.Money(activity.Amount)}" : $"-{HearthFormat.Money(Math.Abs(activity.Amount))}")
                                </strong>
                            </li>
                        }
                    </ul>
                }
            </section>

            @* 2. Center — Taxa de Poupança *@
            <SavingsRateRing Percentage="flow.SavingsRatePercentage"
                             HasActivity="flow.OwnMonthlyIncome > 0m"
                             MonthlyResult="flow.MonthlyResult" />

            @* 3. Right — Estimativa do próximo mês (Strictly Isolated M + 1 Horizon Card) *@
            <section class="hearth-card hearth-next-month-card" aria-labelledby="heading-next-month" data-testid="dashboard-next-month-card">
                @if (nextMonth is null)
                {
                    <div class="hearth-next-month-head">
                        <h2 id="heading-next-month" class="hearth-card-title">Estimativa do próximo mês</h2>
                    </div>
                    <EmptyState Compact="true"
                                Title="Limite de calendário atingido"
                                Description="Não há período posterior disponível para projeção." />
                }
                else
                {
                    var commitmentRatio = nextMonth.EstimatedIncome > 0m
                        ? Math.Round((nextMonth.EstimatedCommitments / nextMonth.EstimatedIncome) * 100m, 1, MidpointRounding.AwayFromZero)
                        : nextMonth.EstimatedCommitments > 0m ? 100m : 0m;
                    var commitmentFillPct = Math.Clamp((double)commitmentRatio, 0.0, 100.0);
                    var commitmentHigh = nextMonth.EstimatedIncome <= 0m
                        ? nextMonth.EstimatedCommitments > 0m
                        : commitmentRatio > 80m;

                    <div class="hearth-next-month-head">
                        <h2 id="heading-next-month" class="hearth-card-title">Estimativa do próximo mês</h2>
                        <span class="hearth-next-month-badge" data-testid="next-month-badge">
                            @HearthFormat.MonthYear(nextMonth.NextYearMonth)
                        </span>
                    </div>

                    <div class="hearth-next-month-bar-block" data-testid="next-month-commitment-bar">
                        <div class="hearth-next-month-bar-meta">
                            <span>Compromissos vs. Entrada</span>
                            <strong class="hearth-money @(commitmentHigh ? "is-danger" : "is-positive")">
                                @(nextMonth.EstimatedIncome > 0m
                                    ? $"{HearthFormat.Percentage(commitmentRatio)} comprometido"
                                    : nextMonth.EstimatedCommitments > 0m ? "Sem entrada prevista" : "Sem compromissos")
                            </strong>
                        </div>
                        <div class="hearth-next-month-track" aria-hidden="true">
                            <span class="hearth-next-month-fill @(commitmentHigh ? "is-danger" : "is-positive")"
                                  style="@($"width: {commitmentFillPct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%;")"></span>
                        </div>
                    </div>

                    <dl class="hearth-next-month-table">
                        <div class="hearth-next-month-row">
                            <dt>
                                <span class="hearth-nm-dot is-positive" aria-hidden="true"></span>
                                Entrada estimada
                            </dt>
                            <dd class="hearth-money is-positive" data-testid="next-month-income">
                                @HearthFormat.Money(nextMonth.EstimatedIncome)
                            </dd>
                        </div>
                        <div class="hearth-next-month-row">
                            <dt>
                                <span class="hearth-nm-dot is-muted" aria-hidden="true"></span>
                                Despesas fixas estimadas
                            </dt>
                            <dd class="hearth-money" data-testid="next-month-fixed">
                                @HearthFormat.Money(nextMonth.EstimatedFixedExpenses)
                            </dd>
                        </div>
                        <div class="hearth-next-month-row">
                            <dt>
                                <span class="hearth-nm-dot is-danger" aria-hidden="true"></span>
                                Parcelas no cartão
                            </dt>
                            <dd class="hearth-money" data-testid="next-month-installments">
                                @HearthFormat.Money(nextMonth.EstimatedCardInstallments)
                            </dd>
                        </div>
                        @if (nextMonth.EstimatedDirectExpenses > 0m)
                        {
                            <div class="hearth-next-month-row">
                                <dt>
                                    <span class="hearth-nm-dot is-muted" aria-hidden="true"></span>
                                    Gastos diretos agendados
                                </dt>
                                <dd class="hearth-money" data-testid="next-month-direct">
                                    @HearthFormat.Money(nextMonth.EstimatedDirectExpenses)
                                </dd>
                            </div>
                        }
                        <div class="hearth-next-month-row hearth-next-month-row--outflows">
                            <dt>Compromissos estimados</dt>
                            <dd class="hearth-money" data-testid="next-month-expenses">
                                @HearthFormat.Money(nextMonth.EstimatedCommitments)
                            </dd>
                        </div>
                    </dl>

                    <div class="hearth-next-month-summary-footer">
                        <div class="hearth-nm-summary-cell">
                            <span class="hearth-nm-summary-label">Resultado do mês</span>
                            <strong class="hearth-nm-summary-value hearth-nm-summary-value--hero hearth-money @(nextMonth.ProjectedResult > 0m ? "is-positive" : nextMonth.ProjectedResult < 0m ? "is-danger" : null)"
                                    data-testid="next-month-projected-result">
                                @HearthFormat.Money(nextMonth.ProjectedResult)
                            </strong>
                        </div>
                        <div class="hearth-nm-summary-divider" aria-hidden="true"></div>
                        <div class="hearth-nm-summary-cell">
                            <span class="hearth-nm-summary-label">Poupança estimada</span>
                            <strong class="hearth-nm-summary-value hearth-money @(nextMonth.EstimatedSavingsRatePercentage >= 20m ? "is-positive" : nextMonth.EstimatedSavingsRatePercentage <= 0m && nextMonth.ProjectedResult < 0m ? "is-danger" : null)"
                                    data-testid="next-month-savings-rate">
                                @HearthFormat.Percentage(nextMonth.EstimatedSavingsRatePercentage)
                            </strong>
                        </div>
                    </div>

                    @if (nextMonth.ProjectedOpeningBalance.HasValue && nextMonth.ProjectedEndingBalance.HasValue)
                    {
                        var openingBalance = nextMonth.ProjectedOpeningBalance.Value;
                        var endingBalance = nextMonth.ProjectedEndingBalance.Value;
                        <div class="hearth-next-month-balance-block @(endingBalance < 0m ? "is-danger" : null)"
                             data-testid="next-month-balance-projection">
                            <div class="hearth-nm-balance-row">
                                <span>Saldo de entrada previsto</span>
                                <strong class="hearth-money @(openingBalance > 0m ? "is-positive" : openingBalance < 0m ? "is-danger" : null)"
                                        data-testid="next-month-opening-balance">
                                    @HearthFormat.Money(openingBalance)
                                </strong>
                            </div>
                            <div class="hearth-nm-balance-row hearth-nm-balance-row--ending">
                                <span>Saldo previsto ao fim do mês</span>
                                <strong class="hearth-money @(endingBalance > 0m ? "is-positive" : endingBalance < 0m ? "is-danger" : null)"
                                        data-testid="next-month-ending-balance">
                                    @HearthFormat.Money(endingBalance)
                                </strong>
                            </div>
                        </div>
                    }
                    else if (_selectedMonth == YearMonth.From(Clock.Today) && _selectedConditionId.HasValue)
                    {
                        <p class="hearth-next-month-balance-note" data-testid="next-month-balance-filter-note">
                            Saldo previsto disponível no filtro "Todas".
                        </p>
                    }
                }
            </section>
        </div>
    }
</div>

@code
{
    private const int MaxVisibleConditions = 4;

    private enum Row1Panel
    {
        None = 0,
        BalanceComposition = 1,
        SetBalance = 2,
    }

    private enum FlowCardView
    {
        Summary = 0,
        Income = 1,
        Expenses = 2,
    }

    private YearMonth _selectedMonth = YearMonth.Of(2026, 1);
    private DateOnly _realBalanceUntil;

    private Guid? _selectedConditionId;
    private Guid? _promotedConditionId;
    private bool _overflowOpen;
    private bool _quickLaunchOpen;
    private IReadOnlyList<PurchaseConditionDto> _conditions = [];

    private Row1Panel _activeRow1Panel = Row1Panel.None;
    private FlowCardView _flowCardView = FlowCardView.Summary;
    private decimal _definedBalanceAmount;
    private string _definedBalanceReason = string.Empty;
    private bool _savingSetBalance;
    private Guid? _confirmDeleteBalanceEntryId;
    private bool _deletingBalanceEntry;

    private MonthlyDashboardDto? _dashboard;
    private bool _loading = true;

    public DashboardViewModel State =>
        new(_selectedMonth, _realBalanceUntil, _selectedConditionId, _conditions, _dashboard);

    private string? ActiveConditionName =>
        _selectedConditionId.HasValue
            ? _conditions.FirstOrDefault(c => c.Id == _selectedConditionId.Value)?.Name
            : null;

    protected override void OnInitialized()
    {
        _selectedMonth = YearMonth.From(Clock.Today);
        _realBalanceUntil = Clock.Today;
    }

    protected override void OnAccountChanged()
    {
        _activeRow1Panel = Row1Panel.None;
        _flowCardView = FlowCardView.Summary;
        _definedBalanceAmount = 0m;
        _definedBalanceReason = string.Empty;
        _confirmDeleteBalanceEntryId = null;
        _overflowOpen = false;
        _quickLaunchOpen = false;
    }

    protected override async Task LoadDataAsync(CancellationToken cancellationToken)
    {
        _loading = true;

        if (TrackingStartPeriod is { } minMonth && _selectedMonth < minMonth)
        {
            _selectedMonth = minMonth;
        }

        if (TrackingStartDate is { } minDate && _realBalanceUntil < minDate)
        {
            _realBalanceUntil = Clock.Today >= minDate ? Clock.Today : minDate;
        }

        await LoadConditionsAsync(cancellationToken);
        await LoadDashboardAsync(cancellationToken);

        _loading = false;
    }

    private IReadOnlyList<PurchaseConditionDto> GetVisibleConditions()
    {
        if (_conditions.Count <= MaxVisibleConditions)
        {
            return _conditions;
        }

        var visible = _conditions.Take(MaxVisibleConditions).ToList();

        if (_promotedConditionId is { } promotedId
            && visible.All(c => c.Id != promotedId)
            && _conditions.FirstOrDefault(c => c.Id == promotedId) is { } promoted)
        {
            visible[^1] = promoted;
        }

        return visible;
    }

    private IReadOnlyList<PurchaseConditionDto> GetOverflowConditions()
    {
        if (_conditions.Count <= MaxVisibleConditions)
        {
            return [];
        }

        var visibleIds = GetVisibleConditions().Select(c => c.Id).ToHashSet();
        return _conditions.Where(c => !visibleIds.Contains(c.Id)).ToList();
    }

    private static string GetConditionTestId(PurchaseConditionDto condition) =>
        condition.Id == SystemPurchaseConditions.OwnId
            ? "dashboard-condition-own"
            : condition.Id == SystemPurchaseConditions.OthersId
                ? "dashboard-condition-others"
                : $"dashboard-condition-custom-{condition.Name}";

    private async Task LoadConditionsAsync(CancellationToken cancellationToken)
    {
        var result = await Executor.ExecuteAsync<ListPurchaseConditionsHandler, IReadOnlyList<PurchaseConditionDto>>(
            (handler, ct) => handler.ExecuteAsync(new ListPurchaseConditionsQuery(), ct),
            cancellationToken: cancellationToken);

        if (result.IsSuccess && result.Value is not null)
        {
            _conditions = result.Value;
        }
    }

    private async Task LoadDashboardAsync(CancellationToken cancellationToken)
    {
        var result = await Executor.ExecuteAsync<GetMonthlyDashboardHandler, MonthlyDashboardDto>(
            (handler, ct) => handler.ExecuteAsync(
                new GetMonthlyDashboardQuery(
                    AccountId,
                    _selectedMonth,
                    _selectedConditionId,
                    _realBalanceUntil),
                ct),
            cancellationToken: cancellationToken);

        if (result.IsSuccess && result.Value is not null)
        {
            _dashboard = result.Value;
        }
    }

    private void ToggleBalanceComposition() =>
        _activeRow1Panel = _activeRow1Panel == Row1Panel.BalanceComposition
            ? Row1Panel.None
            : Row1Panel.BalanceComposition;

    private void CloseRow1Panel() =>
        _activeRow1Panel = Row1Panel.None;

    private void StartSetBalance()
    {
        if (_activeRow1Panel == Row1Panel.SetBalance)
        {
            _activeRow1Panel = Row1Panel.None;
            return;
        }

        _definedBalanceAmount = _dashboard?.Balance.InitialBalance ?? AccountContext.Current?.InitialBalance ?? 0m;
        _definedBalanceReason = string.Empty;
        _activeRow1Panel = Row1Panel.SetBalance;
    }

    private void CancelSetBalance() =>
        _activeRow1Panel = Row1Panel.None;

    private async Task SaveSetBalanceAsync()
    {
        if (_savingSetBalance)
        {
            return;
        }

        _savingSetBalance = true;
        try
        {
            var result = await Executor.ExecuteAsync<SetAccountBalanceHandler, Guid>(
                (handler, ct) => handler.ExecuteAsync(
                    new SetAccountBalanceCommand(
                        AccountId,
                        _definedBalanceAmount,
                        string.IsNullOrWhiteSpace(_definedBalanceReason) ? null : _definedBalanceReason.Trim()),
                    ct),
                successMessage: "Saldo inicial atualizado com sucesso.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _activeRow1Panel = Row1Panel.None;
                _definedBalanceReason = string.Empty;
                await ReloadAccountContextAsync(AccountId, ComponentCancellationToken);
                await LoadDashboardAsync(ComponentCancellationToken);
            }
        }
        finally
        {
            _savingSetBalance = false;
        }
    }

    private async Task DeleteBalanceEntryAsync(Guid adjustmentId)
    {
        if (_deletingBalanceEntry)
        {
            return;
        }

        _deletingBalanceEntry = true;
        try
        {
            var result = await Executor.ExecuteAsync<DeleteBalanceAdjustmentHandler>(
                (handler, ct) => handler.ExecuteAsync(new DeleteBalanceAdjustmentCommand(AccountId, adjustmentId), ct),
                successMessage: "Registro de saldo excluído.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _confirmDeleteBalanceEntryId = null;
                await ReloadAccountContextAsync(AccountId, ComponentCancellationToken);
                await LoadDashboardAsync(ComponentCancellationToken);
            }
        }
        finally
        {
            _deletingBalanceEntry = false;
        }
    }

    private void ToggleConditionOverflow()
    {
        _overflowOpen = !_overflowOpen;
        if (_overflowOpen)
        {
            _quickLaunchOpen = false;
        }
    }

    private void ToggleQuickLaunchMenu()
    {
        _quickLaunchOpen = !_quickLaunchOpen;
        if (_quickLaunchOpen)
        {
            _overflowOpen = false;
        }
    }

    private void CloseQuickLaunchMenu() =>
        _quickLaunchOpen = false;

    private async Task SelectOverflowConditionAsync(Guid conditionId)
    {
        _promotedConditionId = conditionId;
        _overflowOpen = false;
        await OnConditionFilterChangedAsync(conditionId);
    }

    private async Task OnMonthChangedAsync(YearMonth month)
    {
        if (TrackingStartPeriod is { } minMonth && month < minMonth)
        {
            return;
        }

        _selectedMonth = month;
        await LoadDashboardAsync(ComponentCancellationToken);
    }

    private async Task OnRealBalanceDateChangedAsync(DateTime? date)
    {
        if (!date.HasValue)
        {
            return;
        }

        var selected = HearthFormat.ToDateOnly(date.Value);
        if (selected > Clock.Today)
        {
            selected = Clock.Today;
        }

        if (TrackingStartDate is { } minDate && selected < minDate)
        {
            selected = minDate;
        }

        _realBalanceUntil = selected;
        await LoadDashboardAsync(ComponentCancellationToken);
    }

    private async Task ResetRealBalanceDateAsync()
    {
        _realBalanceUntil = Clock.Today;
        await LoadDashboardAsync(ComponentCancellationToken);
    }

    private async Task OnConditionFilterChangedAsync(Guid? conditionId)
    {
        _selectedConditionId = conditionId;
        _overflowOpen = false;
        await LoadDashboardAsync(ComponentCancellationToken);
    }

    private static string GetInvoiceStatusLabel(InvoiceStatus status) => status switch
    {
        InvoiceStatus.Open => "Aberta",
        InvoiceStatus.Closed => "Fechada",
        InvoiceStatus.Paid => "Paga",
        _ => string.Empty,
    };

    private static string GetInvoiceStatusClass(InvoiceStatus status) => status switch
    {
        InvoiceStatus.Open => "is-open",
        InvoiceStatus.Closed => "is-closed",
        InvoiceStatus.Paid => "is-paid",
        _ => string.Empty,
    };

    private static RenderFragment RenderActivityIcon(string iconKey) => iconKey switch
    {
