    private string ActiveCardDisplayName =>
        string.IsNullOrWhiteSpace(_activeCard?.Name) ? "Cartão de crédito" : _activeCard!.Name!;

    private int _activeCardPurchaseCount =>
        _activeCard is null ? 0 : _purchases.Count(p => p.CreditCardId == _activeCard.Id);

    private bool _activeCardHasPurchases => _activeCardPurchaseCount > 0;

    private IReadOnlyList<CategoryDto> ActiveCategories =>
        _allCategories.Where(c => !c.IsArchived).ToList();

    private IReadOnlyList<string> DistinctCustomNames =>
        _purchases
            .Where(p => p.ConditionKind == PurchaseConditionKind.Custom && !string.IsNullOrWhiteSpace(p.ConditionName))
            .Select(p => p.ConditionName!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private IReadOnlyList<CreditCardPurchaseDto> FilteredPurchases =>
        _conditionFilter is null
            ? _purchases
            : _purchases.Where(MatchesFilter).ToList();

    protected override void OnParametersSet()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');

        if (!_hasInitializedRouteState)
        {
            _hasInitializedRouteState = true;
            _activeTab = ResolveInitialTab(relativePath, RequestedTab, OpenNewOnLoad);
        }
        else if (!string.IsNullOrWhiteSpace(RequestedTab))
        {
            _activeTab = string.Equals(RequestedTab, "compras", StringComparison.OrdinalIgnoreCase)
                ? CardTab.Purchases
                : CardTab.Invoice;
        }
    }

    private static CardTab ResolveInitialTab(string relativePath, string? requestedTab, bool openNewOnLoad)
    {
        if (openNewOnLoad)
        {
            return CardTab.Purchases;
        }

        if (!string.IsNullOrWhiteSpace(requestedTab))
        {
            return string.Equals(requestedTab, "compras", StringComparison.OrdinalIgnoreCase)
                ? CardTab.Purchases
                : CardTab.Invoice;
        }

        if (string.Equals(relativePath, "cartao/compras", StringComparison.OrdinalIgnoreCase))
        {
            return CardTab.Purchases;
        }

        return CardTab.Invoice;
    }

    protected override async Task LoadDataAsync(CancellationToken cancellationToken)
    {
        _loading = true;

        var cardResult = await Executor.ExecuteAsync<GetActiveCreditCardHandler, CreditCardDto?>(
            (handler, ct) => handler.ExecuteAsync(new GetActiveCreditCardQuery(AccountId), ct),
            cancellationToken: cancellationToken);

        var purchasesResult = await Executor.ExecuteAsync<ListCreditCardPurchasesHandler, IReadOnlyList<CreditCardPurchaseDto>>(
            (handler, ct) => handler.ExecuteAsync(new ListCreditCardPurchasesQuery(AccountId), ct),
            cancellationToken: cancellationToken);

        var categoriesResult = await Executor.ExecuteAsync<ListCategoriesHandler, IReadOnlyList<CategoryDto>>(
            (handler, ct) => handler.ExecuteAsync(new ListCategoriesQuery(IncludeArchived: true), ct),
            cancellationToken: cancellationToken);

        if (cardResult.IsSuccess)
        {
            _activeCard = cardResult.Value;
        }

        if (purchasesResult.IsSuccess && purchasesResult.Value is not null)
        {
            _purchases = purchasesResult.Value;
        }

        if (categoriesResult.IsSuccess && categoriesResult.Value is not null)
        {
            _allCategories = categoriesResult.Value;
            _categoryNames = _allCategories.ToDictionary(c => c.Id, c => c.Name);
        }

        _defaultOpenCycle = _activeCard is not null
            ? BillingCycle.ForPurchase(
                Clock.Today,
                CardBillingRule.Of(_activeCard.ClosingDay, _activeCard.DueDay)).ClosingMonth
            : YearMonth.From(Clock.Today);

        if (!_hasManualCycleSelection)
        {
            _selectedCycle = _defaultOpenCycle;
        }

        await LoadInvoiceSummaryAsync(cancellationToken);

        if (_selectedCycle == _defaultOpenCycle && _invoiceSummary is not null)
        {
            _openCycleAmount = _invoiceSummary.CalculatedAmount;
        }
        else if (_activeCard is not null)
        {
            var openResult = await Executor.ExecuteAsync<GetInvoiceSummaryHandler, InvoiceSummaryDto>(
                (handler, ct) => handler.ExecuteAsync(
                    new GetInvoiceSummaryQuery(AccountId, _defaultOpenCycle.Year, _defaultOpenCycle.Month), ct),
                showErrorSnackbar: false,
                cancellationToken: cancellationToken);

            if (openResult.IsSuccess && openResult.Value is not null)
            {
                _openCycleAmount = openResult.Value.CalculatedAmount;
            }
        }
        else
        {
            _openCycleAmount = 0m;
        }

        if (OpenNewOnLoad && !_showCreatePurchaseForm && _activeCard is not null && ActiveCategories.Count > 0)
        {
            OpenNewOnLoad = false;
            StartCreatePurchase();
        }

        _loading = false;
    }

    private async Task LoadInvoiceSummaryAsync(CancellationToken cancellationToken)
    {
        _loadingInvoice = true;

        var summaryResult = await Executor.ExecuteAsync<GetInvoiceSummaryHandler, InvoiceSummaryDto>(
            (handler, ct) => handler.ExecuteAsync(
                new GetInvoiceSummaryQuery(AccountId, _selectedCycle.Year, _selectedCycle.Month), ct),
            cancellationToken: cancellationToken);

        if (summaryResult.IsSuccess && summaryResult.Value is not null)
        {
            _invoiceSummary = summaryResult.Value;
        }

        _loadingInvoice = false;
    }

    private void SelectTab(CardTab tab)
    {
        if (_activeTab == tab)
        {
            return;
        }

        _activeTab = tab;
        var tabQuery = tab == CardTab.Purchases ? "compras" : "fatura";
        Navigation.NavigateTo($"/cartao?aba={tabQuery}", replace: true);
    }

    private async Task FocusInvoiceFromCardAsync()
    {
        _activeTab = CardTab.Invoice;
        if (_selectedCycle != _defaultOpenCycle)
        {
            _hasManualCycleSelection = false;
            _selectedCycle = _defaultOpenCycle;
            await LoadInvoiceSummaryAsync(ComponentCancellationToken);
        }

        Navigation.NavigateTo("/cartao?aba=fatura", replace: true);
    }

    private async Task OnCycleChangedAsync(YearMonth cycle)
    {
        _hasManualCycleSelection = true;
        _selectedCycle = cycle;
        await LoadInvoiceSummaryAsync(ComponentCancellationToken);
    }

    private void CancelPanels()
    {
        _showEditCardForm = false;
        _showCreatePurchaseForm = false;
        _purchaseFormErrors.Clear();
        _cardFormError = null;
        _editingDetails = null;
        _editingAmount = null;
        _editingDate = null;
        _confirmDeletePurchaseId = null;
        _confirmCardAction = CardLifecycleAction.None;
    }

    private void StartCreateCard()
    {
        CancelPanels();
        _cardName = string.Empty;
        _cardClosingDay = 3;
        _cardDueDay = 12;
        _cardLimit = null;
    }

    private void StartEditCard()
    {
        if (_activeCard is null)
        {
            return;
        }

        CancelPanels();
        _cardName = _activeCard.Name ?? string.Empty;
        _cardClosingDay = _activeCard.ClosingDay;
        _cardDueDay = _activeCard.DueDay;
        _cardLimit = _activeCard.Limit;
        _showEditCardForm = true;
    }

    private async Task SaveCardAsync()
    {
        if (_saving)
        {
            return;
        }

        _cardFormError = null;

        if (_cardClosingDay is < 1 or > 28)
        {
            _cardFormError = "O dia de fechamento deve estar entre 1 e 28.";
            return;
        }

        if (_cardDueDay is < 1 or > 28)
        {
            _cardFormError = "O dia de vencimento deve estar entre 1 e 28.";
            return;
        }

        if (_cardLimit.HasValue && _cardLimit.Value <= 0m)
        {
            _cardFormError = "Se informado, o limite do cartão deve ser maior que zero.";
            return;
        }

        var trimmedName = string.IsNullOrWhiteSpace(_cardName) ? null : _cardName.Trim();
        _saving = true;

        try
        {
            if (_activeCard is null)
            {
                var command = new CreateCreditCardCommand(
                    AccountId,
                    _cardClosingDay,
                    _cardDueDay,
                    trimmedName,
                    _cardLimit);

                var result = await Executor.ExecuteAsync<CreateCreditCardHandler, Guid>(
                    (handler, ct) => handler.ExecuteAsync(command, ct),
                    successMessage: "Cartão cadastrado.",
                    cancellationToken: ComponentCancellationToken);

                if (result.IsSuccess)
                {
                    _hasManualCycleSelection = false;
                    CancelPanels();
                }
            }
            else
            {
                var command = new UpdateCreditCardCommand(
                    _activeCard.Id,
                    _cardClosingDay,
                    _cardDueDay,
                    trimmedName,
                    _cardLimit);

                var result = await Executor.ExecuteAsync<UpdateCreditCardHandler>(
                    (handler, ct) => handler.ExecuteAsync(command, ct),
                    successMessage: "Cartão atualizado.",
                    cancellationToken: ComponentCancellationToken);

                if (result.IsSuccess)
                {
                    _hasManualCycleSelection = false;
                    CancelPanels();
                }
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ArchiveCardAsync()
    {
        if (_saving || _activeCard is null)
        {
            return;
        }

        _saving = true;

        try
        {
            var cardId = _activeCard.Id;
            var result = await Executor.ExecuteAsync<ArchiveCreditCardHandler, bool>(
                (handler, ct) => handler.ExecuteAsync(new ArchiveCreditCardCommand(cardId), ct),
                successMessage: "Cartão arquivado. Você já pode cadastrar um novo cartão ativo.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _hasManualCycleSelection = false;
                CancelPanels();
                StartCreateCard();
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteCardAsync()
    {
        if (_saving || _activeCard is null)
        {
            return;
        }

        _saving = true;

        try
        {
            var cardId = _activeCard.Id;
            var result = await Executor.ExecuteAsync<DeleteCreditCardHandler>(
