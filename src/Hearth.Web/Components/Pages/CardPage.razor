            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartCreatePurchase()
    {
        if (_activeCard is null)
        {
            return;
        }

        CancelPanels();
        _activeTab = CardTab.Purchases;
        _description = string.Empty;
        _categoryId = ActiveCategories.FirstOrDefault()?.Id;
        _amount = 0m;
        _date = HearthFormat.ToDateTime(Clock.Today);
        _installmentCount = 1;
        _initialInstallment = 1;
        _conditionKind = PurchaseConditionKind.Own;
        _conditionName = string.Empty;
        _showCreatePurchaseForm = true;
    }

    private async Task CreatePurchaseAsync()
    {
        if (_saving)
        {
            return;
        }

        _purchaseFormErrors.Clear();

        if (_activeCard is null)
        {
            _purchaseFormErrors.Add("Cadastre um cartão de crédito ativo antes de registrar compras.");
        }

        if (string.IsNullOrWhiteSpace(_description))
        {
            _purchaseFormErrors.Add("Informe uma descrição para a compra.");
        }

        if (!_categoryId.HasValue)
        {
            _purchaseFormErrors.Add("Selecione uma categoria.");
        }

        if (_amount <= 0m)
        {
            _purchaseFormErrors.Add("Informe um valor total maior que zero.");
        }

        if (!_date.HasValue)
        {
            _purchaseFormErrors.Add("Informe a data da compra.");
        }

        if (_installmentCount < 1)
        {
            _purchaseFormErrors.Add("A quantidade de parcelas deve ser pelo menos 1.");
        }

        if (_initialInstallment < 1 || _initialInstallment > _installmentCount)
        {
            _purchaseFormErrors.Add("A parcela inicial deve estar entre 1 e o total de parcelas.");
        }

        if (_conditionKind == PurchaseConditionKind.Custom && string.IsNullOrWhiteSpace(_conditionName))
        {
            _purchaseFormErrors.Add("Informe o nome da condição personalizada.");
        }

        if (_purchaseFormErrors.Count > 0)
        {
            return;
        }

        _saving = true;

        try
        {
            var command = new RegisterCreditCardPurchaseCommand(
                AccountId,
                _activeCard!.Id,
                HearthFormat.ToDateOnly(_date!.Value),
                _amount,
                _installmentCount,
                _initialInstallment,
                _conditionKind,
                _conditionKind == PurchaseConditionKind.Custom ? _conditionName.Trim() : null,
                _description.Trim(),
                _categoryId!.Value);

            var result = await Executor.ExecuteAsync<RegisterCreditCardPurchaseHandler, Guid>(
                (handler, ct) => handler.ExecuteAsync(command, ct),
                successMessage: "Compra no cartão registrada.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _showCreatePurchaseForm = false;
                _purchaseFormErrors.Clear();
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private void SetConditionFilter((PurchaseConditionKind Kind, string? Name)? filter) =>
        _conditionFilter = filter;

    private bool IsSelectedFilter(PurchaseConditionKind kind, string? name) =>
        _conditionFilter.HasValue
        && _conditionFilter.Value.Kind == kind
        && string.Equals(_conditionFilter.Value.Name, name, StringComparison.OrdinalIgnoreCase);

    private bool MatchesFilter(CreditCardPurchaseDto purchase)
    {
        if (!_conditionFilter.HasValue)
        {
            return true;
        }

        var (kind, name) = _conditionFilter.Value;
        return kind == PurchaseConditionKind.Custom
            ? purchase.ConditionKind == PurchaseConditionKind.Custom
              && string.Equals(purchase.ConditionName, name, StringComparison.OrdinalIgnoreCase)
            : purchase.ConditionKind == kind;
    }

