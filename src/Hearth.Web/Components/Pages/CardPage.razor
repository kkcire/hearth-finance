    private decimal? GetCreatePurchaseLimitExcess()
    {
        if (_activeCard?.Limit is not > 0m
            || !_activeCard.AvailableLimit.HasValue
            || _amount <= 0m
            || !_date.HasValue
            || _installmentCount < 1
            || _initialInstallment < 1
            || _initialInstallment > _installmentCount)
        {
            return null;
        }

        var rule = CardBillingRule.Of(_activeCard.ClosingDay, _activeCard.DueDay);
        var firstCycle = BillingCycle.ForPurchase(HearthFormat.ToDateOnly(_date.Value), rule);
        var splits = Money.FromDecimal(_amount).Split(_installmentCount);

        var draftUsage = 0m;
        for (var i = _initialInstallment - 1; i < splits.Count; i++)
        {
            if (firstCycle.AddCycles(i).DueDate > Clock.Today)
            {
                draftUsage += splits[i].Amount;
            }
        }

        var excess = draftUsage - _activeCard.AvailableLimit.Value;
        return excess > 0m ? excess : null;
    }

    private decimal? GetEditAmountLimitExcess()
    {
        if (_editingAmount is null
            || _activeCard is null
            || _activeCard.Id != _editingAmount.CreditCardId
            || _activeCard.Limit is not > 0m
            || !_activeCard.AvailableLimit.HasValue
            || _editNewAmount <= 0m
            || _editingAmount.InstallmentCount < 1)
        {
            return null;
        }

        var currentUsage = _editingAmount.Installments
            .Where(i => !i.IsPreviouslyPaid && i.DueDate > Clock.Today)
            .Sum(i => i.Amount);

        var newSplits = Money.FromDecimal(_editNewAmount).Split(_editingAmount.InstallmentCount);
        var newUsage = 0m;
        for (var i = 0; i < _editingAmount.Installments.Count && i < newSplits.Count; i++)
        {
            var inst = _editingAmount.Installments[i];
            if (!inst.IsPreviouslyPaid && inst.DueDate > Clock.Today)
            {
                newUsage += newSplits[i].Amount;
            }
        }

        var delta = newUsage - currentUsage;
        var excess = delta - _activeCard.AvailableLimit.Value;
        return excess > 0m ? excess : null;
    }

    private string GetCategoryName(Guid categoryId) =>
        _categoryNames.GetValueOrDefault(categoryId, "—");

    private static string GetInvoiceStatusLabel(InvoiceStatus? status) =>
        status switch
        {
            InvoiceStatus.Paid => "Paga",
            InvoiceStatus.Closed => "Fechada",
            _ => "Em aberto",
        };

    private static string GetInvoiceStatusPillClass(InvoiceStatus? status) =>
        status switch
        {
            InvoiceStatus.Paid => "is-positive",
            InvoiceStatus.Closed => "is-info",
            _ => "is-warning",
        };
}
