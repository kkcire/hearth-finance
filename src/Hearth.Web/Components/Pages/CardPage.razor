@page "/cartao"
@page "/cartao/faturas"
@page "/cartao/compras"
@attribute [Authorize]
@inherits AccountPageBase
@using Hearth.Application.Categories
@using Hearth.Application.Categories.ListCategories
@using Hearth.Application.CreditCardPurchases
@using Hearth.Application.CreditCardPurchases.DeleteCreditCardPurchase
@using Hearth.Application.CreditCardPurchases.ListCreditCardPurchases
@using Hearth.Application.CreditCardPurchases.RegisterCreditCardPurchase
@using Hearth.Application.CreditCardPurchases.UpdateCreditCardPurchaseAmount
@using Hearth.Application.CreditCardPurchases.UpdateCreditCardPurchaseDate
@using Hearth.Application.CreditCardPurchases.UpdateCreditCardPurchaseDetails
@using Hearth.Application.CreditCards
@using Hearth.Application.CreditCards.ArchiveCreditCard
@using Hearth.Application.CreditCards.CreateCreditCard
@using Hearth.Application.CreditCards.DeleteCreditCard
@using Hearth.Application.CreditCards.ListCreditCards
@using Hearth.Application.CreditCards.RestoreCreditCard
@using Hearth.Application.CreditCards.UpdateCreditCard
@using Hearth.Application.Invoices.GetInvoiceSummary
@using Hearth.Application.PurchaseConditions
@using Hearth.Application.PurchaseConditions.CreatePurchaseCondition
@using Hearth.Application.PurchaseConditions.ListPurchaseConditions
@using Hearth.Web.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Cartão — Hearth Finance</PageTitle>

<div class="hearth-card-page">
    <header class="hearth-dash-header">
        <div class="hearth-dash-title-group">
            <h1 class="hearth-dash-title">Cartão de crédito</h1>
            <p class="hearth-dash-subtitle">
                Limite, fatura por vencimento e compras do seu cartão em um só lugar.
            </p>
        </div>

        <div class="hearth-card-page-actions">
            @if (_activeCard is not null)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           Class="hearth-btn-clean"
                           OnClick="StartCreatePurchase"
                           Disabled="_saving || ActiveCategories.Count == 0"
                           data-testid="new-purchase-button">
                    Nova compra
                </MudButton>
            }
            else if (!_loading)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddCard"
                           Class="hearth-btn-clean"
                           OnClick="StartCreateCard"
                           Disabled="_saving"
                           data-testid="new-card-button">
                    Cadastrar cartão
                </MudButton>
            }
        </div>
    </header>

    @if (_loading)
    {
        <div class="hearth-card-skeleton-hero" aria-busy="true" aria-label="Carregando dados do cartão">
            <div class="hearth-card hearth-skeleton-panel"></div>
        </div>
    }
    else
    {
        @* 1. Faixa Hero Horizontal Unificada (Cartão Amplo + Limite + Gestão Rápida) *@
        @if (_activeCard is not null)
        {
            <section class="hearth-card-showcase" aria-label="Resumo do cartão ativo">
                <button type="button"
                        class="hearth-physical-card"
                        @onclick="FocusInvoiceFromCardAsync"
                        aria-label="Abrir fatura do ciclo atual do cartão @ActiveCardDisplayName"
                        data-testid="physical-card-button">
                    <div class="hearth-physical-card-top">
                        <div class="hearth-physical-card-brand">
                            <svg class="hearth-physical-card-emblem" viewBox="0 0 36 36" fill="none" aria-hidden="true" focusable="false">
                                <path d="M18.6 4.2C18.6 4.2 25.4 9.7 25.4 16.9C25.4 21.1 22.1 24.4 18 24.4C13.9 24.4 10.6 21.1 10.6 16.9C10.6 14.3 11.9 11.7 13.7 9.7C13.5 11.5 14.3 13 15.6 13.5C15.1 10.4 16.3 6.8 18.6 4.2Z" fill="currentColor" />
                                <path d="M18 14.2C19.8 16.1 20.8 18 20.8 19.7C20.8 21.3 19.5 22.6 18 22.6C16.5 22.6 15.2 21.3 15.2 19.7C15.2 18.6 15.8 17.4 16.7 16.4C16.7 17.2 17.1 17.8 17.6 18C17.4 16.8 17.6 15.3 18 14.2Z" fill="#151518" fill-opacity="0.78" />
                                <path d="M9.5 27.6L26.5 24.6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" opacity="0.82" />
                                <path d="M9.5 24.6L26.5 27.6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" opacity="0.52" />
                            </svg>
                            <span translate="no">Hearth</span>
                        </div>

                        <svg class="hearth-physical-card-chip" viewBox="0 0 42 32" fill="none" aria-hidden="true" focusable="false">
                            <rect x="1" y="1" width="40" height="30" rx="6" stroke="currentColor" stroke-width="1.4" />
                            <path d="M14 1V31M28 1V31M1 11H14M28 11H41M1 21H14M28 21H41" stroke="currentColor" stroke-width="1.2" opacity="0.7" />
                        </svg>
                    </div>

                    <div class="hearth-physical-card-middle">
                        <span class="hearth-physical-card-name" data-testid="active-card-name">@ActiveCardDisplayName</span>
                        <span class="hearth-physical-card-account">@(AccountContext.Current?.Name ?? "Conta Principal")</span>
                    </div>

                    <div class="hearth-physical-card-bottom">
                        <div class="hearth-physical-card-dates">
                            <div>
                                <span class="hearth-physical-card-meta-label">Fechamento</span>
                                <strong class="hearth-money">Dia @_activeCard.ClosingDay.ToString("D2")</strong>
                            </div>
                            <div>
                                <span class="hearth-physical-card-meta-label">Vencimento</span>
                                <strong class="hearth-money">Dia @_activeCard.DueDay.ToString("D2")</strong>
                            </div>
                        </div>

                        <span class="hearth-physical-card-cue">Ver fatura</span>
                    </div>
                </button>

                <div class="hearth-card-telemetry">
                    @if (_activeCard.Limit is > 0m)
                    {
                        var available = _activeCard.AvailableLimit ?? 0m;
                        var isLimitExceeded = available < 0m;
                        var usedPct = Math.Round((_activeCard.UsedLimit / _activeCard.Limit.Value) * 100m, 1);
                        var barWidth = Math.Min(100d, (double)usedPct);

                        <div class="hearth-card-telemetry-head">
                            <div>
                                <span class="hearth-kpi-caption">Limite disponível</span>
                                <p class="hearth-hero-value @(isLimitExceeded ? "is-danger" : "is-primary")" data-testid="card-available-limit">
                                    @HearthFormat.Money(available)
                                </p>
                                @if (isLimitExceeded)
                                {
                                    <span class="hearth-limit-exceeded-note" data-testid="card-limit-exceeded-note">
                                        Excedido em @HearthFormat.Money(Math.Abs(available)) — confira compras ou atualize o limite do cartão.
                                    </span>
                                }
                            </div>
                            <span class="hearth-status-pill @(isLimitExceeded || usedPct >= 90m ? "is-danger" : usedPct >= 75m ? "is-warning" : "is-positive")"
                                  data-testid="card-limit-status-pill">
                                @if (isLimitExceeded)
                                {
                                    <svg class="hearth-badge-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                                        <path d="M8 2.2L14 13H2L8 2.2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                                        <path d="M8 6.2V9.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                                        <circle cx="8" cy="11.3" r="0.65" fill="currentColor" />
                                    </svg>
                                    @($"Limite excedido ({HearthFormat.Percentage(usedPct)})")
                                }
                                else
                                {
                                    @($"{HearthFormat.Percentage(usedPct)} utilizado")
                                }
                            </span>
                        </div>

                        <div class="hearth-card-limit-block">
                            <div class="hearth-meter hearth-meter--wide" role="presentation">
                                <span class="hearth-meter-fill @(usedPct >= 90m ? "is-danger" : usedPct >= 75m ? "is-warning" : "is-positive")"
                                      style="width: @(barWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;"></span>
                            </div>
                            <div class="hearth-card-limit-scale hearth-money">
                                <span>Usado <strong>@HearthFormat.Money(_activeCard.UsedLimit)</strong></span>
                                <span>Limite <strong>@HearthFormat.Money(_activeCard.Limit.Value)</strong></span>
                            </div>
                        </div>

                        <dl class="hearth-card-stat-strip">
                            <div class="hearth-card-stat-cell">
                                <dt>Limite total</dt>
                                <dd class="hearth-money" data-testid="card-total-limit">@HearthFormat.Money(_activeCard.Limit.Value)</dd>
                            </div>
                            <div class="hearth-card-stat-cell">
                                <dt>Limite usado</dt>
                                <dd class="hearth-money" data-testid="card-used-limit">@HearthFormat.Money(_activeCard.UsedLimit)</dd>
                            </div>
                            <div class="hearth-card-stat-cell">
                                <dt>Fatura em aberto (@HearthFormat.ShortMonthYear(_defaultOpenCycle))</dt>
                                <dd class="hearth-money">@HearthFormat.Money(_openCycleAmount)</dd>
                            </div>
                        </dl>
                    }
                    else
                    {
                        <div class="hearth-card-telemetry-head">
                            <div>
                                <span class="hearth-kpi-caption">Total comprometido em parcelas futuras</span>
                                <p class="hearth-hero-value is-primary" data-testid="card-used-limit">
                                    @HearthFormat.Money(_activeCard.UsedLimit)
                                </p>
                            </div>
                            <span class="hearth-status-pill is-neutral">Sem limite definido</span>
                        </div>

                        <dl class="hearth-card-stat-strip hearth-card-stat-strip--two">
                            <div class="hearth-card-stat-cell">
                                <dt>Fatura em aberto (@HearthFormat.ShortMonthYear(_defaultOpenCycle))</dt>
                                <dd class="hearth-money">@HearthFormat.Money(_openCycleAmount)</dd>
                            </div>
                            <div class="hearth-card-stat-cell">
                                <dt>Compras vinculadas</dt>
                                <dd class="hearth-money">@_activeCardPurchaseCount</dd>
                            </div>
                        </dl>
                    }

                    <div class="hearth-card-manage-bar">
                        @if (_confirmCardAction == CardLifecycleAction.None)
                        {
                            <span class="hearth-card-lifecycle-hint" data-testid="active-card-lifecycle-hint">
                                @if (_activeCardHasPurchases)
                                {
                                    @($"{_activeCardPurchaseCount} compra(s) vinculada(s) — exclusão bloqueada pelo histórico; use Arquivar.")
                                }
                                else
                                {
                                    @("Nenhuma compra vinculada a este cartão.")
                                }
                            </span>

                            <div class="hearth-card-lifecycle-buttons">
                                <button type="button"
                                        class="hearth-subtle-action hearth-subtle-action--with-icon"
                                        @onclick="StartEditCard"
                                        disabled="@_saving"
                                        data-testid="edit-card-button">
                                    <svg class="hearth-card-action-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                                        <path d="M11.3 2.7L13.3 4.7L5.2 12.8L2.5 13.5L3.2 10.8L11.3 2.7Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round" />
                                    </svg>
                                    <span>Editar cartão</span>
                                </button>
                                <button type="button"
                                        class="hearth-ghost-danger-btn"
                                        @onclick="() => _confirmCardAction = CardLifecycleAction.Archive"
                                        disabled="@_saving"
                                        data-testid="archive-card-button">
                                    Arquivar cartão
                                </button>
                                @if (!_activeCardHasPurchases)
                                {
                                    <button type="button"
                                            class="hearth-ghost-danger-btn"
                                            @onclick="() => _confirmCardAction = CardLifecycleAction.Delete"
                                            disabled="@_saving"
                                            data-testid="delete-card-button">
                                        Excluir cartão
                                    </button>
                                }
                            </div>
                        }
                        else if (_confirmCardAction == CardLifecycleAction.Archive)
                        {
                            <div class="hearth-inline-confirm" role="alert" data-testid="confirm-archive-card-panel">
                                <p>
                                    Arquivar mantém todas as parcelas e faturas históricas nos cálculos e libera o cadastro de um novo cartão ativo.
                                </p>
                                <div class="hearth-inline-confirm-actions">
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Filled"
                                               Color="Color.Error"
                                               OnClick="ArchiveCardAsync"
                                               Disabled="_saving"
                                               data-testid="confirm-archive-card-button">
                                        Confirmar arquivamento
                                    </MudButton>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               OnClick="() => _confirmCardAction = CardLifecycleAction.None"
                                               Disabled="_saving">
                                        Cancelar
                                    </MudButton>
                                </div>
                            </div>
                        }
                        else if (_confirmCardAction == CardLifecycleAction.Delete)
                        {
                            <div class="hearth-inline-confirm" role="alert" data-testid="confirm-delete-card-panel">
                                <p>
                                    Excluir este cartão permanentemente? Esta ação não pode ser desfeita.
                                </p>
                                <div class="hearth-inline-confirm-actions">
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Filled"
                                               Color="Color.Error"
                                               OnClick="DeleteCardAsync"
                                               Disabled="_saving"
                                               data-testid="confirm-delete-card-button">
                                        Confirmar exclusão
                                    </MudButton>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               OnClick="() => _confirmCardAction = CardLifecycleAction.None"
                                               Disabled="_saving">
                                        Cancelar
                                    </MudButton>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }
        else
        {
            <section class="hearth-card hearth-card-onboarding" aria-labelledby="heading-create-card" data-testid="no-active-card-panel">
                <div class="hearth-card-onboarding-visual" aria-hidden="true">
                    <div class="hearth-physical-card hearth-physical-card--ghost">
                        <div class="hearth-physical-card-top">
                            <span translate="no">Hearth</span>
                            <svg class="hearth-physical-card-chip" viewBox="0 0 42 32" fill="none">
                                <rect x="1" y="1" width="40" height="30" rx="6" stroke="currentColor" stroke-width="1.4" />
                            </svg>
                        </div>
                        <div class="hearth-physical-card-middle">
                            <span class="hearth-physical-card-name">Nenhum cartão ativo</span>
                            <span class="hearth-physical-card-account">Cadastre para lançar compras e acompanhar faturas</span>
                        </div>
                    </div>
                </div>

                <div class="hearth-card-onboarding-form">
                    <h2 id="heading-create-card" class="hearth-card-title">Cadastrar cartão de crédito</h2>
                    <p class="hearth-card-meta">
                        Informe os dias de fechamento e vencimento (1 a 28). O nome e o limite são opcionais.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(_cardFormError))
                    {
                        <div class="hearth-inline-alert" role="alert" data-testid="card-form-error">
                            @_cardFormError
                        </div>
                    }

                    <MudGrid Spacing="3" Class="mt-1">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_cardName"
                                          Label="Nome do cartão (opcional)"
                                          Placeholder="Ex.: Nubank, Itaú Black"
                                          Variant="Variant.Outlined"
                                          MaxLength="@DomainValidation.MaxNameLength"
                                          Immediate="true"
                                          Disabled="_saving"
                                          data-testid="card-name-input" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudNumericField T="decimal?"
                                             @bind-Value="_cardLimit"
                                             Label="Limite total (opcional)"
                                             Variant="Variant.Outlined"
                                             Culture="@HearthFormat.PtBr"
                                             Format="N2"
                                             Adornment="Adornment.Start"
                                             AdornmentText="R$"
                                             HideSpinButtons="true"
                                             Immediate="true"
                                             Disabled="_saving"
                                             data-testid="card-limit-input" />
                        </MudItem>

                        <MudItem xs="6">
                            <MudNumericField T="int"
                                             @bind-Value="_cardClosingDay"
                                             Label="Dia de fechamento"
                                             Variant="Variant.Outlined"
                                             Min="1"
                                             Max="28"
                                             Immediate="true"
                                             HelperText="Entre 1 e 28"
                                             Disabled="_saving"
                                             data-testid="card-closing-day-input" />
                        </MudItem>

                        <MudItem xs="6">
                            <MudNumericField T="int"
                                             @bind-Value="_cardDueDay"
                                             Label="Dia de vencimento"
                                             Variant="Variant.Outlined"
                                             Min="1"
                                             Max="28"
                                             Immediate="true"
                                             HelperText="Entre 1 e 28"
                                             Disabled="_saving"
                                             data-testid="card-due-day-input" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Class="hearth-btn-clean"
                                       OnClick="SaveCardAsync"
                                       Disabled="_saving"
                                       data-testid="save-card-submit">
                                @(_saving ? "Salvando…" : "Cadastrar cartão")
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </div>
            </section>
        }

        @* Painel de edição do cartão ativo *@
        @if (_showEditCardForm && _activeCard is not null)
        {
            <section class="hearth-card hearth-panel-box" aria-labelledby="heading-edit-card" data-testid="edit-card-form">
                <div class="hearth-module-head">
                    <div>
                        <h2 id="heading-edit-card" class="hearth-card-title">Editar cartão</h2>
                        <p class="hearth-card-meta">
                            Alterar fechamento ou vencimento vale apenas para novas compras; compras anteriores preservam a regra original.
                        </p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_cardFormError))
                {
                    <div class="hearth-inline-alert" role="alert" data-testid="card-form-error">
                        @_cardFormError
                    </div>
                }

                <MudGrid Spacing="3" Class="mt-1">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_cardName"
                                      Label="Nome do cartão (opcional)"
                                      Variant="Variant.Outlined"
                                      MaxLength="@DomainValidation.MaxNameLength"
                                      Immediate="true"
                                      Disabled="_saving"
                                      data-testid="edit-card-name-input" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal?"
                                         @bind-Value="_cardLimit"
                                         Label="Limite total (opcional)"
                                         Variant="Variant.Outlined"
                                         Culture="@HearthFormat.PtBr"
                                         Format="N2"
                                         Adornment="Adornment.Start"
                                         AdornmentText="R$"
                                         HideSpinButtons="true"
                                         Immediate="true"
                                         Disabled="_saving"
                                         data-testid="edit-card-limit-input" />
                    </MudItem>

                    <MudItem xs="6" sm="3">
                        <MudNumericField T="int"
                                         @bind-Value="_cardClosingDay"
                                         Label="Dia de fechamento"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Max="28"
                                         Immediate="true"
                                         Disabled="_saving"
                                         data-testid="edit-card-closing-day-input" />
                    </MudItem>

                    <MudItem xs="6" sm="3">
                        <MudNumericField T="int"
                                         @bind-Value="_cardDueDay"
                                         Label="Dia de vencimento"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Max="28"
                                         Immediate="true"
                                         Disabled="_saving"
                                         data-testid="edit-card-due-day-input" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                            <MudButton Variant="Variant.Text" OnClick="CancelPanels" Disabled="_saving">Cancelar</MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Class="hearth-btn-clean"
                                       OnClick="SaveCardAsync"
                                       Disabled="_saving"
                                       data-testid="save-card-submit">
                                @(_saving ? "Salvando…" : "Salvar alterações")
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </section>
        }

        @* Formulário de Nova Compra (nunca pré-desabilitado; valida com feedback explícito) *@
        @if (_showCreatePurchaseForm)
        {
            <section class="hearth-card hearth-panel-box" aria-labelledby="heading-new-purchase" data-testid="create-purchase-form">
                <div class="hearth-module-head">
                    <div>
                        <h2 id="heading-new-purchase" class="hearth-card-title">Nova compra no cartão</h2>
                        <p class="hearth-card-meta">Cartão ativo: @ActiveCardDisplayName</p>
                    </div>
                </div>

                @if (_purchaseFormErrors.Count > 0)
                {
                    <div class="hearth-inline-alert" role="alert" data-testid="create-purchase-errors">
                        <p class="hearth-inline-alert-title">Corrija os campos abaixo para registrar a compra:</p>
                        <ul class="hearth-inline-alert-list">
                            @foreach (var error in _purchaseFormErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }

                <MudGrid Spacing="3" Class="mt-1">
                    <MudItem xs="12" sm="4">
                        <MudSelect T="Guid"
                                   @bind-Value="_purchaseCardId"
                                   Label="Cartão"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   Disabled="_saving"
                                   data-testid="purchase-card-select">
                            @foreach (var card in ActiveCards)
                            {
                                <MudSelectItem T="Guid" Value="@card.Id">@GetCardDisplayName(card)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_description"
                                      Label="Descrição"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      MaxLength="@DomainValidation.MaxDescriptionLength"
                                      Counter="@DomainValidation.MaxDescriptionLength"
                                      Immediate="true"
                                      Disabled="_saving"
                                      data-testid="purchase-description-input" />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudSelect T="Guid?"
                                   @bind-Value="_categoryId"
                                   Label="Categoria"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   Disabled="_saving"
                                   data-testid="purchase-category-select">
                            @foreach (var category in ActiveCategories)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)category.Id)">@category.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudNumericField T="decimal"
                                         @bind-Value="_amount"
                                         Label="Valor total"
                                         Variant="Variant.Outlined"
                                         Culture="@HearthFormat.PtBr"
                                         Format="N2"
                                         Adornment="Adornment.Start"
                                         AdornmentText="R$"
                                         HideSpinButtons="true"
                                         Immediate="true"
                                         HelperText="Resto de centavos vai na primeira parcela."
                                         Disabled="_saving"
                                         data-testid="purchase-amount-input" />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudDatePicker @bind-Date="_date"
                                       Label="Data da compra"
                                       Variant="Variant.Outlined"
                                       DateFormat="dd/MM/yyyy"
                                       Culture="@HearthFormat.PtBr"
                                       Editable="true"
                                       Disabled="_saving"
                                       data-testid="purchase-date-input" />
                    </MudItem>

                    <MudItem xs="6" sm="2">
                        <MudNumericField T="int"
                                         @bind-Value="_installmentCount"
                                         Label="Parcelas"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Max="120"
                                         Immediate="true"
                                         Disabled="_saving"
                                         data-testid="purchase-installments-input" />
                    </MudItem>

                    <MudItem xs="6" sm="2">
                        <MudNumericField T="int"
                                         @bind-Value="_initialInstallment"
                                         Label="Parcela inicial"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Max="@Math.Max(1, _installmentCount)"
                                         Immediate="true"
                                         HelperText="> 1: anteriores já pagas"
                                         Disabled="_saving"
                                         data-testid="purchase-initial-installment-input" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="Guid"
                                   @bind-Value="_conditionId"
                                   Label="Condição"
                                   Variant="Variant.Outlined"
                                   Disabled="_saving"
                                   data-testid="purchase-condition-select">
                            @foreach (var condition in ActiveConditions)
                            {
                                <MudSelectItem T="Guid" Value="@condition.Id">@condition.Name</MudSelectItem>
                            }
                            <MudSelectItem T="Guid" Value="@CreateNewConditionSentinelId">+ Nova condição</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    @if (_conditionId == CreateNewConditionSentinelId)
                    {
                        <MudItem xs="12" sm="6">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudTextField @bind-Value="_newConditionName"
                                              Label="Nome da nova condição"
                                              Placeholder="Ex.: Mãe, Ana, Trabalho"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              MaxLength="@DomainValidation.MaxNameLength"
                                              Immediate="true"
                                              Disabled="_saving"
                                              data-testid="purchase-condition-name-input" />
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Class="hearth-btn-clean"
                                           OnClick="CreateNewConditionForPurchaseAsync"
                                           Disabled="_saving || string.IsNullOrWhiteSpace(_newConditionName)"
                                           data-testid="save-new-condition-button">
                                    Salvar
                                </MudButton>
                            </MudStack>
                        </MudItem>
                    }

                    @if (GetCreatePurchaseLimitExcess() is { } createLimitExcess && SelectedPurchaseCard?.AvailableLimit is { } createAvailable)
                    {
                        <MudItem xs="12">
                            <div class="hearth-limit-warning" role="status" data-testid="create-purchase-limit-warning">
                                <svg class="hearth-limit-warning-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                                    <path d="M10 2.8L17.6 16.4H2.4L10 2.8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                                    <path d="M10 7.6V11.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                    <circle cx="10" cy="14.1" r="0.85" fill="currentColor" />
                                </svg>
                                <div>
                                    <strong>Esta compra excede o limite disponível atual em @HearthFormat.Money(createLimitExcess)</strong>
                                    (disponível: <span class="hearth-money">@HearthFormat.Money(createAvailable)</span>).
                                    Confira se o valor da compra ou o limite cadastrado estão corretos — você ainda pode registrar normalmente.
                                </div>
                            </div>
                        </MudItem>
                    }

                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                            <MudButton Variant="Variant.Text" OnClick="CancelPanels" Disabled="_saving">Cancelar</MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Class="hearth-btn-clean"
                                       OnClick="CreatePurchaseAsync"
                                       Disabled="_saving"
                                       data-testid="create-purchase-submit">
                                @(_saving ? "Salvando…" : "Registrar compra")
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </section>
        }

        @* Painel unificado de edição de compra (acionado pelo botão único Editar) *@
        @if (_editingPurchase is not null)
        {
            <section class="hearth-card hearth-panel-box" aria-labelledby="heading-edit-purchase" data-testid="edit-purchase-panel">
                <div class="hearth-module-head">
                    <div>
                        <h2 id="heading-edit-purchase" class="hearth-card-title">Editar compra — @_editingPurchase.Description</h2>
                        <p class="hearth-card-meta">
                            Atualize os dados da compra em um só lugar.
                        </p>
                    </div>
                </div>

                @if (_editingPurchase.IsLocked)
                {
                    <div class="hearth-history-notice" role="status" data-testid="edit-purchase-locked-notice">
                        Esta compra possui parcela vinculada a uma fatura já paga. Descrição, categoria e condição podem ser editadas; valor e data permanecem bloqueados para preservar o histórico de caixa.
                    </div>
                }

                <MudGrid Spacing="3" Class="mt-1">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_editDescription"
                                      Label="Descrição"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      MaxLength="@DomainValidation.MaxDescriptionLength"
                                      Immediate="true"
                                      Disabled="_saving"
                                      data-testid="edit-purchase-description-input" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="Guid?"
                                   @bind-Value="_editCategoryId"
                                   Label="Categoria"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   Disabled="_saving"
                                   data-testid="edit-purchase-category-select">
                            @foreach (var category in _allCategories.Where(c => !c.IsArchived || c.Id == _editingPurchase.CategoryId))
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)category.Id)">
                                    @(category.IsArchived ? $"{category.Name} (Arquivada)" : category.Name)
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudNumericField T="decimal"
                                         @bind-Value="_editAmount"
                                         Label="Valor total"
                                         Variant="Variant.Outlined"
                                         Culture="@HearthFormat.PtBr"
                                         Format="N2"
                                         Adornment="Adornment.Start"
                                         AdornmentText="R$"
                                         HideSpinButtons="true"
                                         Immediate="true"
                                         HelperText="@(_editingPurchase.IsLocked ? "Bloqueado: fatura já paga" : "Resto de centavos vai na primeira parcela.")"
                                         Disabled="_saving || _editingPurchase.IsLocked"
                                         data-testid="edit-purchase-amount-input" />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudDatePicker @bind-Date="_editDate"
                                       Label="Data da compra"
                                       Variant="Variant.Outlined"
                                       DateFormat="dd/MM/yyyy"
                                       Culture="@HearthFormat.PtBr"
                                       Editable="true"
                                       HelperText="@(_editingPurchase.IsLocked ? "Bloqueado: fatura já paga" : "Define o ciclo da 1ª parcela.")"
                                       Disabled="_saving || _editingPurchase.IsLocked"
                                       data-testid="edit-purchase-date-input" />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudTextField Value="@FormatEditInstallmentsSummary(_editingPurchase)"
                                      Label="Parcelas"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true"
                                      Disabled="true"
                                      HelperText="Definido no registro da compra."
                                      data-testid="edit-purchase-installments-readonly" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="Guid"
                                   @bind-Value="_editConditionId"
                                   Label="Condição"
                                   Variant="Variant.Outlined"
                                   Disabled="_saving"
                                   data-testid="edit-purchase-condition-select">
                            @foreach (var condition in _allConditions.Where(c => !c.IsArchived || c.Id == _editingPurchase.ConditionId))
                            {
                                <MudSelectItem T="Guid" Value="@condition.Id">
                                    @(condition.IsArchived ? $"{condition.Name} (Arquivada)" : condition.Name)
                                </MudSelectItem>
                            }
                            <MudSelectItem T="Guid" Value="@CreateNewConditionSentinelId">+ Nova condição</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    @if (_editConditionId == CreateNewConditionSentinelId)
                    {
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_editNewConditionName"
                                          Label="Nome da nova condição"
                                          Variant="Variant.Outlined"
                                          MaxLength="@DomainValidation.MaxNameLength"
                                          Immediate="true"
                                          Disabled="_saving"
                                          data-testid="edit-purchase-condition-name-input" />
                        </MudItem>
                    }

                    @if (!_editingPurchase.IsLocked && GetEditAmountLimitExcess() is { } editLimitExcess && _activeCard?.AvailableLimit is { } editAvailable)
                    {
                        <MudItem xs="12">
                            <div class="hearth-limit-warning" role="status" data-testid="edit-purchase-limit-warning">
                                <svg class="hearth-limit-warning-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                                    <path d="M10 2.8L17.6 16.4H2.4L10 2.8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                                    <path d="M10 7.6V11.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                    <circle cx="10" cy="14.1" r="0.85" fill="currentColor" />
                                </svg>
                                <div>
                                    <strong>O novo valor excede o limite disponível atual em @HearthFormat.Money(editLimitExcess)</strong>
                                    (disponível: <span class="hearth-money">@HearthFormat.Money(editAvailable)</span>).
                                    Confira o valor ou o limite cadastrado — você ainda pode salvar normalmente.
                                </div>
                            </div>
                        </MudItem>
                    }

                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                            <MudButton Variant="Variant.Text" OnClick="CancelPanels" Disabled="_saving">Cancelar</MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Class="hearth-btn-clean"
                                       OnClick="SavePurchaseEditAsync"
                                       Disabled="@IsSavePurchaseEditDisabled"
                                       data-testid="save-purchase-edit">
                                @(_saving ? "Salvando…" : "Salvar alterações")
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </section>
        }

        @* 2. Workspace Unificado: Fatura | Compras (?aba=compras) *@
        @if (_activeCard is not null || _purchases.Count > 0)
        {
            @if (_activeCard is null && _purchases.Count > 0)
            {
                <div class="hearth-history-notice" role="status">
                    Você não tem um cartão ativo no momento. As faturas e compras de cartões arquivados continuam disponíveis abaixo.
                </div>
            }

            <div id="cartao-conteudo" class="hearth-card-workspace">
                <div class="hearth-workspace-head">
                    <div class="hearth-card-tabs-bar" role="tablist" aria-label="Seções do cartão">
                        <button type="button"
                                id="tab-fatura"
                                role="tab"
                                class="hearth-tab-btn @(_activeTab == CardTab.Invoice ? "is-active" : null)"
                                aria-selected="@(_activeTab == CardTab.Invoice ? "true" : "false")"
                                aria-controls="panel-fatura"
                                @onclick="() => SelectTab(CardTab.Invoice)"
                                data-testid="card-tab-invoice">
                            Fatura
                        </button>

                        <button type="button"
                                id="tab-compras"
                                role="tab"
                                class="hearth-tab-btn @(_activeTab == CardTab.Purchases ? "is-active" : null)"
                                aria-selected="@(_activeTab == CardTab.Purchases ? "true" : "false")"
                                aria-controls="panel-compras"
                                @onclick="() => SelectTab(CardTab.Purchases)"
                                data-testid="card-tab-purchases">
                            Compras
                            <span class="hearth-tab-count hearth-money">@_purchases.Count</span>
                        </button>
                    </div>

                    @if (_activeTab == CardTab.Invoice)
                    {
                        <MonthNavigator Month="_selectedCycle" MonthChanged="OnCycleChangedAsync" Disabled="_loadingInvoice" />
                    }
                    else
                    {
                        <span class="hearth-purchases-total hearth-money">
                            @FilteredPurchases.Count compra(s) · <strong>@HearthFormat.Money(FilteredPurchases.Sum(p => p.Amount))</strong>
                        </span>
                    }
                </div>

                @if (_activeTab == CardTab.Invoice)
                {
                    <section id="panel-fatura"
                             role="tabpanel"
                             aria-labelledby="tab-fatura"
                             class="hearth-tab-panel"
                             data-testid="card-invoice-panel">
                        @if (_invoiceSummary is not null)
                        {
                            <div class="hearth-invoice-banner">
                                <div class="hearth-invoice-banner-info">
                                    <div class="hearth-invoice-title-row">
                                        <h2 class="hearth-card-title">
                                            Fatura de @HearthFormat.MonthYear(_selectedCycle)
                                        </h2>
                                        @if (_invoiceSummary.Status is not null)
                                        {
                                            <span class="hearth-status-pill @(GetInvoiceStatusPillClass(_invoiceSummary.Status))" data-testid="invoice-status-chip">
                                                @GetInvoiceStatusLabel(_invoiceSummary.Status)
                                            </span>
                                        }
                                    </div>

                                    @if (_invoiceSummary.StartDate.HasValue && _invoiceSummary.EndDate.HasValue && _invoiceSummary.ClosingDate.HasValue && _invoiceSummary.DueDate.HasValue)
                                    {
                                        <dl class="hearth-invoice-cycle-meta">
                                            <div>
                                                <dt>Período</dt>
                                                <dd class="hearth-money">@HearthFormat.Date(_invoiceSummary.StartDate) a @HearthFormat.Date(_invoiceSummary.EndDate)</dd>
                                            </div>
                                            <div>
                                                <dt>Fechamento</dt>
                                                <dd class="hearth-money">@HearthFormat.Date(_invoiceSummary.ClosingDate)</dd>
                                            </div>
                                            <div class="is-due">
                                                <dt>Vencimento</dt>
                                                <dd class="hearth-money">@HearthFormat.Date(_invoiceSummary.DueDate)</dd>
                                            </div>
                                        </dl>
                                    }
                                </div>

                                <div class="hearth-invoice-banner-total">
                                    <span class="hearth-kpi-caption">Total da fatura</span>
                                    <p class="hearth-hero-value is-primary" data-testid="invoice-calculated-amount">
                                        @HearthFormat.Money(_invoiceSummary.CalculatedAmount)
                                    </p>
                                    <span class="hearth-invoice-installment-count hearth-money">
                                        @_invoiceSummary.Installments.Count parcela(s) com vencimento neste mês
                                    </span>
                                </div>
                            </div>

                            @if (_invoiceSummary.Installments.Count == 0)
                            {
                                <div class="hearth-empty-state hearth-empty-state--compact">
                                    <p class="hearth-empty-title">Nenhuma parcela nesta fatura</p>
                                    <p class="hearth-empty-desc">
                                        Use as setas acima para consultar outros meses ou registre uma compra no cartão.
                                    </p>
                                    @if (_activeCard is not null && ActiveCategories.Count > 0)
                                    {
                                        <div>
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Class="hearth-btn-clean"
                                                       OnClick="StartCreatePurchase">
                                                Nova compra
                                            </MudButton>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <MudTable Items="_invoiceSummary.Installments" Hover="true" Dense="true" Elevation="0" Class="hearth-card-table">
                                    <HeaderContent>
                                        <MudTh Style="width: 112px;">Data</MudTh>
                                        <MudTh>Compra</MudTh>
                                        <MudTh>Categoria</MudTh>
                                        <MudTh>Condição</MudTh>
                                        <MudTh Style="width: 100px;">Parcela</MudTh>
                                        <MudTh Style="width: 148px; text-align: right;">Valor</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Data" Class="hearth-money hearth-purchase-date">@HearthFormat.Date(context.PurchaseDate)</MudTd>
                                        <MudTd DataLabel="Compra">
                                            <span class="hearth-purchase-desc-main">@context.Description</span>
                                        </MudTd>
                                        <MudTd DataLabel="Categoria" Class="hearth-purchase-category">@GetCategoryName(context.CategoryId)</MudTd>
                                        <MudTd DataLabel="Condição">
                                            <span class="hearth-condition-chip">
                                                @GetConditionName(context.ConditionId)
                                            </span>
                                        </MudTd>
                                        <MudTd DataLabel="Parcela" Class="hearth-money">
                                            <span class="hearth-installment-progress-tag">@($"{context.InstallmentNumber}/{context.InstallmentCount}")</span>
                                        </MudTd>
                                        <MudTd DataLabel="Valor" Style="text-align: right; font-weight: 600;" Class="hearth-money">
                                            @HearthFormat.Money(context.Amount)
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        }
                    </section>
                }
                else
                {
                    <section id="panel-compras"
                             role="tabpanel"
                             aria-labelledby="tab-compras"
                             class="hearth-tab-panel"
                             data-testid="card-purchases-panel">
                        <div class="hearth-purchases-toolbar">
                            <div class="hearth-condition-bar" role="group" aria-label="Filtrar compras por condição">
                                <span class="hearth-condition-label">Condição:</span>
                                <div class="hearth-condition-pills">
                                    <button type="button"
                                            class="hearth-filter-pill @(_conditionFilterId is null ? "is-active" : null)"
                                            aria-pressed="@(_conditionFilterId is null ? "true" : "false")"
                                            @onclick="() => SetConditionFilter(null)"
                                            data-testid="filter-condition-all">
                                        Todas
                                    </button>

                                    @foreach (var condition in FilterableConditions)
                                    {
                                        var conditionId = condition.Id;
                                        var isActive = _conditionFilterId == conditionId;
                                        var testId = condition.Id == SystemPurchaseConditions.OwnId
                                            ? "filter-condition-own"
                                            : condition.Id == SystemPurchaseConditions.OthersId
                                                ? "filter-condition-others"
                                                : $"filter-condition-custom-{condition.Name}";
                                        <button type="button"
                                                class="hearth-filter-pill @(isActive ? "is-active" : null)"
                                                aria-pressed="@(isActive ? "true" : "false")"
                                                @onclick="() => SetConditionFilter(conditionId)"
                                                data-testid="@testId">
                                            @condition.Name
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <MudTable Items="FilteredPurchases" Hover="true" Dense="true" Elevation="0" Class="hearth-card-table">
                            <HeaderContent>
                                <MudTh Style="width: 108px;">Data</MudTh>
                                <MudTh>Compra</MudTh>
                                <MudTh>Categoria</MudTh>
                                <MudTh>Condição</MudTh>
                                <MudTh>Parcelas</MudTh>
                                <MudTh>Situação</MudTh>
                                <MudTh Style="text-align: right;">Valor total</MudTh>
                                <MudTh Style="width: 148px; text-align: right;">Ações</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Data" Class="hearth-money hearth-purchase-date">@HearthFormat.Date(context.Date)</MudTd>
                                <MudTd DataLabel="Compra">
                                    <div class="hearth-purchase-desc-cell">
                                        <span class="hearth-purchase-desc-main">
                                            @context.Description
                                            @if (_allCards.Count > 1 && _cardsById.TryGetValue(context.CreditCardId, out var purchaseCard))
                                            {
                                                <span class="hearth-condition-chip">
                                                    @(purchaseCard.IsArchived ? $"{GetCardDisplayName(purchaseCard)} (Arquivado)" : GetCardDisplayName(purchaseCard))
                                                </span>
                                            }
                                        </span>
                                        @if (context.IsLocked)
                                        {
                                            <span class="hearth-purchase-lock-caption">
                                                Fatura já paga · valor, data e exclusão bloqueados
                                            </span>
                                        }
                                    </div>
                                </MudTd>
                                <MudTd DataLabel="Categoria" Class="hearth-purchase-category">@GetCategoryName(context.CategoryId)</MudTd>
                                <MudTd DataLabel="Condição">
                                    <span class="hearth-condition-chip">
                                        @GetConditionName(context.ConditionId)
                                    </span>
                                </MudTd>
                                <MudTd DataLabel="Parcelas" Class="hearth-money">
                                    <span class="hearth-purchase-installments">
                                        <span>@($"{context.InstallmentCount}x")</span>
                                        @if (context.InitialInstallment > 1)
                                        {
                                            <span class="hearth-installment-progress-tag">@($"início {context.InitialInstallment}/{context.InstallmentCount}")</span>
                                        }
                                    </span>
                                </MudTd>
                                <MudTd DataLabel="Situação">
                                    @if (context.IsLocked)
                                    {
                                        <span class="hearth-status-pill is-warning" data-testid="@($"purchase-status-{context.Id}")">
                                            <svg class="hearth-lock-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                                                <rect x="3.2" y="7" width="9.6" height="6.8" rx="1.6" stroke="currentColor" stroke-width="1.35" />
                                                <path d="M5.4 7V5.2C5.4 3.76 6.56 2.6 8 2.6C9.44 2.6 10.6 3.76 10.6 5.2V7" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
                                            </svg>
                                            <span>Fatura paga</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="hearth-status-pill is-positive" data-testid="@($"purchase-status-{context.Id}")">Aberta</span>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Valor total" Style="text-align: right; font-weight: 600;" Class="hearth-money">
                                    @HearthFormat.Money(context.Amount)
                                </MudTd>
                                <MudTd DataLabel="Ações" Style="text-align: right;">
                                    @if (_confirmDeletePurchaseId == context.Id)
                                    {
                                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                                            <MudButton Size="Size.Small"
                                                       Variant="Variant.Filled"
                                                       Color="Color.Error"
                                                       OnClick="() => DeletePurchaseAsync(context.Id)"
                                                       Disabled="_saving"
                                                       data-testid="@($"confirm-delete-purchase-{context.Id}")">
                                                Confirmar
                                            </MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _confirmDeletePurchaseId = null" Disabled="_saving">
                                                Cancelar
                                            </MudButton>
                                        </MudStack>
                                    }
                                    else
                                    {
                                        <div class="hearth-purchase-actions">
                                            <MudIconButton Icon="@(_expandedPurchaseId == context.Id ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                           Size="Size.Small"
                                                           Class="hearth-purchase-action-btn"
                                                           title="Ver parcelas"
                                                           aria-label="Ver parcelas"
                                                           OnClick="() => ToggleExpand(context.Id)"
                                                           data-testid="@($"expand-purchase-{context.Id}")" />

                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Size="Size.Small"
                                                           Class="hearth-purchase-action-btn"
                                                           title="@(context.IsLocked ? "Editar compra (valor e data bloqueados por fatura paga)" : "Editar compra")"
                                                           aria-label="Editar compra"
                                                           OnClick="() => StartEditPurchase(context)"
                                                           Disabled="_saving"
                                                           data-testid="@($"edit-purchase-{context.Id}")" />

                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Size="Size.Small"
                                                           Class="@($"hearth-purchase-action-btn is-danger {(context.IsLocked ? "is-locked" : string.Empty)}")"
                                                           title="@(context.IsLocked ? "Bloqueado: compra vinculada a fatura já paga" : "Excluir compra")"
                                                           aria-label="Excluir compra"
                                                           OnClick="() => _confirmDeletePurchaseId = context.Id"
                                                           Disabled="_saving || context.IsLocked"
                                                           data-testid="@($"delete-purchase-{context.Id}")" />
                                        </div>
                                    }
                                </MudTd>
                            </RowTemplate>
                            <ChildRowContent>
                                @if (_expandedPurchaseId == context.Id)
                                {
                                    <MudTr>
                                        <td colspan="8" class="pa-2">
                                            <div class="hearth-expanded-box">
                                                <p class="hearth-expanded-title">Parcelas de "@context.Description"</p>
                                                <MudSimpleTable Dense="true" Elevation="0" Class="hearth-card-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Parcela</th>
                                                            <th>Ciclo (fechamento)</th>
                                                            <th>Vencimento</th>
                                                            <th>Situação</th>
                                                            <th style="text-align: right;">Valor</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var installment in context.Installments)
                                                        {
                                                            <tr>
                                                                <td class="hearth-money">@($"{installment.Number}/{context.InstallmentCount}")</td>
                                                                <td class="hearth-money">@HearthFormat.ShortMonthYear(installment.ClosingYear, installment.ClosingMonth)</td>
                                                                <td class="hearth-money">@HearthFormat.Date(installment.DueDate)</td>
                                                                <td>
                                                                    @if (installment.IsPreviouslyPaid)
                                                                    {
                                                                        <span class="hearth-status-pill is-neutral">Já paga</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="hearth-status-pill is-info">Na fatura</span>
                                                                    }
                                                                </td>
                                                                <td style="text-align: right;" class="hearth-money">@HearthFormat.Money(installment.Amount)</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </MudSimpleTable>
                                            </div>
                                        </td>
                                    </MudTr>
                                }
                            </ChildRowContent>
                            <NoRecordsContent>
                                <div class="hearth-empty-state hearth-empty-state--compact">
                                    <p class="hearth-empty-title">Nenhuma compra registrada</p>
                                    <p class="hearth-empty-desc">
                                        Clique em "Nova compra" para adicionar o primeiro lançamento neste cartão.
                                    </p>
                                </div>
                            </NoRecordsContent>
                        </MudTable>
                    </section>
                }
            </div>
        }

        @* 3. Seção secundária e recolhível de Cartões Arquivados (baixo peso visual no rodapé) *@
        @if (ArchivedCards.Count > 0)
        {
            var isArchivedExpanded = _showArchivedCards || _activeCard is null;
            <section class="hearth-archived-drawer" aria-labelledby="heading-archived-cards" data-testid="archived-cards-section">
                <button type="button"
                        class="hearth-archived-toggle"
                        aria-expanded="@(isArchivedExpanded ? "true" : "false")"
                        @onclick="ToggleArchivedCards"
                        data-testid="archived-cards-toggle">
                    <span class="hearth-archived-toggle-left">
                        <svg class="hearth-card-action-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                            <rect x="2" y="2.8" width="12" height="2.8" rx="0.8" stroke="currentColor" stroke-width="1.3" />
                            <path d="M3.2 5.6V12.2C3.2 12.75 3.65 13.2 4.2 13.2H11.8C12.35 13.2 12.8 12.75 12.8 12.2V5.6" stroke="currentColor" stroke-width="1.3" />
                            <path d="M6.4 8.6H9.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                        </svg>
                        <span id="heading-archived-cards" class="hearth-archived-toggle-title">
                            Cartões arquivados (@ArchivedCards.Count)
                        </span>
                        <span class="hearth-archived-toggle-meta">
                            Histórico preservado · fora do seletor de novas compras
                        </span>
                    </span>
                    <svg class="hearth-archived-chevron @(isArchivedExpanded ? "is-open" : null)" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M5.5 7.75L10 12.25L14.5 7.75" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>

                @if (isArchivedExpanded)
                {
                    <ul class="hearth-archived-list">
                        @foreach (var card in ArchivedCards)
                        {
                            var archivedPurchaseCount = GetCardPurchaseCount(card.Id);
                            <li class="hearth-archived-item">
                                <div class="hearth-archived-item-info">
                                    <span class="hearth-archived-item-name">
                                        @GetCardDisplayName(card)
                                        <span class="hearth-status-pill is-neutral">Arquivado</span>
                                    </span>
                                    <span class="hearth-archived-item-meta hearth-money">
                                        Fecha dia @card.ClosingDay.ToString("D2") · Vence dia @card.DueDay.ToString("D2") · @archivedPurchaseCount compra(s) vinculada(s)
                                    </span>
                                </div>

                                <div class="hearth-archived-item-actions">
                                    @if (_confirmDeleteArchivedCardId == card.Id)
                                    {
                                        <MudButton Size="Size.Small"
                                                   Variant="Variant.Filled"
                                                   Color="Color.Error"
                                                   OnClick="() => DeleteArchivedCardAsync(card.Id)"
                                                   Disabled="_saving"
                                                   data-testid="@($"confirm-delete-archived-card-{card.Id}")">
                                            Confirmar exclusão
                                        </MudButton>
                                        <MudButton Size="Size.Small"
                                                   Variant="Variant.Text"
                                                   OnClick="() => _confirmDeleteArchivedCardId = null"
                                                   Disabled="_saving">
                                            Cancelar
                                        </MudButton>
                                    }
                                    else
                                    {
                                        @if (archivedPurchaseCount > 0)
                                        {
                                            <span class="hearth-card-lifecycle-hint" data-testid="@($"archived-card-delete-blocked-{card.Id}")">
                                                Possui compras vinculadas — exclusão indisponível
                                            </span>
                                        }

                                        <button type="button"
                                                class="hearth-subtle-action"
                                                title="@(_activeCard is not null ? "Arquive ou exclua o cartão ativo atual antes de reativar este cartão." : "Reativar cartão")"
                                                @onclick="() => RestoreCardAsync(card.Id)"
                                                disabled="@(_saving || _activeCard is not null)"
                                                data-testid="@($"restore-card-{card.Id}")">
                                            Reativar
                                        </button>

                                        @if (archivedPurchaseCount == 0)
                                        {
                                            <button type="button"
                                                    class="hearth-ghost-danger-btn"
                                                    @onclick="() => _confirmDeleteArchivedCardId = card.Id"
                                                    disabled="@_saving"
                                                    data-testid="@($"delete-archived-card-{card.Id}")">
                                                Excluir
                                            </button>
                                        }
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
    }
</div>

@code
{
    private enum CardTab
    {
        Invoice,
        Purchases,
    }

    private enum CardLifecycleAction
    {
        None,
        Archive,
        Delete,
    }

    [SupplyParameterFromQuery(Name = "aba")]
    public string? RequestedTab { get; set; }

    [SupplyParameterFromQuery(Name = "nova")]
    public bool OpenNewOnLoad { get; set; }

    private CardTab _activeTab = CardTab.Invoice;
    private bool _hasInitializedRouteState;
    private bool _hasManualCycleSelection;

    private IReadOnlyList<CreditCardDto> _allCards = [];
    private Dictionary<Guid, CreditCardDto> _cardsById = [];
    private CreditCardDto? _activeCard;
    private InvoiceSummaryDto? _invoiceSummary;
    private YearMonth _selectedCycle = YearMonth.Of(2026, 1);
    private YearMonth _defaultOpenCycle = YearMonth.Of(2026, 1);
    private decimal _openCycleAmount;

    private static readonly Guid CreateNewConditionSentinelId = Guid.Empty;

    private IReadOnlyList<CreditCardPurchaseDto> _purchases = [];
    private IReadOnlyList<CategoryDto> _allCategories = [];
    private Dictionary<Guid, string> _categoryNames = [];
    private IReadOnlyList<PurchaseConditionDto> _allConditions = [];
    private Dictionary<Guid, string> _conditionNames = [];

    private bool _loading = true;
    private bool _loadingInvoice;
    private bool _saving;

    // Card create/edit form state
    private bool _showEditCardForm;
    private bool _showArchivedCards;
    private CardLifecycleAction _confirmCardAction = CardLifecycleAction.None;
    private Guid? _confirmDeleteArchivedCardId;
    private string _cardName = string.Empty;
    private int _cardClosingDay = 3;
    private int _cardDueDay = 12;
    private decimal? _cardLimit;
    private string? _cardFormError;

    // Purchase create form state
    private bool _showCreatePurchaseForm;
    private readonly List<string> _purchaseFormErrors = [];
    private Guid _purchaseCardId;
    private string _description = string.Empty;
    private Guid? _categoryId;
    private decimal _amount;
    private DateTime? _date;
    private int _installmentCount = 1;
    private int _initialInstallment = 1;
    private Guid _conditionId = SystemPurchaseConditions.OwnId;
    private string _newConditionName = string.Empty;

    // Purchase filters & unified edit panel
    private Guid? _conditionFilterId;
    private Guid? _expandedPurchaseId;
    private CreditCardPurchaseDto? _editingPurchase;
    private string _editDescription = string.Empty;
    private Guid? _editCategoryId;
    private Guid _editConditionId = SystemPurchaseConditions.OwnId;
    private string _editNewConditionName = string.Empty;
    private decimal _editAmount;
    private DateTime? _editDate;

    private Guid? _confirmDeletePurchaseId;

    private IReadOnlyList<CreditCardDto> ActiveCards =>
        _allCards.Where(c => !c.IsArchived).ToList();

    private IReadOnlyList<CreditCardDto> ArchivedCards =>
        _allCards.Where(c => c.IsArchived).ToList();

    private CreditCardDto? SelectedPurchaseCard =>
        ActiveCards.FirstOrDefault(c => c.Id == _purchaseCardId) ?? _activeCard;

    private string ActiveCardDisplayName =>
        GetCardDisplayName(_activeCard);

    private static string GetCardDisplayName(CreditCardDto? card) =>
        string.IsNullOrWhiteSpace(card?.Name) ? "Cartão de crédito" : card!.Name!;

    private int GetCardPurchaseCount(Guid creditCardId) =>
        _purchases.Count(p => p.CreditCardId == creditCardId);

    private int _activeCardPurchaseCount =>
        _activeCard is null ? 0 : GetCardPurchaseCount(_activeCard.Id);

    private bool _activeCardHasPurchases => _activeCardPurchaseCount > 0;

    private IReadOnlyList<CategoryDto> ActiveCategories =>
        _allCategories.Where(c => !c.IsArchived).ToList();

    private IReadOnlyList<PurchaseConditionDto> ActiveConditions =>
        _allConditions.Where(c => !c.IsArchived).ToList();

    private IReadOnlyList<PurchaseConditionDto> FilterableConditions =>
        _allConditions
            .Where(c => !c.IsArchived || _purchases.Any(p => p.ConditionId == c.Id))
            .ToList();

    private IReadOnlyList<CreditCardPurchaseDto> FilteredPurchases =>
        _conditionFilterId is null
            ? _purchases
            : _purchases.Where(p => p.ConditionId == _conditionFilterId.Value).ToList();

    protected override void OnParametersSet()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');

        if (!_hasInitializedRouteState)
        {
            _hasInitializedRouteState = true;
            _activeTab = ResolveInitialTab(relativePath, RequestedTab, OpenNewOnLoad);
        }
        else if (!string.IsNullOrWhiteSpace(RequestedTab))
        {
            _activeTab = string.Equals(RequestedTab, "compras", StringComparison.OrdinalIgnoreCase)
                ? CardTab.Purchases
                : CardTab.Invoice;
        }
    }

    private static CardTab ResolveInitialTab(string relativePath, string? requestedTab, bool openNewOnLoad)
    {
        if (openNewOnLoad)
        {
            return CardTab.Purchases;
        }

        if (!string.IsNullOrWhiteSpace(requestedTab))
        {
            return string.Equals(requestedTab, "compras", StringComparison.OrdinalIgnoreCase)
                ? CardTab.Purchases
                : CardTab.Invoice;
        }

        if (string.Equals(relativePath, "cartao/compras", StringComparison.OrdinalIgnoreCase))
        {
            return CardTab.Purchases;
        }

        return CardTab.Invoice;
    }

    protected override async Task LoadDataAsync(CancellationToken cancellationToken)
    {
        _loading = true;

        var cardsResult = await Executor.ExecuteAsync<ListCreditCardsHandler, IReadOnlyList<CreditCardDto>>(
            (handler, ct) => handler.ExecuteAsync(new ListCreditCardsQuery(AccountId, IncludeArchived: true), ct),
            cancellationToken: cancellationToken);

        var purchasesResult = await Executor.ExecuteAsync<ListCreditCardPurchasesHandler, IReadOnlyList<CreditCardPurchaseDto>>(
            (handler, ct) => handler.ExecuteAsync(new ListCreditCardPurchasesQuery(AccountId), ct),
            cancellationToken: cancellationToken);

        var categoriesResult = await Executor.ExecuteAsync<ListCategoriesHandler, IReadOnlyList<CategoryDto>>(
            (handler, ct) => handler.ExecuteAsync(new ListCategoriesQuery(IncludeArchived: true), ct),
            cancellationToken: cancellationToken);

        var conditionsResult = await Executor.ExecuteAsync<ListPurchaseConditionsHandler, IReadOnlyList<PurchaseConditionDto>>(
            (handler, ct) => handler.ExecuteAsync(new ListPurchaseConditionsQuery(IncludeArchived: true), ct),
            cancellationToken: cancellationToken);

        if (cardsResult.IsSuccess && cardsResult.Value is not null)
        {
            _allCards = cardsResult.Value;
            _cardsById = _allCards.ToDictionary(c => c.Id);
            _activeCard = _allCards.FirstOrDefault(c => !c.IsArchived);
            if (_activeCard is not null && !ActiveCards.Any(c => c.Id == _purchaseCardId))
            {
                _purchaseCardId = _activeCard.Id;
            }
        }

        if (purchasesResult.IsSuccess && purchasesResult.Value is not null)
        {
            _purchases = purchasesResult.Value;
        }

        if (categoriesResult.IsSuccess && categoriesResult.Value is not null)
        {
            _allCategories = categoriesResult.Value;
            _categoryNames = _allCategories.ToDictionary(c => c.Id, c => c.Name);
        }

        if (conditionsResult.IsSuccess && conditionsResult.Value is not null)
        {
            _allConditions = conditionsResult.Value;
            _conditionNames = _allConditions.ToDictionary(c => c.Id, c => c.Name);
        }

        _defaultOpenCycle = _activeCard is not null
            ? BillingCycle.ForPurchase(
                Clock.Today,
                CardBillingRule.Of(_activeCard.ClosingDay, _activeCard.DueDay)).DueMonth
            : YearMonth.From(Clock.Today);

        if (!_hasManualCycleSelection)
        {
            _selectedCycle = _defaultOpenCycle;
        }

        await LoadInvoiceSummaryAsync(cancellationToken);

        if (_selectedCycle == _defaultOpenCycle && _invoiceSummary is not null)
        {
            _openCycleAmount = _invoiceSummary.CalculatedAmount;
        }
        else if (_activeCard is not null)
        {
            var openResult = await Executor.ExecuteAsync<GetInvoiceSummaryHandler, InvoiceSummaryDto>(
                (handler, ct) => handler.ExecuteAsync(
                    new GetInvoiceSummaryQuery(AccountId, _defaultOpenCycle.Year, _defaultOpenCycle.Month, MonthBasis: InvoiceMonthBasis.DueMonth), ct),
                showErrorSnackbar: false,
                cancellationToken: cancellationToken);

            if (openResult.IsSuccess && openResult.Value is not null)
            {
                _openCycleAmount = openResult.Value.CalculatedAmount;
            }
        }
        else
        {
            _openCycleAmount = 0m;
        }

        if (OpenNewOnLoad && !_showCreatePurchaseForm && _activeCard is not null && ActiveCategories.Count > 0)
        {
            OpenNewOnLoad = false;
            StartCreatePurchase();
        }

        _loading = false;
    }

    private async Task LoadInvoiceSummaryAsync(CancellationToken cancellationToken)
    {
        _loadingInvoice = true;

        var summaryResult = await Executor.ExecuteAsync<GetInvoiceSummaryHandler, InvoiceSummaryDto>(
            (handler, ct) => handler.ExecuteAsync(
                new GetInvoiceSummaryQuery(AccountId, _selectedCycle.Year, _selectedCycle.Month, MonthBasis: InvoiceMonthBasis.DueMonth), ct),
            cancellationToken: cancellationToken);

        if (summaryResult.IsSuccess && summaryResult.Value is not null)
        {
            _invoiceSummary = summaryResult.Value;
        }

        _loadingInvoice = false;
    }

    private void SelectTab(CardTab tab)
    {
        if (_activeTab == tab)
        {
            return;
        }

        _activeTab = tab;
        var tabQuery = tab == CardTab.Purchases ? "compras" : "fatura";
        Navigation.NavigateTo($"/cartao?aba={tabQuery}", replace: true);
    }

    private async Task FocusInvoiceFromCardAsync()
    {
        _activeTab = CardTab.Invoice;
        if (_selectedCycle != _defaultOpenCycle)
        {
            _hasManualCycleSelection = false;
            _selectedCycle = _defaultOpenCycle;
            await LoadInvoiceSummaryAsync(ComponentCancellationToken);
        }

        Navigation.NavigateTo("/cartao?aba=fatura", replace: true);
    }

    private async Task OnCycleChangedAsync(YearMonth cycle)
    {
        _hasManualCycleSelection = true;
        _selectedCycle = cycle;
        await LoadInvoiceSummaryAsync(ComponentCancellationToken);
    }

    private void ToggleArchivedCards() =>
        _showArchivedCards = !_showArchivedCards;

    private void CancelPanels()
    {
        _showEditCardForm = false;
        _showCreatePurchaseForm = false;
        _purchaseFormErrors.Clear();
        _cardFormError = null;
        _editingPurchase = null;
        _confirmDeletePurchaseId = null;
        _confirmCardAction = CardLifecycleAction.None;
        _confirmDeleteArchivedCardId = null;
    }

    private void StartCreateCard()
    {
        CancelPanels();
        _cardName = string.Empty;
        _cardClosingDay = 3;
        _cardDueDay = 12;
        _cardLimit = null;
    }

    private void StartEditCard()
    {
        if (_activeCard is null)
        {
            return;
        }

        CancelPanels();
        _cardName = _activeCard.Name ?? string.Empty;
        _cardClosingDay = _activeCard.ClosingDay;
        _cardDueDay = _activeCard.DueDay;
        _cardLimit = _activeCard.Limit;
        _showEditCardForm = true;
    }

    private async Task SaveCardAsync()
    {
        if (_saving)
        {
            return;
        }

        _cardFormError = null;

        if (_cardClosingDay is < 1 or > 28)
        {
            _cardFormError = "O dia de fechamento deve estar entre 1 e 28.";
            return;
        }

        if (_cardDueDay is < 1 or > 28)
        {
            _cardFormError = "O dia de vencimento deve estar entre 1 e 28.";
            return;
        }

        if (_cardLimit.HasValue && _cardLimit.Value <= 0m)
        {
            _cardFormError = "Se informado, o limite do cartão deve ser maior que zero.";
            return;
        }

        var trimmedName = string.IsNullOrWhiteSpace(_cardName) ? null : _cardName.Trim();
        _saving = true;

        try
        {
            if (_activeCard is null)
            {
                var command = new CreateCreditCardCommand(
                    AccountId,
                    _cardClosingDay,
                    _cardDueDay,
                    trimmedName,
                    _cardLimit);

                var result = await Executor.ExecuteAsync<CreateCreditCardHandler, Guid>(
                    (handler, ct) => handler.ExecuteAsync(command, ct),
                    successMessage: "Cartão cadastrado.",
                    cancellationToken: ComponentCancellationToken);

                if (result.IsSuccess)
                {
                    _hasManualCycleSelection = false;
                    CancelPanels();
                }
            }
            else
            {
                var command = new UpdateCreditCardCommand(
                    _activeCard.Id,
                    _cardClosingDay,
                    _cardDueDay,
                    trimmedName,
                    _cardLimit);

                var result = await Executor.ExecuteAsync<UpdateCreditCardHandler>(
                    (handler, ct) => handler.ExecuteAsync(command, ct),
                    successMessage: "Cartão atualizado.",
                    cancellationToken: ComponentCancellationToken);

                if (result.IsSuccess)
                {
                    _hasManualCycleSelection = false;
                    CancelPanels();
                }
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ArchiveCardAsync()
    {
        if (_saving || _activeCard is null)
        {
            return;
        }

        _saving = true;

        try
        {
            var cardId = _activeCard.Id;
            var result = await Executor.ExecuteAsync<ArchiveCreditCardHandler, bool>(
                (handler, ct) => handler.ExecuteAsync(new ArchiveCreditCardCommand(cardId), ct),
                successMessage: "Cartão arquivado. Você já pode cadastrar um novo cartão ativo.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _hasManualCycleSelection = false;
                CancelPanels();
                StartCreateCard();
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteCardAsync()
    {
        if (_saving || _activeCard is null)
        {
            return;
        }

        _saving = true;

        try
        {
            var cardId = _activeCard.Id;
            var result = await Executor.ExecuteAsync<DeleteCreditCardHandler>(
                (handler, ct) => handler.ExecuteAsync(new DeleteCreditCardCommand(cardId), ct),
                successMessage: "Cartão excluído.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _hasManualCycleSelection = false;
                CancelPanels();
                StartCreateCard();
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RestoreCardAsync(Guid cardId)
    {
        if (_saving)
        {
            return;
        }

        _saving = true;

        try
        {
            var result = await Executor.ExecuteAsync<RestoreCreditCardHandler, bool>(
                (handler, ct) => handler.ExecuteAsync(new RestoreCreditCardCommand(cardId), ct),
                successMessage: "Cartão reativado.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _hasManualCycleSelection = false;
                CancelPanels();
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteArchivedCardAsync(Guid cardId)
    {
        if (_saving)
        {
            return;
        }

        _saving = true;

        try
        {
            var result = await Executor.ExecuteAsync<DeleteCreditCardHandler>(
                (handler, ct) => handler.ExecuteAsync(new DeleteCreditCardCommand(cardId), ct),
                successMessage: "Cartão arquivado excluído.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _confirmDeleteArchivedCardId = null;
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartCreatePurchase()
    {
        if (_activeCard is null)
        {
            return;
        }

        CancelPanels();
        _activeTab = CardTab.Purchases;
        _purchaseCardId = _activeCard.Id;
        _description = string.Empty;
        _categoryId = ActiveCategories.FirstOrDefault()?.Id;
        _amount = 0m;
        _date = HearthFormat.ToDateTime(Clock.Today);
        _installmentCount = 1;
        _initialInstallment = 1;
        _conditionId = SystemPurchaseConditions.OwnId;
        _newConditionName = string.Empty;
        _showCreatePurchaseForm = true;
    }

    private async Task CreateNewConditionForPurchaseAsync()
    {
        if (_saving || string.IsNullOrWhiteSpace(_newConditionName))
        {
            return;
        }

        _saving = true;

        try
        {
            var created = await CreateOrReuseConditionAsync(_newConditionName, ComponentCancellationToken);
            if (created is not null)
            {
                _conditionId = created.Id;
                _newConditionName = string.Empty;
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task<PurchaseConditionDto?> CreateOrReuseConditionAsync(
        string rawName,
        CancellationToken cancellationToken)
    {
        var result = await Executor.ExecuteAsync<CreatePurchaseConditionHandler, PurchaseConditionDto>(
            (handler, ct) => handler.ExecuteAsync(new CreatePurchaseConditionCommand(rawName.Trim()), ct),
            cancellationToken: cancellationToken);

        if (!result.IsSuccess || result.Value is null)
        {
            return null;
        }

        var refreshed = await Executor.ExecuteAsync<ListPurchaseConditionsHandler, IReadOnlyList<PurchaseConditionDto>>(
            (handler, ct) => handler.ExecuteAsync(new ListPurchaseConditionsQuery(IncludeArchived: true), ct),
            showErrorSnackbar: false,
            cancellationToken: cancellationToken);

        if (refreshed.IsSuccess && refreshed.Value is not null)
        {
            _allConditions = refreshed.Value;
            _conditionNames = _allConditions.ToDictionary(c => c.Id, c => c.Name);
        }

        return result.Value;
    }

    private async Task CreatePurchaseAsync()
    {
        if (_saving)
        {
            return;
        }

        _purchaseFormErrors.Clear();

        if (_activeCard is null)
        {
            _purchaseFormErrors.Add("Cadastre um cartão de crédito ativo antes de registrar compras.");
        }
        else if (!ActiveCards.Any(c => c.Id == _purchaseCardId))
        {
            _purchaseFormErrors.Add("Selecione um cartão ativo.");
        }

        if (string.IsNullOrWhiteSpace(_description))
        {
            _purchaseFormErrors.Add("Informe uma descrição para a compra.");
        }

        if (!_categoryId.HasValue)
        {
            _purchaseFormErrors.Add("Selecione uma categoria.");
        }

        if (_amount <= 0m)
        {
            _purchaseFormErrors.Add("Informe um valor total maior que zero.");
        }

        if (!_date.HasValue)
        {
            _purchaseFormErrors.Add("Informe a data da compra.");
        }

        if (_installmentCount < 1)
        {
            _purchaseFormErrors.Add("A quantidade de parcelas deve ser pelo menos 1.");
        }

        if (_initialInstallment < 1 || _initialInstallment > _installmentCount)
        {
            _purchaseFormErrors.Add("A parcela inicial deve estar entre 1 e o total de parcelas.");
        }

        if (_conditionId == CreateNewConditionSentinelId && string.IsNullOrWhiteSpace(_newConditionName))
        {
            _purchaseFormErrors.Add("Informe o nome da nova condição.");
        }

        if (_purchaseFormErrors.Count > 0)
        {
            return;
        }

        _saving = true;

        try
        {
            var resolvedConditionId = _conditionId;
            if (resolvedConditionId == CreateNewConditionSentinelId)
            {
                var created = await CreateOrReuseConditionAsync(_newConditionName, ComponentCancellationToken);
                if (created is null)
                {
                    return;
                }

                resolvedConditionId = created.Id;
                _conditionId = created.Id;
                _newConditionName = string.Empty;
            }

            var command = new RegisterCreditCardPurchaseCommand(
                AccountId,
                _purchaseCardId,
                HearthFormat.ToDateOnly(_date!.Value),
                _amount,
                _installmentCount,
                _initialInstallment,
                resolvedConditionId,
                _description.Trim(),
                _categoryId!.Value);

            var result = await Executor.ExecuteAsync<RegisterCreditCardPurchaseHandler, Guid>(
                (handler, ct) => handler.ExecuteAsync(command, ct),
                successMessage: "Compra no cartão registrada.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _showCreatePurchaseForm = false;
                _purchaseFormErrors.Clear();
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private void SetConditionFilter(Guid? conditionId) =>
        _conditionFilterId = conditionId;

    private void ToggleExpand(Guid purchaseId) =>
        _expandedPurchaseId = _expandedPurchaseId == purchaseId ? null : purchaseId;

    private bool IsSavePurchaseEditDisabled =>
        _saving
        || _editingPurchase is null
        || string.IsNullOrWhiteSpace(_editDescription)
        || !_editCategoryId.HasValue
        || (_editConditionId == CreateNewConditionSentinelId && string.IsNullOrWhiteSpace(_editNewConditionName))
        || (!_editingPurchase.IsLocked && (_editAmount <= 0m || !_editDate.HasValue));

    private static string FormatEditInstallmentsSummary(CreditCardPurchaseDto purchase) =>
        purchase.InitialInstallment > 1
            ? $"{purchase.InstallmentCount}x (início {purchase.InitialInstallment}/{purchase.InstallmentCount})"
            : $"{purchase.InstallmentCount}x";

    private void StartEditPurchase(CreditCardPurchaseDto purchase)
    {
        CancelPanels();
        _editingPurchase = purchase;
        _editDescription = purchase.Description;
        _editCategoryId = purchase.CategoryId;
        _editConditionId = purchase.ConditionId;
        _editNewConditionName = string.Empty;
        _editAmount = purchase.Amount;
        _editDate = HearthFormat.ToDateTime(purchase.Date);
    }

    private async Task SavePurchaseEditAsync()
    {
        if (IsSavePurchaseEditDisabled || _editingPurchase is null)
        {
            return;
        }

        _saving = true;

        try
        {
            var purchase = _editingPurchase;
            var resolvedConditionId = _editConditionId;
            if (resolvedConditionId == CreateNewConditionSentinelId)
            {
                var created = await CreateOrReuseConditionAsync(_editNewConditionName, ComponentCancellationToken);
                if (created is null)
                {
                    return;
                }

                resolvedConditionId = created.Id;
                _editConditionId = created.Id;
                _editNewConditionName = string.Empty;
            }

            var trimmedDescription = _editDescription.Trim();
            var detailsChanged = !string.Equals(trimmedDescription, purchase.Description, StringComparison.Ordinal)
                                 || _editCategoryId!.Value != purchase.CategoryId
                                 || resolvedConditionId != purchase.ConditionId;

            var newDate = _editDate.HasValue ? HearthFormat.ToDateOnly(_editDate.Value) : purchase.Date;
            var dateChanged = !purchase.IsLocked && newDate != purchase.Date;
            var amountChanged = !purchase.IsLocked && _editAmount != purchase.Amount;

            if (!detailsChanged && !dateChanged && !amountChanged)
            {
                _editingPurchase = null;
                return;
            }

            if (dateChanged)
            {
                var dateResult = await Executor.ExecuteAsync<UpdateCreditCardPurchaseDateHandler>(
                    (handler, ct) => handler.ExecuteAsync(new UpdateCreditCardPurchaseDateCommand(purchase.Id, newDate), ct),
                    successMessage: !amountChanged && !detailsChanged ? "Compra atualizada." : null,
                    cancellationToken: ComponentCancellationToken);

                if (!dateResult.IsSuccess)
                {
                    await LoadDataAsync(ComponentCancellationToken);
                    return;
                }
            }

            if (amountChanged)
            {
                var amountResult = await Executor.ExecuteAsync<UpdateCreditCardPurchaseAmountHandler>(
                    (handler, ct) => handler.ExecuteAsync(new UpdateCreditCardPurchaseAmountCommand(purchase.Id, _editAmount), ct),
                    successMessage: !detailsChanged ? "Compra atualizada." : null,
                    cancellationToken: ComponentCancellationToken);

                if (!amountResult.IsSuccess)
                {
                    await LoadDataAsync(ComponentCancellationToken);
                    return;
                }
            }

            if (detailsChanged)
            {
                var detailsResult = await Executor.ExecuteAsync<UpdateCreditCardPurchaseDetailsHandler>(
                    (handler, ct) => handler.ExecuteAsync(
                        new UpdateCreditCardPurchaseDetailsCommand(
                            purchase.Id,
                            trimmedDescription,
                            _editCategoryId!.Value,
                            resolvedConditionId),
                        ct),
                    successMessage: "Compra atualizada.",
                    cancellationToken: ComponentCancellationToken);

                if (!detailsResult.IsSuccess)
                {
                    await LoadDataAsync(ComponentCancellationToken);
                    return;
                }
            }

            _editingPurchase = null;
            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeletePurchaseAsync(Guid purchaseId)
    {
        if (_saving)
        {
            return;
        }

        _saving = true;

        try
        {
            var result = await Executor.ExecuteAsync<DeleteCreditCardPurchaseHandler>(
                (handler, ct) => handler.ExecuteAsync(new DeleteCreditCardPurchaseCommand(purchaseId), ct),
                successMessage: "Compra excluída.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                _confirmDeletePurchaseId = null;
                if (_expandedPurchaseId == purchaseId)
                {
                    _expandedPurchaseId = null;
                }
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

    private decimal? GetCreatePurchaseLimitExcess()
    {
        var selectedCard = SelectedPurchaseCard;
        if (selectedCard?.Limit is not > 0m
            || !selectedCard.AvailableLimit.HasValue
            || _amount <= 0m
            || !_date.HasValue
            || _installmentCount < 1
            || _initialInstallment < 1
            || _initialInstallment > _installmentCount)
        {
            return null;
        }

        var rule = CardBillingRule.Of(selectedCard.ClosingDay, selectedCard.DueDay);
        var firstCycle = BillingCycle.ForPurchase(HearthFormat.ToDateOnly(_date.Value), rule);
        var splits = Money.FromDecimal(_amount).Split(_installmentCount);
        var minDueDate = AccountContext.Current?.InitialBalanceDate;

        var draftUsage = 0m;
        for (var i = _initialInstallment - 1; i < splits.Count; i++)
        {
            var dueDate = firstCycle.AddCycles(i).DueDate;
            if (dueDate > Clock.Today && (minDueDate is null || dueDate >= minDueDate.Value))
            {
                draftUsage += splits[i].Amount;
            }
        }

        var excess = draftUsage - selectedCard.AvailableLimit.Value;
        return excess > 0m ? excess : null;
    }

    private decimal? GetEditAmountLimitExcess()
    {
        if (_editingPurchase is null
            || _activeCard is null
            || _activeCard.Id != _editingPurchase.CreditCardId
            || _activeCard.Limit is not > 0m
            || !_activeCard.AvailableLimit.HasValue
            || _editAmount <= 0m
            || _editingPurchase.InstallmentCount < 1)
        {
            return null;
        }

        var minDueDate = AccountContext.Current?.InitialBalanceDate;
        var currentUsage = _editingPurchase.Installments
            .Where(i => !i.IsPreviouslyPaid && i.DueDate > Clock.Today && (minDueDate is null || i.DueDate >= minDueDate.Value))
            .Sum(i => i.Amount);

        var newSplits = Money.FromDecimal(_editAmount).Split(_editingPurchase.InstallmentCount);
        var newUsage = 0m;
        for (var i = 0; i < _editingPurchase.Installments.Count && i < newSplits.Count; i++)
        {
            var inst = _editingPurchase.Installments[i];
            if (!inst.IsPreviouslyPaid && inst.DueDate > Clock.Today && (minDueDate is null || inst.DueDate >= minDueDate.Value))
            {
                newUsage += newSplits[i].Amount;
            }
        }

        var delta = newUsage - currentUsage;
        var excess = delta - _activeCard.AvailableLimit.Value;
        return excess > 0m ? excess : null;
    }

