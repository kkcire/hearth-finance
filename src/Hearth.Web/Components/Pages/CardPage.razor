@page "/cartao"
@page "/cartao/faturas"
@page "/cartao/compras"
@attribute [Authorize]
@inherits AccountPageBase
@using Hearth.Application.Categories
@using Hearth.Application.Categories.ListCategories
@using Hearth.Application.CreditCardPurchases
@using Hearth.Application.CreditCardPurchases.DeleteCreditCardPurchase
@using Hearth.Application.CreditCardPurchases.ListCreditCardPurchases
@using Hearth.Application.CreditCardPurchases.RegisterCreditCardPurchase
@using Hearth.Application.CreditCardPurchases.UpdateCreditCardPurchaseAmount
@using Hearth.Application.CreditCardPurchases.UpdateCreditCardPurchaseDate
@using Hearth.Application.CreditCardPurchases.UpdateCreditCardPurchaseDetails
@using Hearth.Application.CreditCards
@using Hearth.Application.CreditCards.ArchiveCreditCard
@using Hearth.Application.CreditCards.CreateCreditCard
@using Hearth.Application.CreditCards.DeleteCreditCard
@using Hearth.Application.CreditCards.GetActiveCreditCard
@using Hearth.Application.CreditCards.UpdateCreditCard
@using Hearth.Application.Invoices.GetInvoiceSummary
@using Hearth.Web.Components.Shared
@inject NavigationManager Navigation

<PageTitle>Cartão — Hearth Finance</PageTitle>

<div class="hearth-card-page">
    <header class="hearth-dash-header">
        <div class="hearth-dash-title-group">
            <h1 class="hearth-dash-title">Cartão de crédito</h1>
            <p class="hearth-dash-subtitle">
                Limite, fatura derivada por ciclo e gestão de compras em um só lugar.
            </p>
        </div>

        <div class="hearth-card-page-actions">
            @if (_activeCard is not null)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Class="hearth-btn-clean"
                           OnClick="StartEditCard"
                           Disabled="_saving"
                           data-testid="edit-card-button">
                    Editar cartão
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           Class="hearth-btn-clean"
                           OnClick="StartCreatePurchase"
                           Disabled="_saving || ActiveCategories.Count == 0"
                           data-testid="new-purchase-button">
                    Nova compra
                </MudButton>
            }
            else if (!_loading)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddCard"
                           Class="hearth-btn-clean"
                           OnClick="StartCreateCard"
                           Disabled="_saving"
                           data-testid="new-card-button">
                    Cadastrar cartão
                </MudButton>
            }
        </div>
    </header>

    @if (_loading)
    {
        <div class="hearth-card-skeleton-hero">
            <div class="hearth-card hearth-skeleton-panel"></div>
            <div class="hearth-card hearth-skeleton-panel"></div>
        </div>
    }
    else
    {
        @* 1. Hero do Cartão (Cartão físico visual + Resumo de limite / Estado vazio) *@
        @if (_activeCard is not null)
        {
            <section class="hearth-card-hero" aria-label="Resumo do cartão ativo">
                <button type="button"
                        class="hearth-physical-card"
                        @onclick="FocusInvoiceFromCardAsync"
                        aria-label="Abrir fatura do ciclo atual do cartão @ActiveCardDisplayName"
                        data-testid="physical-card-button">
                    <div class="hearth-physical-card-top">
                        <div class="hearth-physical-card-brand">
                            <svg class="hearth-physical-card-emblem" viewBox="0 0 36 36" fill="none" aria-hidden="true" focusable="false">
                                <path d="M18.6 4.2C18.6 4.2 25.4 9.7 25.4 16.9C25.4 21.1 22.1 24.4 18 24.4C13.9 24.4 10.6 21.1 10.6 16.9C10.6 14.3 11.9 11.7 13.7 9.7C13.5 11.5 14.3 13 15.6 13.5C15.1 10.4 16.3 6.8 18.6 4.2Z" fill="currentColor" />
                                <path d="M18 14.2C19.8 16.1 20.8 18 20.8 19.7C20.8 21.3 19.5 22.6 18 22.6C16.5 22.6 15.2 21.3 15.2 19.7C15.2 18.6 15.8 17.4 16.7 16.4C16.7 17.2 17.1 17.8 17.6 18C17.4 16.8 17.6 15.3 18 14.2Z" fill="#151518" fill-opacity="0.78" />
                                <path d="M9.5 27.6L26.5 24.6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" opacity="0.82" />
                                <path d="M9.5 24.6L26.5 27.6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" opacity="0.52" />
                            </svg>
                            <span translate="no">Hearth</span>
                        </div>

                        <svg class="hearth-physical-card-chip" viewBox="0 0 42 32" fill="none" aria-hidden="true" focusable="false">
                            <rect x="1" y="1" width="40" height="30" rx="6" stroke="currentColor" stroke-width="1.4" />
                            <path d="M14 1V31M28 1V31M1 11H14M28 11H41M1 21H14M28 21H41" stroke="currentColor" stroke-width="1.2" opacity="0.7" />
                        </svg>
                    </div>

                    <div class="hearth-physical-card-middle">
                        <span class="hearth-physical-card-name" data-testid="active-card-name">@ActiveCardDisplayName</span>
                        <span class="hearth-physical-card-account">@(AccountContext.Current?.Name ?? "Conta Principal")</span>
                    </div>

                    <div class="hearth-physical-card-bottom">
                        <div class="hearth-physical-card-dates">
                            <div>
                                <span class="hearth-physical-card-meta-label">Fechamento</span>
                                <strong class="hearth-money">Dia @_activeCard.ClosingDay.ToString("D2")</strong>
                            </div>
                            <div>
                                <span class="hearth-physical-card-meta-label">Vencimento</span>
                                <strong class="hearth-money">Dia @_activeCard.DueDay.ToString("D2")</strong>
                            </div>
                        </div>

                        <span class="hearth-physical-card-cue">Ver fatura</span>
                    </div>
                </button>

                <div class="hearth-card hearth-card-overview">
                    @if (_activeCard.Limit is > 0m)
                    {
                        var available = _activeCard.AvailableLimit ?? 0m;
                        var isLimitExceeded = available < 0m;
                        var usedPct = Math.Round((_activeCard.UsedLimit / _activeCard.Limit.Value) * 100m, 1);
                        var barWidth = Math.Min(100d, (double)usedPct);

                        <div class="hearth-kpi-strip hearth-card-overview-kpi">
                            <div>
                                <span class="hearth-kpi-caption">Limite disponível</span>
                                <p class="hearth-kpi-value @(isLimitExceeded ? "is-danger" : "is-primary")" data-testid="card-available-limit">
                                    @HearthFormat.Money(available)
                                </p>
                                @if (isLimitExceeded)
                                {
                                    <span class="hearth-limit-exceeded-note" data-testid="card-limit-exceeded-note">
                                        Excedido em @HearthFormat.Money(Math.Abs(available)) — confira compras ou atualize o limite do cartão.
                                    </span>
                                }
                            </div>
                            <span class="hearth-status-pill @(isLimitExceeded || usedPct >= 90m ? "is-danger" : usedPct >= 75m ? "is-warning" : "is-positive")"
                                  data-testid="card-limit-status-pill">
                                @if (isLimitExceeded)
                                {
                                    <svg class="hearth-badge-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                                        <path d="M8 2.2L14 13H2L8 2.2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                                        <path d="M8 6.2V9.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                                        <circle cx="8" cy="11.3" r="0.65" fill="currentColor" />
                                    </svg>
                                    @($"Limite excedido ({HearthFormat.Percentage(usedPct)})")
                                }
                                else
                                {
                                    @($"{HearthFormat.Percentage(usedPct)} utilizado")
                                }
                            </span>
                        </div>

                        <div class="hearth-meter" role="presentation">
                            <span class="hearth-meter-fill @(usedPct >= 90m ? "is-danger" : usedPct >= 75m ? "is-warning" : "is-accent")"
                                  style="width: @(barWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;"></span>
                        </div>

                        <dl class="hearth-card-metrics-grid">
                            <div class="hearth-card-metric">
                                <dt>Limite total</dt>
                                <dd class="hearth-money" data-testid="card-total-limit">@HearthFormat.Money(_activeCard.Limit.Value)</dd>
                            </div>
                            <div class="hearth-card-metric">
                                <dt>Limite usado</dt>
                                <dd class="hearth-money" data-testid="card-used-limit">@HearthFormat.Money(_activeCard.UsedLimit)</dd>
                            </div>
                            <div class="hearth-card-metric">
                                <dt>Fatura em aberto (@HearthFormat.ShortMonthYear(_defaultOpenCycle))</dt>
                                <dd class="hearth-money">@HearthFormat.Money(_openCycleAmount)</dd>
                            </div>
                        </dl>
                    }
                    else
                    {
                        <div class="hearth-kpi-strip hearth-card-overview-kpi">
                            <div>
                                <span class="hearth-kpi-caption">Total comprometido em parcelas futuras</span>
                                <p class="hearth-kpi-value is-primary" data-testid="card-used-limit">
                                    @HearthFormat.Money(_activeCard.UsedLimit)
                                </p>
                            </div>
                            <span class="hearth-status-pill is-neutral">Sem limite definido</span>
                        </div>

                        <dl class="hearth-card-metrics-grid hearth-card-metrics-grid--two">
                            <div class="hearth-card-metric">
                                <dt>Fatura em aberto (@HearthFormat.ShortMonthYear(_defaultOpenCycle))</dt>
                                <dd class="hearth-money">@HearthFormat.Money(_openCycleAmount)</dd>
                            </div>
                            <div class="hearth-card-metric">
                                <dt>Compras vinculadas</dt>
                                <dd class="hearth-money">@_activeCardPurchaseCount</dd>
                            </div>
                        </dl>
                    }

                    <div class="hearth-card-lifecycle-bar">
                        @if (_confirmCardAction == CardLifecycleAction.None)
                        {
                            <span class="hearth-card-lifecycle-hint">
                                @if (_activeCardHasPurchases)
                                {
                                    @($"Cartão com {_activeCardPurchaseCount} compra(s) vinculada(s).")
                                }
                                else
                                {
                                    @("Nenhuma compra vinculada a este cartão.")
                                }
                            </span>

                            <div class="hearth-card-lifecycle-buttons">
                                @if (_activeCardHasPurchases)
                                {
                                    <button type="button"
                                            class="hearth-ghost-danger-btn"
                                            @onclick="() => _confirmCardAction = CardLifecycleAction.Archive"
                                            disabled="@_saving"
                                            data-testid="archive-card-button">
                                        Arquivar cartão
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="hearth-ghost-danger-btn"
                                            @onclick="() => _confirmCardAction = CardLifecycleAction.Delete"
                                            disabled="@_saving"
                                            data-testid="delete-card-button">
                                        Excluir cartão
                                    </button>
                                }
                            </div>
                        }
                        else if (_confirmCardAction == CardLifecycleAction.Archive)
                        {
                            <div class="hearth-inline-confirm" role="alert" data-testid="confirm-archive-card-panel">
                                <p>
                                    Arquivar mantém todas as parcelas e faturas históricas nos cálculos e libera o cadastro de um novo cartão ativo.
                                </p>
                                <div class="hearth-inline-confirm-actions">
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Filled"
                                               Color="Color.Error"
                                               OnClick="ArchiveCardAsync"
                                               Disabled="_saving"
                                               data-testid="confirm-archive-card-button">
                                        Confirmar arquivamento
                                    </MudButton>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               OnClick="() => _confirmCardAction = CardLifecycleAction.None"
                                               Disabled="_saving">
                                        Cancelar
                                    </MudButton>
                                </div>
                            </div>
                        }
                        else if (_confirmCardAction == CardLifecycleAction.Delete)
                        {
                            <div class="hearth-inline-confirm" role="alert" data-testid="confirm-delete-card-panel">
                                <p>
                                    Excluir este cartão permanentemente? Esta ação não pode ser desfeita.
                                </p>
                                <div class="hearth-inline-confirm-actions">
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Filled"
                                               Color="Color.Error"
                                               OnClick="DeleteCardAsync"
                                               Disabled="_saving"
                                               data-testid="confirm-delete-card-button">
                                        Confirmar exclusão
                                    </MudButton>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               OnClick="() => _confirmCardAction = CardLifecycleAction.None"
                                               Disabled="_saving">
                                        Cancelar
                                    </MudButton>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }
        else
        {
            <section class="hearth-card hearth-card-onboarding" aria-labelledby="heading-create-card" data-testid="no-active-card-panel">
                <div class="hearth-card-onboarding-visual" aria-hidden="true">
                    <div class="hearth-physical-card hearth-physical-card--ghost">
                        <div class="hearth-physical-card-top">
                            <span translate="no">Hearth</span>
                            <svg class="hearth-physical-card-chip" viewBox="0 0 42 32" fill="none">
                                <rect x="1" y="1" width="40" height="30" rx="6" stroke="currentColor" stroke-width="1.4" />
                            </svg>
                        </div>
                        <div class="hearth-physical-card-middle">
                            <span class="hearth-physical-card-name">Nenhum cartão ativo</span>
                            <span class="hearth-physical-card-account">Cadastre para lançar compras e acompanhar faturas</span>
                        </div>
                    </div>
                </div>

                <div class="hearth-card-onboarding-form">
                    <h2 id="heading-create-card" class="hearth-card-title">Cadastrar cartão de crédito</h2>
                    <p class="hearth-card-meta">
                        Informe os dias de fechamento e vencimento (1 a 28). O nome e o limite são opcionais.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(_cardFormError))
                    {
                        <div class="hearth-inline-alert" role="alert" data-testid="card-form-error">
                            @_cardFormError
                        </div>
                    }

                    <MudGrid Spacing="3" Class="mt-1">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_cardName"
                                          Label="Nome do cartão (opcional)"
                                          Placeholder="Ex.: Nubank, Itaú Black"
                                          Variant="Variant.Outlined"
                                          MaxLength="@DomainValidation.MaxNameLength"
                                          Immediate="true"
                                          Disabled="_saving"
                                          data-testid="card-name-input" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudNumericField T="decimal?"
                                             @bind-Value="_cardLimit"
                                             Label="Limite total (opcional)"
                                             Variant="Variant.Outlined"
                                             Culture="@HearthFormat.PtBr"
                                             Format="N2"
                                             Adornment="Adornment.Start"
                                             AdornmentText="R$"
                                             HideSpinButtons="true"
                                             Immediate="true"
                                             Disabled="_saving"
                                             data-testid="card-limit-input" />
                        </MudItem>

                        <MudItem xs="6">
                            <MudNumericField T="int"
                                             @bind-Value="_cardClosingDay"
                                             Label="Dia de fechamento"
                                             Variant="Variant.Outlined"
                                             Min="1"
                                             Max="28"
                                             Immediate="true"
                                             HelperText="Entre 1 e 28"
                                             Disabled="_saving"
                                             data-testid="card-closing-day-input" />
                        </MudItem>

                        <MudItem xs="6">
                            <MudNumericField T="int"
                                             @bind-Value="_cardDueDay"
                                             Label="Dia de vencimento"
                                             Variant="Variant.Outlined"
                                             Min="1"
                                             Max="28"
                                             Immediate="true"
                                             HelperText="Entre 1 e 28"
                                             Disabled="_saving"
                                             data-testid="card-due-day-input" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Class="hearth-btn-clean"
                                       OnClick="SaveCardAsync"
                                       Disabled="_saving"
                                       data-testid="save-card-submit">
                                @(_saving ? "Salvando…" : "Cadastrar cartão")
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </div>
            </section>
        }

        @* Painel de edição do cartão ativo *@
        @if (_showEditCardForm && _activeCard is not null)
        {
            <section class="hearth-card hearth-panel-box" aria-labelledby="heading-edit-card" data-testid="edit-card-form">
                <div class="hearth-module-head">
                    <div>
                        <h2 id="heading-edit-card" class="hearth-card-title">Editar cartão</h2>
                        <p class="hearth-card-meta">
                            Alterar fechamento ou vencimento vale apenas para novas compras; compras anteriores preservam a regra original.
                        </p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_cardFormError))
                {
                    <div class="hearth-inline-alert" role="alert" data-testid="card-form-error">
                        @_cardFormError
                    </div>
                }

                <MudGrid Spacing="3" Class="mt-1">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_cardName"
                                      Label="Nome do cartão (opcional)"
                                      Variant="Variant.Outlined"
                                      MaxLength="@DomainValidation.MaxNameLength"
                                      Immediate="true"
                                      Disabled="_saving"
                                      data-testid="edit-card-name-input" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal?"
                                         @bind-Value="_cardLimit"
                                         Label="Limite total (opcional)"
                                         Variant="Variant.Outlined"
                                         Culture="@HearthFormat.PtBr"
                                         Format="N2"
                                         Adornment="Adornment.Start"
                                         AdornmentText="R$"
                                         HideSpinButtons="true"
                                         Immediate="true"
                                         Disabled="_saving"
                                         data-testid="edit-card-limit-input" />
                    </MudItem>

                    <MudItem xs="6" sm="3">
                        <MudNumericField T="int"
                                         @bind-Value="_cardClosingDay"
                                         Label="Dia de fechamento"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Max="28"
                                         Immediate="true"
                                         Disabled="_saving"
                                         data-testid="edit-card-closing-day-input" />
                    </MudItem>

                    <MudItem xs="6" sm="3">
                        <MudNumericField T="int"
                                         @bind-Value="_cardDueDay"
                                         Label="Dia de vencimento"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Max="28"
                                         Immediate="true"
                                         Disabled="_saving"
                                         data-testid="edit-card-due-day-input" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                            <MudButton Variant="Variant.Text" OnClick="CancelPanels" Disabled="_saving">Cancelar</MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Class="hearth-btn-clean"
                                       OnClick="SaveCardAsync"
                                       Disabled="_saving"
                                       data-testid="save-card-submit">
                                @(_saving ? "Salvando…" : "Salvar alterações")
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </section>
        }

        @* Formulário de Nova Compra (nunca pré-desabilitado; valida com feedback explícito) *@
        @if (_showCreatePurchaseForm)
        {
            <section class="hearth-card hearth-panel-box" aria-labelledby="heading-new-purchase" data-testid="create-purchase-form">
                <div class="hearth-module-head">
                    <div>
                        <h2 id="heading-new-purchase" class="hearth-card-title">Nova compra no cartão</h2>
                        <p class="hearth-card-meta">Cartão ativo: @ActiveCardDisplayName</p>
                    </div>
                </div>

                @if (_purchaseFormErrors.Count > 0)
                {
                    <div class="hearth-inline-alert" role="alert" data-testid="create-purchase-errors">
                        <p class="hearth-inline-alert-title">Corrija os campos abaixo para registrar a compra:</p>
                        <ul class="hearth-inline-alert-list">
                            @foreach (var error in _purchaseFormErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }

                <MudGrid Spacing="3" Class="mt-1">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_description"
                                      Label="Descrição"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      MaxLength="@DomainValidation.MaxDescriptionLength"
                                      Counter="@DomainValidation.MaxDescriptionLength"
                                      Immediate="true"
                                      Disabled="_saving"
                                      data-testid="purchase-description-input" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="Guid?"
                                   @bind-Value="_categoryId"
                                   Label="Categoria"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   Disabled="_saving"
                                   data-testid="purchase-category-select">
                            @foreach (var category in ActiveCategories)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)category.Id)">@category.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudNumericField T="decimal"
                                         @bind-Value="_amount"
                                         Label="Valor total"
                                         Variant="Variant.Outlined"
                                         Culture="@HearthFormat.PtBr"
                                         Format="N2"
                                         Adornment="Adornment.Start"
                                         AdornmentText="R$"
                                         HideSpinButtons="true"
                                         Immediate="true"
                                         HelperText="Resto de centavos vai na primeira parcela."
                                         Disabled="_saving"
                                         data-testid="purchase-amount-input" />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudDatePicker @bind-Date="_date"
                                       Label="Data da compra"
                                       Variant="Variant.Outlined"
                                       DateFormat="dd/MM/yyyy"
                                       Culture="@HearthFormat.PtBr"
                                       Editable="true"
                                       Disabled="_saving"
                                       data-testid="purchase-date-input" />
                    </MudItem>

                    <MudItem xs="6" sm="2">
                        <MudNumericField T="int"
                                         @bind-Value="_installmentCount"
                                         Label="Parcelas"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Max="120"
                                         Immediate="true"
                                         Disabled="_saving"
                                         data-testid="purchase-installments-input" />
                    </MudItem>

                    <MudItem xs="6" sm="2">
                        <MudNumericField T="int"
                                         @bind-Value="_initialInstallment"
                                         Label="Parcela inicial"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Max="@Math.Max(1, _installmentCount)"
                                         Immediate="true"
                                         HelperText="> 1: anteriores já pagas"
                                         Disabled="_saving"
                                         data-testid="purchase-initial-installment-input" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="PurchaseConditionKind"
                                   @bind-Value="_conditionKind"
                                   Label="Condição"
                                   Variant="Variant.Outlined"
                                   Disabled="_saving"
                                   data-testid="purchase-condition-select">
                            <MudSelectItem T="PurchaseConditionKind" Value="PurchaseConditionKind.Own">Própria</MudSelectItem>
                            <MudSelectItem T="PurchaseConditionKind" Value="PurchaseConditionKind.Others">Outros</MudSelectItem>
                            <MudSelectItem T="PurchaseConditionKind" Value="PurchaseConditionKind.Custom">Personalizado</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    @if (_conditionKind == PurchaseConditionKind.Custom)
                    {
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_conditionName"
                                          Label="Nome da condição"
                                          Placeholder="Ex.: Mãe, Ana, Trabalho"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          MaxLength="@DomainValidation.MaxNameLength"
                                          Immediate="true"
                                          Disabled="_saving"
                                          data-testid="purchase-condition-name-input" />
                        </MudItem>
                    }

                    @if (GetCreatePurchaseLimitExcess() is { } createLimitExcess && _activeCard?.AvailableLimit is { } createAvailable)
                    {
                        <MudItem xs="12">
                            <div class="hearth-limit-warning" role="status" data-testid="create-purchase-limit-warning">
                                <svg class="hearth-limit-warning-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                                    <path d="M10 2.8L17.6 16.4H2.4L10 2.8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                                    <path d="M10 7.6V11.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                    <circle cx="10" cy="14.1" r="0.85" fill="currentColor" />
                                </svg>
                                <div>
                                    <strong>Esta compra excede o limite disponível atual em @HearthFormat.Money(createLimitExcess)</strong>
                                    (disponível: <span class="hearth-money">@HearthFormat.Money(createAvailable)</span>).
                                    Confira se o valor da compra ou o limite cadastrado estão corretos — você ainda pode registrar normalmente.
                                </div>
                            </div>
                        </MudItem>
                    }

                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                            <MudButton Variant="Variant.Text" OnClick="CancelPanels" Disabled="_saving">Cancelar</MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Class="hearth-btn-clean"
                                       OnClick="CreatePurchaseAsync"
                                       Disabled="_saving"
                                       data-testid="create-purchase-submit">
                                @(_saving ? "Salvando…" : "Registrar compra")
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </section>
        }

        @* Painéis de edição de compra *@
        @if (_editingDetails is not null)
        {
            <section class="hearth-card hearth-panel-box" data-testid="edit-purchase-details-panel">
                <h2 class="hearth-card-title">Editar detalhes — @_editingDetails.Description</h2>
                <MudGrid Spacing="3" Class="mt-1">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_editDescription"
                                      Label="Descrição"
                                      Variant="Variant.Outlined"
                                      MaxLength="@DomainValidation.MaxDescriptionLength"
                                      Immediate="true"
                                      Disabled="_saving"
                                      data-testid="edit-purchase-description-input" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="Guid?" @bind-Value="_editCategoryId" Label="Categoria" Variant="Variant.Outlined" Disabled="_saving">
                            @foreach (var category in _allCategories.Where(c => !c.IsArchived || c.Id == _editingDetails.CategoryId))
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)category.Id)">
                                    @(category.IsArchived ? $"{category.Name} (Arquivada)" : category.Name)
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="PurchaseConditionKind" @bind-Value="_editConditionKind" Label="Condição" Variant="Variant.Outlined" Disabled="_saving">
                            <MudSelectItem T="PurchaseConditionKind" Value="PurchaseConditionKind.Own">Própria</MudSelectItem>
                            <MudSelectItem T="PurchaseConditionKind" Value="PurchaseConditionKind.Others">Outros</MudSelectItem>
                            <MudSelectItem T="PurchaseConditionKind" Value="PurchaseConditionKind.Custom">Personalizado</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    @if (_editConditionKind == PurchaseConditionKind.Custom)
                    {
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_editConditionName"
                                          Label="Nome da condição"
                                          Variant="Variant.Outlined"
                                          MaxLength="@DomainValidation.MaxNameLength"
                                          Immediate="true"
                                          Disabled="_saving" />
                        </MudItem>
                    }
                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                            <MudButton Variant="Variant.Text" OnClick="CancelPanels" Disabled="_saving">Cancelar</MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Class="hearth-btn-clean"
                                       OnClick="SaveDetailsAsync"
                                       Disabled="_saving || string.IsNullOrWhiteSpace(_editDescription) || !_editCategoryId.HasValue || (_editConditionKind == PurchaseConditionKind.Custom && string.IsNullOrWhiteSpace(_editConditionName))"
                                       data-testid="save-purchase-details">
                                Salvar detalhes
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </section>
        }

        @if (_editingAmount is not null)
        {
            <section class="hearth-card hearth-panel-box" data-testid="edit-purchase-amount-panel">
                <h2 class="hearth-card-title">Alterar valor — @_editingAmount.Description</h2>
                <MudGrid Spacing="3" Class="mt-1 align-center">
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal"
                                         @bind-Value="_editNewAmount"
                                         Label="Novo valor total"
                                         Variant="Variant.Outlined"
                                         Culture="@HearthFormat.PtBr"
                                         Format="N2"
                                         Adornment="Adornment.Start"
                                         AdornmentText="R$"
                                         HideSpinButtons="true"
                                         Immediate="true"
                                         Disabled="_saving"
                                         data-testid="edit-purchase-amount-input" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="hearth-btn-clean" OnClick="SaveAmountAsync" Disabled="_saving || _editNewAmount <= 0" data-testid="save-purchase-amount">
                                Salvar valor
                            </MudButton>
                            <MudButton Variant="Variant.Text" OnClick="CancelPanels" Disabled="_saving">Cancelar</MudButton>
                        </MudStack>
                    </MudItem>
                    @if (GetEditAmountLimitExcess() is { } editLimitExcess && _activeCard?.AvailableLimit is { } editAvailable)
                    {
                        <MudItem xs="12">
                            <div class="hearth-limit-warning" role="status" data-testid="edit-purchase-limit-warning">
                                <svg class="hearth-limit-warning-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                                    <path d="M10 2.8L17.6 16.4H2.4L10 2.8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                                    <path d="M10 7.6V11.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                    <circle cx="10" cy="14.1" r="0.85" fill="currentColor" />
                                </svg>
                                <div>
                                    <strong>O novo valor excede o limite disponível atual em @HearthFormat.Money(editLimitExcess)</strong>
                                    (disponível: <span class="hearth-money">@HearthFormat.Money(editAvailable)</span>).
                                    Confira o valor ou o limite cadastrado — você ainda pode salvar normalmente.
                                </div>
                            </div>
                        </MudItem>
                    }
                </MudGrid>
            </section>
        }

        @if (_editingDate is not null)
        {
            <section class="hearth-card hearth-panel-box" data-testid="edit-purchase-date-panel">
                <h2 class="hearth-card-title">Alterar data — @_editingDate.Description</h2>
                <MudGrid Spacing="3" Class="mt-1 align-center">
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_editNewDate"
                                       Label="Nova data da compra"
                                       Variant="Variant.Outlined"
                                       DateFormat="dd/MM/yyyy"
                                       Culture="@HearthFormat.PtBr"
                                       Editable="true"
                                       Disabled="_saving"
                                       data-testid="edit-purchase-date-input" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="hearth-btn-clean" OnClick="SaveDateAsync" Disabled="_saving || !_editNewDate.HasValue" data-testid="save-purchase-date">
                                Salvar data
                            </MudButton>
                            <MudButton Variant="Variant.Text" OnClick="CancelPanels" Disabled="_saving">Cancelar</MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </section>
        }

        @* 2. Abas Fatura | Compras (visíveis quando há cartão ativo OU histórico arquivado) *@
        @if (_activeCard is not null || _purchases.Count > 0)
        {
            @if (_activeCard is null && _purchases.Count > 0)
            {
                <div class="hearth-history-notice" role="status">
                    Você não tem um cartão ativo no momento. As faturas e compras de cartões arquivados continuam disponíveis abaixo.
                </div>
            }

            <div id="cartao-conteudo" class="hearth-card-tabs-bar" role="tablist" aria-label="Seções do cartão">
                <button type="button"
                        id="tab-fatura"
                        role="tab"
                        class="hearth-tab-btn @(_activeTab == CardTab.Invoice ? "is-active" : null)"
                        aria-selected="@(_activeTab == CardTab.Invoice ? "true" : "false")"
                        aria-controls="panel-fatura"
                        @onclick="() => SelectTab(CardTab.Invoice)"
                        data-testid="card-tab-invoice">
                    Fatura
                </button>

                <button type="button"
                        id="tab-compras"
                        role="tab"
                        class="hearth-tab-btn @(_activeTab == CardTab.Purchases ? "is-active" : null)"
                        aria-selected="@(_activeTab == CardTab.Purchases ? "true" : "false")"
                        aria-controls="panel-compras"
                        @onclick="() => SelectTab(CardTab.Purchases)"
                        data-testid="card-tab-purchases">
                    Compras
                    <span class="hearth-tab-count hearth-money">@_purchases.Count</span>
                </button>
            </div>

            @if (_activeTab == CardTab.Invoice)
            {
                <section id="panel-fatura"
                         role="tabpanel"
                         aria-labelledby="tab-fatura"
                         class="hearth-card hearth-tab-panel"
                         data-testid="card-invoice-panel">
                    <div class="hearth-invoice-panel-head">
                        <div>
                            <div class="hearth-invoice-title-row">
                                <h2 class="hearth-card-title">
                                    Fatura de @HearthFormat.MonthYear(_selectedCycle)
                                </h2>
                                @if (_invoiceSummary?.Status is not null)
                                {
                                    <span class="hearth-status-pill @(GetInvoiceStatusPillClass(_invoiceSummary.Status))" data-testid="invoice-status-chip">
                                        @GetInvoiceStatusLabel(_invoiceSummary.Status)
                                    </span>
                                }
                            </div>

                            @if (_invoiceSummary is not null && _invoiceSummary.StartDate.HasValue && _invoiceSummary.EndDate.HasValue && _invoiceSummary.ClosingDate.HasValue && _invoiceSummary.DueDate.HasValue)
                            {
                                <dl class="hearth-invoice-cycle-meta">
                                    <div>
                                        <dt>Período</dt>
                                        <dd class="hearth-money">@HearthFormat.Date(_invoiceSummary.StartDate) a @HearthFormat.Date(_invoiceSummary.EndDate)</dd>
                                    </div>
                                    <div>
                                        <dt>Fechamento</dt>
                                        <dd class="hearth-money">@HearthFormat.Date(_invoiceSummary.ClosingDate)</dd>
                                    </div>
                                    <div>
                                        <dt>Vencimento</dt>
                                        <dd class="hearth-money">@HearthFormat.Date(_invoiceSummary.DueDate)</dd>
                                    </div>
                                </dl>
                            }
                        </div>

                        <MonthNavigator Month="_selectedCycle" MonthChanged="OnCycleChangedAsync" Disabled="_loadingInvoice" />
                    </div>

                    @if (_invoiceSummary is not null)
                    {
                        <div class="hearth-kpi-strip hearth-invoice-kpi">
                            <div>
                                <span class="hearth-kpi-caption">Total calculado da fatura</span>
                                <p class="hearth-kpi-value is-primary" data-testid="invoice-calculated-amount">
                                    @HearthFormat.Money(_invoiceSummary.CalculatedAmount)
                                </p>
                            </div>
                            <span class="hearth-period-tag hearth-money">
                                @_invoiceSummary.Installments.Count parcela(s) neste ciclo
                            </span>
                        </div>

                        @if (_invoiceSummary.Installments.Count == 0)
                        {
                            <div class="hearth-empty-state hearth-empty-state--compact">
                                <p class="hearth-empty-title">Nenhuma parcela neste ciclo de fechamento</p>
                                <p class="hearth-empty-desc">
                                    Use as setas acima para consultar outros ciclos ou registre uma compra no cartão.
                                </p>
                                @if (_activeCard is not null && ActiveCategories.Count > 0)
                                {
                                    <div>
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   Class="hearth-btn-clean"
                                                   OnClick="StartCreatePurchase">
                                            Nova compra
                                        </MudButton>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <MudTable Items="_invoiceSummary.Installments" Hover="true" Dense="true" Elevation="0" Class="hearth-table">
                                <HeaderContent>
                                    <MudTh Style="width: 115px;">Data</MudTh>
                                    <MudTh>Descrição</MudTh>
                                    <MudTh>Categoria</MudTh>
                                    <MudTh>Condição</MudTh>
                                    <MudTh Style="width: 100px;">Parcela</MudTh>
                                    <MudTh Style="width: 150px; text-align: right;">Valor</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Data" Class="hearth-money">@HearthFormat.Date(context.PurchaseDate)</MudTd>
                                    <MudTd DataLabel="Descrição">@context.Description</MudTd>
                                    <MudTd DataLabel="Categoria">@GetCategoryName(context.CategoryId)</MudTd>
                                    <MudTd DataLabel="Condição">
                                        <span class="hearth-period-tag">
                                            @HearthFormat.ConditionLabel(context.ConditionKind, context.ConditionName)
                                        </span>
                                    </MudTd>
                                    <MudTd DataLabel="Parcela" Class="hearth-money">@($"{context.InstallmentNumber}/{context.InstallmentCount}")</MudTd>
                                    <MudTd DataLabel="Valor" Style="text-align: right; font-weight: 600;" Class="hearth-money">
                                        @HearthFormat.Money(context.Amount)
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    }
                </section>
            }
            else
            {
                <section id="panel-compras"
                         role="tabpanel"
                         aria-labelledby="tab-compras"
                         class="hearth-card hearth-tab-panel"
                         data-testid="card-purchases-panel">
                    <div class="hearth-purchases-toolbar">
                        <div class="hearth-condition-bar" role="group" aria-label="Filtrar compras por condição">
                            <span class="hearth-condition-label">Condição:</span>
                            <div class="hearth-condition-pills">
                                <button type="button"
                                        class="hearth-filter-pill @(_conditionFilter is null ? "is-active" : null)"
                                        aria-pressed="@(_conditionFilter is null ? "true" : "false")"
                                        @onclick="() => SetConditionFilter(null)"
                                        data-testid="filter-condition-all">
                                    Todas
                                </button>

                                <button type="button"
                                        class="hearth-filter-pill @(IsSelectedFilter(PurchaseConditionKind.Own, null) ? "is-active" : null)"
                                        aria-pressed="@(IsSelectedFilter(PurchaseConditionKind.Own, null) ? "true" : "false")"
                                        @onclick="() => SetConditionFilter((PurchaseConditionKind.Own, null))"
                                        data-testid="filter-condition-own">
                                    Própria
                                </button>

                                <button type="button"
                                        class="hearth-filter-pill @(IsSelectedFilter(PurchaseConditionKind.Others, null) ? "is-active" : null)"
                                        aria-pressed="@(IsSelectedFilter(PurchaseConditionKind.Others, null) ? "true" : "false")"
                                        @onclick="() => SetConditionFilter((PurchaseConditionKind.Others, null))"
                                        data-testid="filter-condition-others">
                                    Outros
                                </button>

                                @foreach (var customName in DistinctCustomNames)
                                {
                                    var nameCopy = customName;
                                    var isActive = IsSelectedFilter(PurchaseConditionKind.Custom, nameCopy);
                                    <button type="button"
                                            class="hearth-filter-pill @(isActive ? "is-active" : null)"
                                            aria-pressed="@(isActive ? "true" : "false")"
                                            @onclick="() => SetConditionFilter((PurchaseConditionKind.Custom, nameCopy))"
                                            data-testid="@($"filter-condition-custom-{nameCopy}")">
                                        @nameCopy
                                    </button>
                                }
                            </div>
                        </div>

                        <span class="hearth-purchases-total hearth-money">
                            @FilteredPurchases.Count compra(s) — <strong>@HearthFormat.Money(FilteredPurchases.Sum(p => p.Amount))</strong>
                        </span>
                    </div>

                    <MudTable Items="FilteredPurchases" Hover="true" Dense="true" Elevation="0" Class="hearth-table">
                        <HeaderContent>
                            <MudTh Style="width: 110px;">Data</MudTh>
                            <MudTh>Descrição</MudTh>
                            <MudTh>Categoria</MudTh>
                            <MudTh>Condição</MudTh>
                            <MudTh>Parcelas</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh Style="text-align: right;">Valor total</MudTh>
                            <MudTh Style="width: 240px; text-align: right;">Ações</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Data" Class="hearth-money">@HearthFormat.Date(context.Date)</MudTd>
                            <MudTd DataLabel="Descrição">@context.Description</MudTd>
                            <MudTd DataLabel="Categoria">@GetCategoryName(context.CategoryId)</MudTd>
                            <MudTd DataLabel="Condição">
                                <span class="hearth-period-tag">
                                    @HearthFormat.ConditionLabel(context.ConditionKind, context.ConditionName)
                                </span>
                            </MudTd>
                            <MudTd DataLabel="Parcelas" Class="hearth-money">
                                @if (context.InitialInstallment > 1)
                                {
                                    <span>@($"{context.InstallmentCount}x (início {context.InitialInstallment}/{context.InstallmentCount})")</span>
                                }
                                else
                                {
                                    <span>@($"{context.InstallmentCount}x")</span>
                                }
                            </MudTd>
                            <MudTd DataLabel="Status">
                                @if (context.IsLocked)
                                {
                                    <span class="hearth-status-pill is-warning">Travada</span>
                                }
                                else
                                {
                                    <span class="hearth-status-pill is-positive">Aberta</span>
                                }
                            </MudTd>
                            <MudTd DataLabel="Valor total" Style="text-align: right; font-weight: 600;" Class="hearth-money">
                                @HearthFormat.Money(context.Amount)
                            </MudTd>
                            <MudTd DataLabel="Ações" Style="text-align: right;">
                                @if (_confirmDeletePurchaseId == context.Id)
                                {
                                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                                        <MudButton Size="Size.Small"
                                                   Variant="Variant.Filled"
                                                   Color="Color.Error"
                                                   OnClick="() => DeletePurchaseAsync(context.Id)"
                                                   Disabled="_saving"
                                                   data-testid="@($"confirm-delete-purchase-{context.Id}")">
                                            Confirmar
                                        </MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _confirmDeletePurchaseId = null" Disabled="_saving">
                                            Cancelar
                                        </MudButton>
                                    </MudStack>
                                }
                                else
                                {
                                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                                        <MudIconButton Icon="@(_expandedPurchaseId == context.Id ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                       Size="Size.Small"
                                                       title="Ver parcelas"
                                                       aria-label="Ver parcelas"
                                                       OnClick="() => ToggleExpand(context.Id)"
                                                       data-testid="@($"expand-purchase-{context.Id}")" />

                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                       title="Editar detalhes"
                                                       aria-label="Editar detalhes"
                                                       OnClick="() => StartEditDetails(context)"
                                                       Disabled="_saving"
                                                       data-testid="@($"edit-details-purchase-{context.Id}")" />

                                        <MudIconButton Icon="@Icons.Material.Filled.AttachMoney"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       title="@(context.IsLocked ? "Valor travado após fechamento da 1ª parcela ativa" : "Alterar valor")"
                                                       aria-label="Alterar valor"
                                                       OnClick="() => StartEditAmount(context)"
                                                       Disabled="_saving || context.IsLocked"
                                                       data-testid="@($"edit-amount-purchase-{context.Id}")" />

                                        <MudIconButton Icon="@Icons.Material.Filled.CalendarMonth"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       title="@(context.IsLocked ? "Data travada após fechamento da 1ª parcela ativa" : "Alterar data")"
                                                       aria-label="Alterar data"
                                                       OnClick="() => StartEditDate(context)"
                                                       Disabled="_saving || context.IsLocked"
                                                       data-testid="@($"edit-date-purchase-{context.Id}")" />

                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       title="Excluir compra"
                                                       aria-label="Excluir compra"
                                                       OnClick="() => _confirmDeletePurchaseId = context.Id"
                                                       Disabled="_saving"
                                                       data-testid="@($"delete-purchase-{context.Id}")" />
                                    </MudStack>
                                }
                            </MudTd>
                        </RowTemplate>
                        <ChildRowContent>
                            @if (_expandedPurchaseId == context.Id)
                            {
                                <MudTr>
                                    <td colspan="8" class="pa-3">
                                        <p class="hearth-expanded-title">Parcelas de "@context.Description"</p>
                                        <MudSimpleTable Dense="true" Elevation="0">
                                            <thead>
                                                <tr>
                                                    <th>Parcela</th>
                                                    <th>Ciclo (fechamento)</th>
                                                    <th>Vencimento</th>
                                                    <th>Situação</th>
                                                    <th style="text-align: right;">Valor</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var installment in context.Installments)
                                                {
                                                    <tr>
                                                        <td class="hearth-money">@($"{installment.Number}/{context.InstallmentCount}")</td>
                                                        <td class="hearth-money">@HearthFormat.ShortMonthYear(installment.ClosingYear, installment.ClosingMonth)</td>
                                                        <td class="hearth-money">@HearthFormat.Date(installment.DueDate)</td>
                                                        <td>
                                                            @if (installment.IsPreviouslyPaid)
                                                            {
                                                                <span class="hearth-status-pill is-neutral">Já paga</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="hearth-status-pill is-info">Na fatura</span>
                                                            }
                                                        </td>
                                                        <td style="text-align: right;" class="hearth-money">@HearthFormat.Money(installment.Amount)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </MudSimpleTable>
                                    </td>
                                </MudTr>
                            }
                        </ChildRowContent>
                        <NoRecordsContent>
                            <div class="hearth-empty-state hearth-empty-state--compact">
                                <p class="hearth-empty-title">Nenhuma compra registrada</p>
                                <p class="hearth-empty-desc">
                                    Clique em "Nova compra" para adicionar o primeiro lançamento neste cartão.
                                </p>
                            </div>
                        </NoRecordsContent>
                    </MudTable>
                </section>
            }
        }
    }
</div>

@code
{
    private enum CardTab
    {
        Invoice,
        Purchases,
    }

    private enum CardLifecycleAction
    {
        None,
        Archive,
        Delete,
    }

    [SupplyParameterFromQuery(Name = "aba")]
    public string? RequestedTab { get; set; }

    [SupplyParameterFromQuery(Name = "nova")]
    public bool OpenNewOnLoad { get; set; }

    private CardTab _activeTab = CardTab.Invoice;
    private bool _hasInitializedRouteState;
