    private async Task ConfirmReceiptAsync()
    {
        if (_saving || _confirmingIncome is null || _confirmActualAmount <= 0 || !_confirmReceivedOn.HasValue)
        {
            return;
        }

        _saving = true;
        try
        {
            var incomeId = _confirmingIncome.Id;
            var receivedOn = HearthFormat.ToDateOnly(_confirmReceivedOn.Value);

            var result = await Executor.ExecuteAsync<ConfirmFixedIncomeReceiptHandler, FixedIncomeReceiptDto>(
                (handler, ct) => handler.ExecuteAsync(
                    new ConfirmFixedIncomeReceiptCommand(
                        incomeId,
                        _selectedMonth.Year,
                        _selectedMonth.Month,
                        receivedOn,
                        _confirmActualAmount),
                    ct),
                successMessage: "Recebimento confirmado.",
                cancellationToken: ComponentCancellationToken);

            if (result.IsSuccess)
            {
                CancelPanels();
            }

            await LoadDataAsync(ComponentCancellationToken);
        }
        finally
        {
            _saving = false;
        }
    }

