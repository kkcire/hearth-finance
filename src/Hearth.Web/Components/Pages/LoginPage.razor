@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@attribute [EnableRateLimiting(HearthAuth.RateLimitPolicyName)]
@using Hearth.Application.Auth.AuthenticateUser
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.Extensions.Options
@inject AuthenticateUserHandler AuthenticateUser
@inject IAccountRepository Accounts
@inject IOptions<HearthAuthOptions> AuthOptions
@inject NavigationManager Navigation

<PageTitle>Entrar — Hearth Finance</PageTitle>

<div class="hearth-auth-heading">
    <h1 class="hearth-auth-title">Entrar</h1>
    <p class="hearth-auth-subtitle">Acesse sua conta para acompanhar caixa e faturas.</p>
</div>

@if (!string.IsNullOrWhiteSpace(_serverError))
{
    <div class="hearth-auth-alert"
         role="alert"
         tabindex="-1"
         data-testid="login-error">
        <svg class="hearth-auth-alert-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.6" />
            <path d="M10 6.2V10.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            <circle cx="10" cy="13.6" r="0.9" fill="currentColor" />
        </svg>
        <div class="hearth-auth-alert-body">@_serverError</div>
    </div>
}

@if (_fieldErrors.Count > 1)
{
    <div class="hearth-auth-alert hearth-auth-summary"
         role="alert"
         tabindex="-1"
         aria-labelledby="login-error-summary-title"
         data-focus-on-load="true"
         data-testid="login-error-summary">
        <svg class="hearth-auth-alert-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.6" />
            <path d="M10 6.2V10.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            <circle cx="10" cy="13.6" r="0.9" fill="currentColor" />
        </svg>
        <div class="hearth-auth-alert-body">
            <p id="login-error-summary-title" class="hearth-auth-summary-title">Revise os campos abaixo:</p>
            <ul class="hearth-auth-summary-list">
                @foreach (var entry in _fieldErrors)
                {
                    <li>
                        <a href="#@GetFieldInputId(entry.Key)" class="hearth-auth-summary-link">@entry.Value</a>
                    </li>
                }
            </ul>
        </div>
    </div>
}

<form method="post"
      action="@FormAction"
      @formname="login"
      @onsubmit="SubmitAsync"
      data-auth-form="true"
      novalidate>
    <AntiforgeryToken />

    <div class="hearth-auth-field">
        <label class="hearth-auth-label" for="login-email">E-mail</label>
        <input id="login-email"
               name="Input.Email"
               type="email"
               inputmode="email"
               autocomplete="email"
               autocapitalize="none"
               autocorrect="off"
               spellcheck="false"
               placeholder="nome@exemplo.com…"
               maxlength="@DomainValidation.MaxEmailLength"
               value="@(Input?.Email ?? string.Empty)"
               class="hearth-auth-input @(HasError("Email") ? "is-invalid" : null)"
               aria-invalid="@(HasError("Email") ? "true" : "false")"
               aria-describedby="@(HasError("Email") ? "login-email-error" : null)"
               data-focus-on-load="@(ShouldFocusField("Email") ? "true" : null)"
               required
               data-testid="login-email-input" />
        @if (GetError("Email") is { } emailError)
        {
            <p id="login-email-error" class="hearth-auth-error" role="alert">
                <svg class="hearth-auth-error-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                    <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.4" />
                    <path d="M8 4.8V8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    <circle cx="8" cy="11.1" r="0.75" fill="currentColor" />
                </svg>
                <span>@emailError</span>
            </p>
        }
    </div>

    <div class="hearth-auth-field">
        <label class="hearth-auth-label" for="login-password">Senha</label>
        <div class="hearth-auth-password-wrap">
            <input id="login-password"
                   name="Input.Password"
                   type="password"
                   autocomplete="current-password"
                   autocapitalize="none"
                   autocorrect="off"
                   spellcheck="false"
                   maxlength="@DomainValidation.MaxPasswordLength"
                   value="@(Input?.Password ?? string.Empty)"
                   class="hearth-auth-input @(HasError("Password") ? "is-invalid" : null)"
                   aria-invalid="@(HasError("Password") ? "true" : "false")"
                   aria-describedby="@(HasError("Password") ? "login-password-error" : null)"
                   data-focus-on-load="@(ShouldFocusField("Password") ? "true" : null)"
                   required
                   data-testid="login-password-input" />
            <button type="button"
                    class="hearth-auth-toggle-password"
                    data-toggle-password="login-password"
                    data-label-show="Mostrar senha"
                    data-label-hide="Ocultar senha"
                    aria-controls="login-password"
                    aria-label="Mostrar senha"
                    aria-pressed="false">
                <svg class="hearth-auth-eye hearth-auth-eye--show" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                    <path d="M2.2 10C3.8 6.8 6.6 5 10 5C13.4 5 16.2 6.8 17.8 10C16.2 13.2 13.4 15 10 15C6.6 15 3.8 13.2 2.2 10Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                    <circle cx="10" cy="10" r="2.5" stroke="currentColor" stroke-width="1.5" />
                </svg>
                <svg class="hearth-auth-eye hearth-auth-eye--hide" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                    <path d="M3 3L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <path d="M8.2 5.3C8.8 5.1 9.4 5 10 5C13.4 5 16.2 6.8 17.8 10C17.1 11.4 16.1 12.6 14.9 13.4M12.3 14.6C11.6 14.9 10.8 15 10 15C6.6 15 3.8 13.2 2.2 10C3.1 8.3 4.3 7 5.8 6.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="hearth-auth-toggle-text">Mostrar</span>
            </button>
        </div>
        @if (GetError("Password") is { } passwordError)
        {
            <p id="login-password-error" class="hearth-auth-error" role="alert">
                <svg class="hearth-auth-error-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                    <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.4" />
                    <path d="M8 4.8V8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    <circle cx="8" cy="11.1" r="0.75" fill="currentColor" />
                </svg>
                <span>@passwordError</span>
            </p>
        }
    </div>

    <button type="submit"
            class="hearth-auth-submit"
            data-loading-text="Entrando…"
            data-testid="login-submit">
        <span class="hearth-auth-spinner" aria-hidden="true"></span>
        <span class="hearth-auth-submit-label">Entrar</span>
    </button>
</form>

@if (AuthOptions.Value.AllowRegistration)
{
    <p class="hearth-auth-footer">
        <span>Ainda não tem conta?</span>
        <a href="/cadastro" class="hearth-auth-link" data-testid="go-to-register">Criar conta</a>
    </p>
}

@code
{
    private readonly Dictionary<string, string> _fieldErrors = new(StringComparer.Ordinal);
    private string? _serverError;
    private string? _firstErrorField;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromForm(FormName = "login")]
    public LoginInput? Input { get; set; }

    private string FormAction =>
        HearthAuth.IsSafeLocalReturnUrl(ReturnUrl)
            ? $"/login?returnUrl={Uri.EscapeDataString(ReturnUrl!)}"
            : "/login";

    protected override void OnInitialized()
    {
        Input ??= new LoginInput();

        if (HttpContext?.User.Identity?.IsAuthenticated == true)
        {
            var destination = HearthAuth.IsSafeLocalReturnUrl(ReturnUrl) ? ReturnUrl! : "/";
            Navigation.NavigateTo(destination, replace: true);
        }
    }

    private async Task SubmitAsync()
    {
        Input ??= new LoginInput();
        _fieldErrors.Clear();
        _serverError = null;
        _firstErrorField = null;

        var email = Input.Email?.Trim() ?? string.Empty;
        var password = Input.Password ?? string.Empty;
        Input.Email = email;

        if (!DomainValidation.IsValidEmail(email))
        {
            AddFieldError("Email", "Informe um e-mail válido, como nome@exemplo.com.");
        }

        if (string.IsNullOrEmpty(password))
        {
            AddFieldError("Password", "Informe sua senha para continuar.");
        }

        if (_fieldErrors.Count > 0)
        {
            Input.Password = string.Empty;
            return;
        }

        var result = await AuthenticateUser.ExecuteAsync(new AuthenticateUserCommand(email, password));
        if (!result.IsSuccess || result.User is null)
        {
            _serverError = HearthAuth.ToPortugueseError(result.ErrorCode);
            Input.Password = string.Empty;
            _firstErrorField = "Password";
            return;
        }

        if (HttpContext is not null)
        {
            await HttpContext.SignInAsync(
                CookieAuthenticationDefaults.AuthenticationScheme,
                HearthAuth.CreatePrincipal(result.User),
                HearthAuth.CreateCookieProperties());
        }

        var userAccounts = await Accounts.GetByOwnerAsync(result.User.Id);
        var target = userAccounts.Count == 0
            ? "/onboarding"
            : HearthAuth.IsSafeLocalReturnUrl(ReturnUrl)
                ? ReturnUrl!
                : "/";

        Navigation.NavigateTo(target, replace: true);
    }

    private void AddFieldError(string field, string message)
    {
        if (!_fieldErrors.ContainsKey(field))
        {
            _fieldErrors[field] = message;
            _firstErrorField ??= field;
        }
    }

    private bool ShouldFocusField(string field) =>
        _fieldErrors.Count <= 1 && string.Equals(_firstErrorField, field, StringComparison.Ordinal);

    private static string GetFieldInputId(string field) =>
        field switch
        {
            "Email" => "login-email",
            "Password" => "login-password",
            _ => "main-content",
        };

    private bool HasError(string field) => _fieldErrors.ContainsKey(field);

    private string? GetError(string field) =>
        _fieldErrors.TryGetValue(field, out var message) ? message : null;

    public sealed class LoginInput
    {
        public string Email { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;
    }
}
